---
// ─────────────────────────────────────────────────────────────
//  /present: the club-visit talk, as a full-screen slideshow.
//
//  Keys:  → / Space / PageDown = next   ← / PageUp = back
//         F = fullscreen   B = blank screen   Home / End = first / last
//  Mouse: click / scroll down / forward button = next
//         right-click / scroll up / back button = back
//
//  Each <section class="slide"> is one slide on a fixed 1920×1080 stage,
//  scaled to fit the screen. Inside a slide, anything with data-step="n"
//  appears on the nth click. The wordmark, wildcat and glows live outside
//  the slides and glide to a new spot on each slide (like PowerPoint Morph).
//  A slide picks their spot with data-mark / data-cat, e.g. data-cat="gone 1:hero"
//  = hidden at first, the big hero from click 1 on. Spots are styled under
//  "Persistent layer"; the glows move per slide number.
// ─────────────────────────────────────────────────────────────
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { leadership } from '../data/team';
import { links } from '../data/join';
import { scholarship } from '../data/scholarship';

// Coloured by MCAT section: c = Chem/Phys, b = Bio/Biochem, p = Psych/Soc, s = all of them.
const subjects: [string, 'c' | 'b' | 'p' | 's'][] = [
  ['Orgo 1', 'c'],
  ['Orgo 2', 'c'],
  ['Gen Chem 1', 'c'],
  ['Gen Chem 2', 'c'],
  ['Physics 1', 'c'],
  ['Physics 2', 'c'],
  ['Biology', 'b'],
  ['Physiology', 'b'],
  ['Cell Biology', 'b'],
  ['Genetics', 'b'],
  ['Biochemistry 1 & 2', 'b'],
  ['Psychology', 'p'],
  ['Sociology', 'p'],
  ['Statistics', 's'],
];

const costs = [
  { label: 'MCAT registration', amount: 355, note: 'we provide a scholarship', accent: 'rose' },
  { label: 'AAMC resources', amount: 323.7 },
  { label: 'UWorld', amount: 339, note: 'we provide a discount', accent: 'violet' },
  { label: 'Kaplan books', amount: 200, note: 'talk to us before buying', accent: 'gold' },
];
const total = costs.reduce((a, c) => a + c.amount, 0);

// Officer portraits, cropped for the slides: src/assets/present/<team id>.jpg
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/present/*.jpg', { eager: true });
const officers = leadership.map((m) => ({ ...m, photo: portraits[`../assets/present/${m.id}.jpg`]?.default }));
// Full-length photos: keep the face, not the shoes.
const tall = new Set(['anmol-nayak', 'zander-houchens', 'andrew-peng']);

const qr = (url: string) =>
  QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0d0d0c', light: '#eeebe4' } });
const [qrGroupme, qrBbn] = await Promise.all([qr(links.groupme), qr(links.bbnvolved)]);
const awards = scholarship.awards.need + scholarship.awards.merit;

const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 });
---
<Base title="Presentation" description="The M-CATS: a brief introduction to the MCAT, and to us." bare>
  <div class="deck" data-slide="0" data-mark="hero" data-cat="hero">
    <div class="stage" aria-live="polite">
      <!-- ── Persistent layer ───────────────────────────────── -->
      <div class="glow" aria-hidden="true">
        <span class="g g1"></span>
        <span class="g g2"></span>
        <span class="g g3"></span>
      </div>
      <div class="cat" aria-hidden="true"><Logo label="" /></div>
      <h1 class="mark">
        <span class="mark-the italic">the</span>
        <span class="mark-mcat display ca">MCAT</span>
      </h1>

      <!-- ── 1 · Title ──────────────────────────────────────── -->
      <section class="slide s-title" aria-label="Title" data-mark="hero" data-cat="hero">
        <p class="label kicker">The M-CATS presents</p>
        <p class="mono t-sub">A brief introduction</p>
        <div class="t-foot">
          <p class="mono">The M-CATS @ University of Kentucky</p>
          <span class="t-rule"></span>
          <p class="mono">themcats.org</p>
        </div>
      </section>

      <!-- ── 2 · What it is ─────────────────────────────────── -->
      <section class="slide s-what" aria-label="What the MCAT is" data-mark="header" data-cat="mark">
        <p class="label what-full">Medical College Admission Test</p>

        <div class="what-time fx fx-rise" data-step="1">
          <p class="mono what-cap">One sitting</p>
          <p class="display what-clock ca"><span data-count="450" data-format="hm">7h 30m</span></p>
          <p class="italic what-note">of testing. The longest standardized exam most of us will ever take.</p>
        </div>

        <div class="what-load" data-step="2">
          <p class="what-n fx fx-ca"><span class="display ca">14</span> <span class="italic">classes’ worth of content</span></p>
          <ul class="pills">
            {subjects.map(([name, s], i) => (
              <li class={`pill fx fx-pop`} data-s={s} style={`--i:${i}`}>{name}</li>
            ))}
          </ul>
          <p class="legend mono fx fx-fade" style="--i:15">
            <span><i data-s="c"></i>Chem / Phys</span>
            <span><i data-s="b"></i>Bio / Biochem</span>
            <span><i data-s="p"></i>Psych / Soc</span>
            <span><i data-s="s"></i>Everywhere</span>
          </p>
        </div>
      </section>

      <!-- ── 3 · What it costs ──────────────────────────────── -->
      <section class="slide s-cost" aria-label="What the MCAT costs" data-mark="header" data-cat="mark">
        <p class="label what-full">What it costs</p>

        <ol class="ledger">
          {costs.map((c, i) => (
            <li class="row fx fx-slide" data-step={i + 1}>
              <span class="r-label">{c.label}</span>
              {c.note && <span class={`r-note mono`} data-accent={c.accent}>{c.note}</span>}
              <span class="r-dots" aria-hidden="true"></span>
              <span class="r-amt mono">{money(c.amount)}</span>
            </li>
          ))}
          <li class="row row-total fx fx-fade" data-step={costs.length + 1}>
            <span class="r-label label">Total</span>
            <span class="r-dots" aria-hidden="true"></span>
            <span class="r-amt display ca">~<span data-count={total} data-format="money">{money(total)}</span></span>
          </li>
          <li class="row row-inf fx fx-slide" data-step={costs.length + 2}>
            <span class="r-label">Tutoring <span class="italic dim">(optional)</span></span>
            <span class="r-dots" aria-hidden="true"></span>
            <span class="r-amt inf">∞</span>
          </li>
        </ol>

        <aside class="study fx fx-blur" data-step={costs.length + 3}>
          <p class="display study-n ca nebula-fringe">$6,357</p>
          <p class="italic study-txt">spent on average on MCAT preparation and related costs by Canadian applicants in 2015.</p>
          <p class="mono cite">Fortin et al. (2018), <i>MedEdPublish</i> 7:243 · doi.org/10.15694/mep.2018.0000243.1</p>
        </aside>

        <p class="punch italic fx fx-ca" data-step={costs.length + 4}>
          …and you can still pay all of this and still fail. <span class="mono">;-;</span>
        </p>
      </section>

      <!-- ── 4 · The turn ───────────────────────────────────── -->
      <section class="slide s-turn" aria-label="What do you do?" data-mark="gone" data-cat="gone 1:hero">
        <h2 class="turn-q italic">What do you <span class="turn-do">do?</span></h2>
        <div class="turn-us" data-step="1">
          <p class="turn-word display">
            <span class="ca fx fx-ca">The</span>
            <span class="ca fx fx-ca" style="--i:3">M-CATS</span>
          </p>
          <p class="mono turn-at fx fx-fade" style="--i:8">@ University of Kentucky</p>
          <p class="italic turn-tag fx fx-rise" style="--i:10">A free, peer-driven MCAT prep community.</p>
        </div>
      </section>

      <!-- ── 5 · Officers ───────────────────────────────────── -->
      <section class="slide s-team" aria-label="The team" data-mark="gone" data-cat="mark">
        <p class="label what-full team-label">Leadership</p>
        <h2 class="team-h display ca">Run by students</h2>
        <ul class="team" data-step="1">
          {officers.map((m, i) => (
            <li class="person fx fx-person" style={`--i:${i * 2}`}>
              <div class="frame">
                {m.photo && <Image src={m.photo} alt="" widths={[300, 520]} sizes="320px" loading="eager" class={tall.has(m.id) ? 'tall' : ''} />}
              </div>
              <p class="p-name">{m.name}</p>
              <p class="p-role mono">{m.role}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── 6 · What we do ─────────────────────────────────── -->
      <section class="slide s-offer" aria-label="What we offer" data-mark="gone" data-cat="mark">
        <p class="label what-full team-label">What we do</p>
        <h2 class="team-h display ca">All of it, free</h2>
        <ol class="offers">
          <li class="offer fx fx-rise" data-step="1" data-accent="rose">
            <p class="o-free italic">free</p>
            <h3 class="o-title display">MCAT classes</h3>
            <dl class="o-sched mono">
              <div><dt>Mon · 6–9 PM</dt><dd>Chemistry</dd></div>
              <div><dt>Wed · 5–9 PM</dt><dd>Bio / Biochem</dd></div>
            </dl>
            <p class="o-body">Seminars that walk the Kaplan books chapter by chapter, slides posted after.</p>
            <p class="o-where mono">→ White Hall 231</p>
          </li>
          <li class="offer fx fx-rise" data-step="2" data-accent="violet">
            <p class="o-free italic">free</p>
            <h3 class="o-title display">Peer tutoring</h3>
            <p class="o-body">A one-on-one appointment with one of our officers, booked online whenever you need it.</p>
          </li>
          <li class="offer fx fx-rise" data-step="3" data-accent="gold">
            <p class="o-free italic">free</p>
            <h3 class="o-title display">MCAT funding</h3>
            <p class="o-body">
              A scholarship that covers the <b>${scholarship.amount}</b> registration fee, {awards} awards a year,
              plus member discounts on UWorld.
            </p>
          </li>
        </ol>
      </section>

      <!-- ── 7 · Join ───────────────────────────────────────── -->
      <section class="slide s-join" aria-label="Join us" data-mark="gone" data-cat="corner">
        <p class="label what-full team-label">Come find us</p>
        <h2 class="join-h display ca fx-in">Join us.</h2>
        <p class="join-site display ca fx-in" style="--i:3">themcats<span class="italic">.org</span></p>
        <p class="join-sub italic fx-in" style="--i:5">Every seminar, slide deck, Anki deck and handout, searchable.</p>
        <div class="qrs">
          <figure class="qr fx-in" style="--i:7">
            <div class="qr-code" set:html={qrGroupme} />
            <figcaption><span class="mono">01</span> The GroupMe<small class="italic">announcements &amp; questions</small></figcaption>
          </figure>
          <figure class="qr fx-in" style="--i:9">
            <div class="qr-code" set:html={qrBbn} />
            <figcaption><span class="mono">02</span> BBNvolved<small class="italic">join to access all our resources</small></figcaption>
          </figure>
        </div>
      </section>

      <!-- ── Chrome ─────────────────────────────────────────── -->
      <div class="chrome mono" aria-hidden="true">
        <span>The M-CATS</span>
        <span class="count"><span data-now>01</span> / <span data-total>07</span></span>
      </div>
      <div class="progress" aria-hidden="true"><span></span></div>
    </div>

    <p class="hint mono" aria-hidden="true">
      <kbd>click</kbd> next <kbd>right-click</kbd> back <kbd>scroll</kbd> either way <kbd>F</kbd> fullscreen <kbd>B</kbd> blank
    </p>
    <div class="blank" aria-hidden="true"></div>
  </div>

  <!-- Shown only when the computer has Reduce Motion on. -->
  <div class="motion-ask" role="dialog" aria-modal="true" aria-labelledby="motion-q" hidden>
    <div class="ask-card">
      <p class="label">Before we start</p>
      <h2 id="motion-q" class="italic ask-q">This computer has <em>Reduce Motion</em> turned on.</h2>
      <p class="ask-body">
        That setting switches off this presentation’s animations. Play them anyway? This only affects this page;
        the computer’s setting stays as it is.
      </p>
      <div class="ask-btns">
        <button class="btn btn-solid" data-motion="full" autofocus>Play the animations</button>
        <button class="btn" data-motion="reduced">Keep it still</button>
      </div>
    </div>
  </div>
</Base>

<style>
  /* ── Frame ─────────────────────────────────────────────────── */
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  :global(body) {
    cursor: default;
  }
  .deck {
    --rose: var(--neb-rose);
    --violet: var(--neb-violet);
    --indigo: var(--neb-indigo);
    --gold: var(--neb-gold);
    --dur: 1.3s;
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
    user-select: none;
  }
  .deck.idle {
    cursor: none;
  }
  /* A fixed 1920×1080 canvas, scaled to the screen by the script. */
  .stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1920px;
    height: 1080px;
    transform: translate(-50%, -50%) scale(var(--scale, 0.5));
    overflow: hidden;
  }

  /* ── Persistent layer ──────────────────────────────────────── */
  /* Everything here moves with transform/opacity only, so it glides. */
  .glow,
  .cat,
  .mark {
    position: absolute;
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .glow {
    inset: 0;
    pointer-events: none;
  }
  .g {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.8;
    transition:
      transform 1.8s var(--ease),
      opacity 1.8s var(--ease);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .g1 {
    width: 760px;
    height: 760px;
    left: 1060px;
    top: 120px;
    background: radial-gradient(circle, var(--rose), transparent 68%);
  }
  .g2 {
    width: 620px;
    height: 620px;
    left: 1240px;
    top: 260px;
    background: radial-gradient(circle, var(--violet), transparent 68%);
    animation-duration: 23s;
    animation-delay: -6s;
  }
  .g3 {
    width: 520px;
    height: 520px;
    left: 1120px;
    top: 420px;
    background: radial-gradient(circle, var(--gold), transparent 70%);
    opacity: 0.3;
    animation-duration: 27s;
    animation-delay: -11s;
  }
  @keyframes drift {
    to {
      translate: 60px -40px;
      scale: 1.12;
    }
  }

  .cat {
    left: 1200px;
    top: 210px;
    width: 520px;
    color: #fff;
    transform-origin: 0 0;
  }
  .cat :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.45));
  }
  .cat :global(path) {
    stroke-width: 0.38px !important;
  }

  .mark {
    left: 150px;
    top: 250px;
    margin: 0;
    transform-origin: 0 0;
    white-space: nowrap;
    font-weight: 400;
  }
  .mark-the {
    display: block;
    font-size: 190px;
    line-height: 0.8;
    margin-left: 0.04em;
  }
  .mark-mcat {
    display: block;
    font-size: 330px;
    --ca-rest: 0.03em;
  }

  /* Slide 1: the title card. */
  .deck[data-slide='0'] .mark-mcat {
    animation: ca-in 2.2s var(--ease) both;
  }
  .deck[data-slide='0'] .mark-the {
    animation: ca-in 2.2s 0.15s var(--ease) both;
  }

  /* The wordmark as a header, or gone; the cat as a watermark, a corner mark, or gone. */
  .deck[data-mark='header'] .mark {
    transform: translate(0, -150px) scale(0.3);
  }
  .deck[data-mark='gone'] .mark {
    transform: translate(0, -260px) scale(0.3);
    opacity: 0;
  }
  .deck[data-cat='mark'] .cat {
    transform: translate(540px, 680px) scale(0.16);
    opacity: 0.5;
  }
  .deck[data-cat='gone'] .cat {
    transform: translate(60px, 60px) scale(0.85);
    opacity: 0;
  }
  .deck[data-cat='corner'] .cat {
    transform: translate(96px, -160px) scale(0.42);
    opacity: 0.9;
  }

  /* The glows keep moving from slide to slide. */
  .deck[data-slide='3'] .g1 {
    transform: translate(-400px, 40px) scale(1.2);
    opacity: 0.5;
  }
  .deck[data-slide='3'] .g2 {
    transform: translate(-900px, 100px);
    opacity: 0.4;
  }
  .deck[data-slide='3'] .g3 {
    transform: translate(-200px, -100px) scale(1.2);
    opacity: 0.25;
  }
  .deck[data-slide='3'][data-build='1'] .g1 {
    transform: translate(60px, -40px) scale(1.1);
    opacity: 0.75;
  }
  .deck[data-slide='3'][data-build='1'] .g2 {
    transform: translate(0, 0);
    opacity: 0.6;
  }
  .deck[data-slide='3'][data-build='1'] .g3 {
    transform: none;
    opacity: 0.3;
  }
  .deck[data-slide='4'] .g1 {
    transform: translate(-1300px, -500px) scale(1.1);
    opacity: 0.25;
  }
  .deck[data-slide='4'] .g2 {
    transform: translate(200px, 420px) scale(1.2);
    opacity: 0.3;
  }
  .deck[data-slide='4'] .g3 {
    transform: translate(-600px, 500px) scale(1.3);
    opacity: 0.2;
  }
  .deck[data-slide='5'] .g1 {
    transform: translate(-1150px, 380px) scale(0.9);
    opacity: 0.3;
  }
  .deck[data-slide='5'] .g2 {
    transform: translate(-500px, 420px) scale(0.9);
    opacity: 0.3;
  }
  .deck[data-slide='5'] .g3 {
    transform: translate(150px, 380px) scale(1.1);
    opacity: 0.28;
  }
  .deck[data-slide='6'] .g1 {
    transform: translate(-200px, 120px) scale(1.3);
    opacity: 0.55;
  }
  .deck[data-slide='6'] .g2 {
    transform: translate(60px, 120px) scale(1.2);
    opacity: 0.5;
  }
  .deck[data-slide='6'] .g3 {
    transform: translate(-1000px, 300px) scale(1.2);
    opacity: 0.25;
  }
  .deck[data-slide='1'] .g1 {
    transform: translate(-1100px, 380px) scale(0.8);
    opacity: 0.3;
  }
  .deck[data-slide='1'] .g2 {
    transform: translate(260px, -360px);
    opacity: 0.35;
  }
  .deck[data-slide='1'] .g3 {
    transform: translate(-700px, -500px);
    opacity: 0.18;
  }
  .deck[data-slide='2'] .g1 {
    transform: translate(100px, 300px) scale(1.15);
    opacity: 0.32;
  }
  .deck[data-slide='2'] .g2 {
    transform: translate(-1300px, -380px) scale(0.9);
    opacity: 0.22;
  }
  .deck[data-slide='2'] .g3 {
    transform: translate(200px, -500px);
    opacity: 0.2;
  }

  /* ── Slides ────────────────────────────────────────────────── */
  .slide {
    position: absolute;
    inset: 0;
    padding: 110px 150px;
    opacity: 0;
    filter: blur(18px);
    transform: scale(1.025);
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 1.1s var(--ease);
  }
  .slide.past {
    transform: scale(0.975);
  }
  .slide.on {
    opacity: 1;
    filter: blur(0);
    transform: none;
    pointer-events: auto;
    transition-delay: 0.25s;
  }

  /* Build steps. Hidden until the slide reaches their step. */
  .fx {
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: calc(var(--i, 0) * 55ms);
  }
  [data-step]:not(.shown) .fx,
  .fx[data-step]:not(.shown) {
    opacity: 0;
    transition-delay: 0s;
  }
  [data-step]:not(.shown) .fx-rise,
  .fx-rise[data-step]:not(.shown) {
    transform: translateY(40px);
    filter: blur(10px);
  }
  [data-step]:not(.shown) .fx-pop {
    transform: translateY(24px) scale(0.92);
    filter: blur(8px);
  }
  .fx-slide[data-step]:not(.shown) {
    transform: translateX(-50px);
    filter: blur(8px);
  }
  .fx-blur[data-step]:not(.shown) {
    filter: blur(24px);
    transform: scale(1.04);
  }
  [data-step]:not(.shown) .fx-person {
    transform: translateY(50px);
    filter: blur(12px) grayscale(1);
  }
  /* Animates in as soon as its slide arrives, no click needed. */
  .fx-in {
    transition:
      opacity 1s var(--ease),
      filter 1s var(--ease),
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--i, 0) * 70ms);
  }
  .slide:not(.on) .fx-in {
    opacity: 0;
    filter: blur(14px);
    transform: translateY(30px);
    transition-delay: 0s;
  }
  [data-step].shown .fx-ca,
  .fx-ca[data-step].shown {
    animation: ca-in 1.6s var(--ease) both;
  }
  [data-step]:not(.shown) .fx-ca,
  .fx-ca[data-step]:not(.shown) {
    filter: blur(14px);
  }

  /* ── 1 · Title ─────────────────────────────────────────────── */
  .kicker {
    position: absolute;
    left: 154px;
    top: 150px;
    font-size: 20px;
    letter-spacing: 0.4em;
  }
  .t-sub {
    position: absolute;
    left: 158px;
    top: 830px;
    font-size: 26px;
    letter-spacing: 0.55em;
    color: var(--fg-dim);
  }
  .t-foot {
    position: absolute;
    left: 158px;
    right: 150px;
    bottom: 90px;
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 16px;
    color: var(--muted);
  }
  .t-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--rule-strong), var(--violet) 60%, var(--rose));
    opacity: 0.6;
  }

  /* ── 2 · What ──────────────────────────────────────────────── */
  .what-full {
    position: absolute;
    left: 154px;
    top: 232px;
    font-size: 18px;
    letter-spacing: 0.4em;
  }
  .what-time {
    position: absolute;
