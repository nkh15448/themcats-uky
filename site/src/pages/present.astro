    stroke-dashoffset: 1;
    animation: draw 2.6s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 1ms + 400ms);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('.deck')!;
  const stage = deck.querySelector<HTMLElement>('.stage')!;
  const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
  const steps = slides.map((s) => Math.max(0, ...[...s.querySelectorAll<HTMLElement>('[data-step]')].map((e) => +e.dataset.step!)));
  const totalSteps = steps.reduce((a, n) => a + n + 1, 0) - 1;
  const root = document.documentElement;
  const asksReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Reduced motion applies unless the presenter chose to play animations anyway.
  const reduced = () => asksReduced && !root.classList.contains('full-motion');
  const store = {
    get: () => {
      try {
        return sessionStorage.getItem('present-motion');
      } catch {
        return null;
      }
    },
    set: (v: string) => {
      try {
        sessionStorage.setItem('present-motion', v);
      } catch {}
    },
  };
  if (store.get() === 'full') root.classList.add('full-motion');
  const pad = (n: number) => String(n).padStart(2, '0');

  deck.querySelector('[data-total]')!.textContent = pad(slides.length);

  // Fit the 1920×1080 stage to the window.
  const fit = () => stage.style.setProperty('--scale', String(Math.min(innerWidth / 1920, innerHeight / 1080)));
  fit();
  addEventListener('resize', fit);

  // Draw the wildcat stroke by stroke, outward from the top.
  const cat = deck.querySelector<HTMLElement>('.cat')!;
  const drawCat = () => {
    if (reduced()) return;
    cat.querySelectorAll('path').forEach((p, i) => {
      p.setAttribute('pathLength', '1');
      p.style.setProperty('--d', String(i * 14));
    });
    cat.classList.add('drawing');
  };
  drawCat();

  // Count a number up from zero.
  const count = (el: HTMLElement) => {
    const to = +el.dataset.count!;
    const fmt = (v: number) =>
      el.dataset.format === 'hm'
        ? `${Math.floor(v / 60)}h ${pad(Math.round(v % 60))}m`
        : '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (reduced()) return void (el.textContent = fmt(to));
    const t0 = performance.now();
    const dur = 1600;
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / dur);
      el.textContent = fmt(to * (1 - Math.pow(1 - k, 4)));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  let cur = -1;
  let step = 0;

  // "gone 1:hero" → 'gone' before click 1, 'hero' from click 1 on.
  const placed = (spec = '', st: number) =>
    spec.split(' ').reduce((v, tok) => {
      const [n, val] = tok.includes(':') ? tok.split(':') : ['0', tok];
      return +n <= st ? val : v;
    }, '');

  const render = (fresh: boolean) => {
    deck.dataset.slide = String(cur);
    deck.dataset.build = String(step);
    deck.dataset.mark = placed(slides[cur].dataset.mark, step);
    deck.dataset.cat = placed(slides[cur].dataset.cat, step);
    slides.forEach((s, i) => {
      s.classList.toggle('on', i === cur);
      s.classList.toggle('past', i < cur);
    });
    slides[cur].querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      const show = +el.dataset.step! <= step;
      const was = el.classList.contains('shown');
      el.classList.toggle('shown', show);
      // Count up only when a step is newly revealed going forward.
      if (show && !was && fresh) el.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
    });
    deck.querySelector('[data-now]')!.textContent = pad(cur + 1);
    const done = steps.slice(0, cur).reduce((a, n) => a + n + 1, 0) + step;
    stage.style.setProperty('--p', String(totalSteps ? done / totalSteps : 1));
    history.replaceState(null, '', `#${cur + 1}${step ? '.' + step : ''}`);
  };

  const go = (slide: number, st = 0, fresh = true) => {
    slide = Math.max(0, Math.min(slides.length - 1, slide));
    if (slide !== cur) {
      // Leaving a slide resets its builds, so revisiting it plays them again.
      slides[cur]?.querySelectorAll('.shown').forEach((e) => e.classList.remove('shown'));
      cur = slide;
    }
    step = Math.max(0, Math.min(steps[cur], st));
    render(fresh);
  };
  const next = () => (step < steps[cur] ? go(cur, step + 1) : cur < slides.length - 1 && go(cur + 1, 0));
  // Going back lands on the previous slide fully built, like PowerPoint.
  const prev = () => (step > 0 ? go(cur, step - 1, false) : cur > 0 && go(cur - 1, steps[cur - 1], false));

  // Start where the URL says (#3 or #3.2), so a refresh mid-talk stays put.
  const fromHash = () => {
    const [s0, st0] = location.hash.slice(1).split('.').map(Number);
    go((s0 || 1) - 1, 0);
    for (let i = 0; i < (st0 || 0); i++) next();
  };
  fromHash();
  addEventListener('hashchange', fromHash);

  // Reduce Motion is on and nobody has answered yet: ask before starting.
  const ask = document.querySelector<HTMLElement>('.motion-ask')!;
  if (asksReduced && !store.get()) {
    ask.hidden = false;
    ask.querySelector<HTMLElement>('[autofocus]')?.focus();
  }
  ask.addEventListener('click', (e) => {
    const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-motion]')?.dataset.motion;
    if (!choice) return;
    store.set(choice);
    ask.hidden = true;
    if (choice === 'full') {
      root.classList.add('full-motion');
      // Replay the title card's entrance now that animations are allowed.
      drawCat();
      deck.dataset.slide = '-1';
      void deck.offsetWidth;
      render(false);
    }
  });

  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || !ask.hidden) return;
    const k = e.key;
    if (deck.classList.contains('blanked') && !['b', 'B', '.'].includes(k)) {
      deck.classList.remove('blanked');
      return;
    }
    if (['ArrowRight', 'ArrowDown', ' ', 'PageDown', 'Enter', 'n'].includes(k)) next();
    else if (['ArrowLeft', 'ArrowUp', 'PageUp', 'Backspace', 'p'].includes(k)) prev();
    else if (k === 'Home') go(0);
    else if (k === 'End') go(slides.length - 1, steps[slides.length - 1], false);
    else if (k === 'f' || k === 'F') document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.();
    else if (k === 'b' || k === 'B' || k === '.') deck.classList.toggle('blanked');
    else return;
    e.preventDefault();
  });

  // Mouse as a clicker: click = next, right-click = back,
  // side buttons = back / forward, wheel = either way.
  deck.addEventListener('click', (e) => e.button === 0 && next());
  deck.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    prev();
  });
  // The side buttons would otherwise navigate the browser away from the talk.
  deck.addEventListener('mouseup', (e) => {
    if (e.button !== 3 && e.button !== 4) return;
    e.preventDefault();
    e.button === 3 ? prev() : next();
  });
  deck.addEventListener('auxclick', (e) => (e.button === 3 || e.button === 4) && e.preventDefault());
  // One wheel gesture = one step. While the wheel keeps sending events
  // (a trackpad's momentum), the lock keeps extending, so it never double-steps.
  let wheelLock = 0;
  let wheelSum = 0;
  deck.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const now = performance.now();
      if (now < wheelLock) {
        wheelLock = now + 200;
        return;
      }
      wheelSum += e.deltaY || e.deltaX;
      if (Math.abs(wheelSum) < 30) return;
      wheelSum > 0 ? next() : prev();
      wheelSum = 0;
      wheelLock = now + 500;
    },
    { passive: false },
  );
  let x0 = 0;
  deck.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  deck.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) {
      e.preventDefault();
      dx < 0 ? next() : prev();
    }
  });

  // Show the key hints while the mouse moves; hide the cursor when it rests.
  let idle = 0;
  addEventListener('mousemove', () => {
    deck.classList.add('show-hint');
    deck.classList.remove('idle');
    clearTimeout(idle);
    idle = window.setTimeout(() => {
      deck.classList.remove('show-hint');
      deck.classList.add('idle');
    }, 2200);
  });
</script>
