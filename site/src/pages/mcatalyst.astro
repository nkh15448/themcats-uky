---
// MCatalyst's page: what the app is for, what it does, what's live, and how to install it.
// A PROTOTYPE, deliberately unlinked: not in the nav, the search palette or any page, and marked
// noindex. Keep it that way until the club decides to send students here.
//
// It has its own look, louder than the rest of the site: the app's colours, Anybody for display
// type, Mona Sans for text, paper-white slabs between the dark ones.
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/mona-sans/wght.css';
import Base from '../layouts/Base.astro';
import icon from '../assets/mcatalyst-icon.svg?url';

// Stable installer names, so these links never change between versions. The release workflow
// (catalyst › .github/workflows/app-release.yml) has to upload copies under these names first.
const RELEASES = 'https://github.com/nkh15448/mcatalyst-releases/releases/latest/download';
const downloads = {
  mac: { href: `${RELEASES}/MCatalyst-mac.dmg`, label: 'Download for Mac', note: 'macOS 12 or later · Apple silicon and Intel' },
  windows: { href: `${RELEASES}/MCatalyst-windows.exe`, label: 'Download for Windows', note: 'Windows 10 or 11' },
};

// What's live, chapter by chapter. The content-publish job in catalyst writes it with every content
// release (scripts/publish.mjs › status.json), so this page is as current as the app.
const STATUS = 'https://mkcpsnyskwbfaqccbbtt.supabase.co/storage/v1/object/public/releases/status.json';

const ticker = ['Check every chapter', 'Free', 'No account', 'Every question approved by an officer', 'Mac and Windows', 'Made by The M-CATS'];

// Where MCatalyst sits between learning the content and practicing it.
const path = [
  { n: '01', step: 'Learn', what: 'Kaplan chapters, videos, our seminars', note: 'Teaches the content.' },
  { n: '02', step: 'Check', what: 'MCatalyst', note: 'Finds out what stuck, chapter by chapter.', ours: true },
  { n: '03', step: 'Apply', what: 'UWorld, Jack Westin passages', note: 'Trains you to use it in exam-style passages.' },
  { n: '04', step: 'Prove', what: 'AAMC full-lengths', note: 'Shows where you stand on test day.' },
];

const steps = [
  {
    title: 'Take the chapter’s check',
    body: 'About twelve questions, one for each thing the chapter expects you to know. Most are short answer, typed in your own words, because picking an answer out of four isn’t the same as knowing it.',
  },
  {
    title: 'Grade it honestly',
    body: 'Short answers are marked for you. For explain questions you see a full answer next to yours and tick each key point you made.',
  },
  {
    title: 'Practice what you missed',
    body: 'Every objective comes back solid, shaky or review again, with the section of the chapter to re-read. Practice gives you new questions on just the weak ones, until every one is solid.',
  },
];

const results = [
  ['PFK-1, the rate-limiting step, and its regulators', 100, 'solid', 'Solid', ''],
  ['Substrates for gluconeogenesis and the Cori cycle', 60, 'shaky', 'Shaky', '9.6'],
  ['The oxidative phase of the pentose phosphate pathway', 20, 'missed', 'Review again', '9.7'],
] as const;

// The map card's drawing: chapters as nodes, coloured the way the app colours them.
const mapNodes: [number, number, string][] = [
  [52, 58, 'solid'], [146, 36, 'solid'], [244, 66, 'shaky'], [338, 42, 'new'], [96, 140, 'review'], [196, 150, 'solid'],
  [300, 132, 'turn'], [372, 196, 'new'], [52, 212, 'new'], [156, 214, 'shaky'], [262, 212, 'solid'],
];
const mapEdges = [[0, 1], [1, 2], [2, 3], [0, 4], [1, 5], [2, 5], [2, 6], [3, 6], [4, 5], [4, 8], [5, 9], [5, 10], [6, 10], [6, 7], [8, 9], [10, 7]];

// The periodic table's outline, for the exam tools card: [row, first column, last column].
const tableRows = [[0, 0, 0], [0, 17, 17], [1, 0, 1], [1, 12, 17], [2, 0, 1], [2, 12, 17], [3, 0, 17], [4, 0, 17], [5, 0, 17], [6, 0, 17]];

const faq = [
  { q: 'Is it really free?', a: 'Yes. The M-CATS is a free club and MCatalyst is part of it. There’s nothing to buy and no account to make.' },
  {
    q: 'Does it replace UWorld?',
    a: 'No. Use MCatalyst while you learn the content, and a passage bank like UWorld once it’s solid. Checking each chapter first means that when you get to practice passages, you already know whether the content is there.',
  },
  { q: 'Which chapters have checks?', a: 'The Kaplan biology, biochemistry, general chemistry and organic chemistry chapters the club teaches, once officers have approved their questions. The list under “What’s live” is always current.' },
  { q: 'Do I have to come to seminars?', a: 'No, but the checks follow the seminars, so it works best alongside them: come to the seminar, then take that chapter’s check.' },
  { q: 'Does it work on my phone?', a: 'It’s a desktop app, for Mac and Windows.' },
  { q: 'I found a mistake. What do I do?', a: 'Use “Report a problem” under the question. It goes straight to the officers, and we fix it.' },
];

const spark = 'M0,-9.5 Q0,0 9.5,0 Q0,0 0,9.5 Q0,0 -9.5,0 Q0,0 0,-9.5Z';
---
<Base title="MCatalyst" description="MCatalyst: free chapter checks for the MCAT, from The M-CATS at the University of Kentucky.">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="mc" data-mc>
    {import.meta.env.DEV && (
      <p class="draft">Prototype, linked from nowhere. The download links need stable installer names from the release workflow, and “What’s live” needs status.json from catalyst’s publish job.</p>
    )}

    <!-- ── Hero ─────────────────────────────────────────────────── -->
    <header class="hero">
      <div class="hero-top">
        <p class="tag">A free MCAT app from The <span class="nb">M-CATS</span></p>
        <button class="tag motion" type="button" data-motion aria-pressed="true">Motion <b>on</b></button>
      </div>

      <h1 class="mega-h">
        <span class="sr-only">MCatalyst</span>
        <span class="mega" aria-hidden="true" data-mega>
          {'MCATALYST'.split('').map((ch) => <span>{ch}</span>)}
        </span>
      </h1>

      <!-- The app icon's energy diagram, opened out: a check lowers the step from learning to applying. -->
      <div class="barrier" aria-hidden="true">
        <svg viewBox="0 0 1200 280" data-barrier>
          <defs>
            <linearGradient id="mc-arc" x1="0" x2="1">
              <stop offset="0" stop-color="#9f93ff" /><stop offset=".55" stop-color="#f09ac0" /><stop offset="1" stop-color="#f6d39c" />
            </linearGradient>
          </defs>
          <path class="b-high" d="M0,190 H250 C420,190 470,24 600,24 C730,24 790,236 950,236 H1200" />
          <path class="b-low" id="mc-low" d="M0,190 H250 C420,190 485,122 600,122 C715,122 790,236 950,236 H1200" pathLength="1" />
          <g class="b-dot">
            <circle r="16" class="b-dot-glow" /><circle r="6.5" />
            <animateMotion dur="5.5s" repeatCount="indefinite" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines=".45 0 .55 1">
              <mpath href="#mc-low" />
            </animateMotion>
            <animate attributeName="opacity" dur="5.5s" repeatCount="indefinite" values="0;1;1;0" keyTimes="0;.1;.88;1" />
          </g>
          <g transform="translate(600 122)"><path class="b-spark" d={spark} transform="scale(2.6)" /></g>
        </svg>
        <span class="b-lab b-learn"><i>01</i> Learn</span>
        <span class="b-lab b-check"><i>02</i> Check</span>
        <span class="b-lab b-apply"><i>03</i> Apply</span>
        <span class="b-lab b-without">Without a check</span>
      </div>

      <div class="hero-foot">
        <p class="lede">
          Chapter checks for the MCAT content you’re learning. Finish a chapter, take its check, and find out
          what <em>actually</em> stuck before a question bank finds out for you.
        </p>
        <div>
          <div class="dl" data-downloads>
            {Object.entries(downloads).map(([os, d]) => (
              <a class="go" href={d.href} data-os={os}>{d.label}<span class="go-arrow" aria-hidden="true">↓</span></a>
            ))}
          </div>
          <p class="fine">Free · no account · <a href="#install">How to install</a></p>
          <p class="fine phone" data-phone hidden>MCatalyst is a desktop app. Open this page on your Mac or Windows computer to download it.</p>
        </div>
      </div>
    </header>

    <!-- ── Ticker ───────────────────────────────────────────────── -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-run">
        {[0, 1].map(() => (
          <span class="ticker-set">
            {ticker.map((t) => (
              <span class="ticker-item">{t}<svg viewBox="-10 -10 20 20"><path d={spark} /></svg></span>
            ))}
          </span>
        ))}
      </div>
    </div>

    <!-- ── The problem ──────────────────────────────────────────── -->
    <section class="slab paper problem">
      <div class="wrap">
        <p class="kick"><span>01</span>The problem</p>
        <h2 class="shout" data-reveal>Content review has <span class="it">no</span> <span class="hollow">checkpoint</span></h2>
        <div class="cols" data-reveal>
          <p>
            Most MCAT prep runs in two phases. First you learn the content: a Kaplan chapter, a video, a seminar. Then
            you practice with question banks like UWorld, passages like Jack Westin’s, and eventually the AAMC’s
            full-lengths.
          </p>
          <p>
            The trouble is the space between them. Reading a chapter feels like learning it, but nothing checks whether
            it stuck. The first real test comes weeks later, in a passage built to see whether you can <em>apply</em> the
            content. Miss that question and it’s hard to tell what went wrong: the fact, or the reasoning.
          </p>
          <p>
            Passage banks are good at what they’re for, and UWorld costs money. Neither is built to tell you, chapter
            by chapter, whether the content itself landed. <strong>That’s the gap MCatalyst fills, for free.</strong>
          </p>
        </div>

        <ol class="rail" data-rail aria-label="Where MCatalyst fits">
          {path.map((p) => (
            <li class:list={{ ours: p.ours }}>
              <div class="r-card">
                <span class="r-n">{p.n}</span>
                <span class="r-step">{p.step}</span>
                <span class="r-what">{p.what}</span>
                <span class="r-note">{p.note}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── How it works ─────────────────────────────────────────── -->
    <section class="slab how" data-how>
      <div class="wrap">
        <p class="kick"><span>02</span>How it works</p>
        <h2 class="shout" data-reveal>A check for<br />every chapter</h2>
        <div class="how-grid">
          <ol class="steps">
            {steps.map((st, i) => (
              <li data-step={i} class:list={{ on: i === 0 }}>
                <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="st-t">{st.title}</h3>
                <p class="st-b">{st.body}</p>
              </li>
            ))}
          </ol>

          <div class="app-wrap">
            <!-- Drawn after the app's own screens: system type and the app's colours, so it reads as the app. -->
            <figure class="app" data-app data-at="0" aria-label="A chapter check in MCatalyst">
              <div class="app-bar"><i></i><i></i><i></i><span>MCatalyst</span></div>
              <div class="app-body">
                <div class="scr" data-scr="0">
                  <p class="a-crumb">Biochemistry 9 · Carbohydrate Metabolism I</p>
                  <div class="a-prog"><span>Question 4 of 12</span><i><b></b></i></div>
                  <p class="a-kind">Explain</p>
                  <p class="a-q">Why does a lot of ATP slow glycolysis down?</p>
                  <div class="a-field"><span data-type>ATP binds PFK-1 at a regulatory site and slows the enzyme down.</span><i class="caret"></i></div>
                  <span class="a-btn">Check my answer</span>
                </div>
                <div class="scr" data-scr="1">
                  <div class="a-two">
                    <div><p class="a-lb">Your answer</p><p>ATP binds PFK-1 at a regulatory site and slows the enzyme down.</p></div>
                    <div class="a-full"><p class="a-lb">A full answer</p><p>ATP is an allosteric inhibitor of PFK-1. When energy is plentiful it slows the enzyme, so the cell breaks down less glucose.</p></div>
                  </div>
                  <p class="a-lb">Which of these did your answer make?</p>
                  <ul class="a-pts">
                    <li class="t">ATP binds an allosteric site on PFK-1</li>
                    <li class="t">That lowers PFK-1’s activity</li>
                    <li>So less glucose is broken down when energy is plentiful</li>
                  </ul>
                  <p class="a-tally"><b>67%</b><span class="w-chip v-shaky">Shaky</span></p>
                </div>
                <div class="scr" data-scr="2">
                  <p class="a-crumb">Chapter check · results</p>
                  <div class="a-head"><span>Carbohydrate Metabolism I</span><b>58%</b></div>
                  {results.map(([title, pct, v, label, sec]) => (
                    <div class="w-row">
                      <span class="w-t">{title}</span>
                      <span class="w-bar"><i class={`v-${v}`} style={`--w:${pct}%`}></i></span>
                      <span class={`w-chip v-${v}`}>{label}</span>
                      {sec && <span class="w-re">Re-read section {sec}</span>}
                    </div>
                  ))}
                  <span class="a-go">Practice what you missed: 6 questions →</span>
                </div>
              </div>
            </figure>
            <div class="app-dots" aria-hidden="true">{steps.map((_, i) => <i class:list={{ on: i === 0 }} data-dot={i}></i>)}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Features ─────────────────────────────────────────────── -->
    <section class="slab inside">
      <div class="wrap">
        <p class="kick"><span>03</span>Features</p>
        <h2 class="shout" data-reveal>What’s inside</h2>
        <ul class="bento" data-bento>
          <li class="card c-map" data-reveal>
            <svg class="art" viewBox="0 0 420 250" aria-hidden="true">
              {mapEdges.map(([a, b]) => (
                <line x1={mapNodes[a][0]} y1={mapNodes[a][1]} x2={mapNodes[b][0]} y2={mapNodes[b][1]} />
              ))}
              {mapNodes.map(([x, y, s]) => (
                <g transform={`translate(${x} ${y})`}>
                  {s === 'turn' && <circle class="ring" r="15" />}
                  <circle class={`node n-${s}`} r="11" />
                </g>
              ))}
            </svg>
            <h3>The map</h3>
            <p>Every Kaplan chapter the club teaches, coloured by where you stand: not taken, review again or solid. Or see the same chapters as a mind map.</p>
          </li>
          <li class="card c-links" data-reveal>
            <svg class="art" viewBox="0 0 420 110" aria-hidden="true">
              <path id="mc-link" class="link" d="M70,70 C160,-6 260,-6 350,70" pathLength="1" />
              <circle class="pulse" r="5">
                <animateMotion dur="2.6s" repeatCount="indefinite" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines=".45 0 .55 1"><mpath href="#mc-link" /></animateMotion>
              </circle>
              <circle class="node n-solid" cx="70" cy="70" r="11" /><circle class="node n-shaky" cx="350" cy="70" r="11" />
              <text x="70" y="104" text-anchor="middle">Enzymes</text><text x="350" y="104" text-anchor="middle">Carbohydrates I</text>
            </svg>
            <h3>Connections</h3>
            <p>Lines between related chapters open questions that need both at once, the way the MCAT mixes topics.</p>
          </li>
          <li class="card c-results" data-reveal>
            <div class="art bars" aria-hidden="true"><i class="v-solid" style="--w:100%"></i><i class="v-shaky" style="--w:60%"></i><i class="v-missed" style="--w:20%"></i></div>
            <h3>Results by objective</h3>
            <p>Not just a score. You see which objective slipped and which section to re-read.</p>
          </li>
          <li class="card c-tools" data-reveal>
            <div class="art tools" aria-hidden="true">
              <svg viewBox="0 0 180 72">
                {tableRows.flatMap(([r, a, b]) => Array.from({ length: b - a + 1 }, (_, k) => (
                  <rect x={(a + k) * 10} y={r * 10} width="8" height="8" rx="1.5" class:list={{ hot: r === 1 && a + k === 13 }} />
                )))}
              </svg>
              <kbd class="key">⌥T</kbd>
            </div>
            <h3>Exam tools</h3>
            <p>A periodic table on ⌥T / Alt+T, like the real exam’s, and a focus timer for study sessions.</p>
          </li>
          <li class="card" data-reveal>
            <svg class="art glyph" viewBox="0 0 120 64" aria-hidden="true"><path class="axis" d="M8,4 V56 H116" /><path class="curve" d="M8,56 C24,18 50,12 112,10" pathLength="1" /></svg>
            <h3>Reference charts</h3>
            <p>Explanations link to charts drawn for the club, from pathways to structures to trends. Open them and zoom in.</p>
          </li>
          <li class="card" data-reveal>
            <div class="art glyph cols-art" aria-hidden="true">{[40, 72, 55, 88, 64, 96, 80].map((h) => <i style={`--h:${h}%`}></i>)}</div>
            <h3>Statistics</h3>
            <p>How your checks have gone over time, chapter by chapter and objective by objective.</p>
          </li>
          <li class="card" data-reveal>
            <div class="art glyph swatches" aria-hidden="true">{['#7d6cf5', '#e07aa8', '#6fd8bf', '#e6c98f', '#f4f0e6'].map((c) => <i style={`--c:${c}`}></i>)}</div>
            <h3>Make it yours</h3>
            <p>Themes, fonts and colours, from quiet to loud.</p>
          </li>
          <li class="card" data-reveal>
            <svg class="art glyph" viewBox="0 0 120 64" aria-hidden="true"><path class="axis" d="M20,40 V54 H100 V40" /><path class="curve down" d="M60,6 V40 M46,27 L60,41 L74,27" /></svg>
            <h3>Works offline</h3>
            <p>Everything saves on your computer, with no account. New questions download by themselves as officers approve them.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ── How the questions are made ───────────────────────────── -->
    <section class="slab made">
      <div class="wrap">
        <p class="kick"><span>04</span>How the questions are made</p>
        <h2 class="made-h" data-reveal>
          <span class="made-ai">Drafted with AI.</span>
          <span class="made-people">Checked by people.</span>
        </h2>
        <div class="made-grid">
          <p class="claim" data-reveal>
            We use AI to draft questions from the chapters. It’s how a student club can cover this much material. But a
            draft isn’t something you should have to trust. <strong><mark>Every question in MCatalyst has been answered and approved by an M‑CATS officer before it reaches you.</mark></strong>
          </p>
          <ol class="checks">
            <li data-reveal><b>Answered blind first.</b> An officer takes each question the way you will, before seeing the answer.</li>
            <li data-reveal><b>Every part checked.</b> The answer, the explanation and every figure, and fixed wherever something’s off.</li>
            <li data-reveal><b>Held back until it’s right.</b> A question that isn’t ready doesn’t reach you.</li>
            <li data-reveal><b>Open to your eyes too.</b> Every question has “Report a problem”, and reports go straight to the officers.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ── What's live ──────────────────────────────────────────── -->
    <section class="slab paper live" id="live">
      <div class="wrap">
        <p class="kick"><span>05</span>What’s live<span class="kick-r" data-updated></span></p>
        <div class="live-top">
          <h2 class="shout" data-reveal>Always<br />growing</h2>
          <p class="live-lede" data-reveal>
            Officers approve new questions all the time. They go out to everyone as they’re approved, and the app
            downloads them by itself, with nothing to reinstall. This list comes from the same place the app gets its
            questions, so it’s always current.
          </p>
        </div>

        <div class="board" data-board data-state="loading" data-src={STATUS}>
          <div class="tally">
            <p class="t-big"><b data-n-live>0</b><span>of <span data-n-all>48</span> chapters have a check</span></p>
            <p class="t-sub" data-n-q></p>
          </div>
          <div class="meter"><i data-meter></i><span data-pct></span></div>
          <div class="latest" data-latest hidden>
            <p class="latest-h">Latest update · <span data-latest-date></span></p>
            <ul data-latest-list></ul>
          </div>
          <div class="books" data-books>
            {['Biology', 'Biochemistry', 'General Chemistry', 'Organic Chemistry'].map((b) => (
              <div class="book skeleton"><p class="book-h">{b}</p><ul>{Array.from({ length: 12 }, () => <li></li>)}</ul></div>
            ))}
          </div>
          <p class="fail" data-fail hidden>Couldn’t load the list just now. Everything that’s live is in the app.</p>
        </div>
      </div>
    </section>

    <!-- ── Install ──────────────────────────────────────────────── -->
    <section class="slab install" id="install">
      <div class="wrap">
        <p class="kick"><span>06</span>Install<span class="kick-r">About two minutes</span></p>
        <div class="os-grid" data-os-grid>
          <article class="os" data-os-card="mac" data-reveal>
            <p class="os-tag">Your computer</p>
            <h3 class="os-h">Mac</h3>
            <ol class="os-steps">
              <li>Download MCatalyst for Mac and open the file.</li>
              <li>Drag MCatalyst into your Applications folder.</li>
              <li>Open it. macOS says it can’t verify the app. Click <b>Done</b>.</li>
              <li>Open <b>System Settings › Privacy &amp; Security</b>, scroll down, and click <b>Open Anyway</b> next to MCatalyst. Enter your password if it asks.</li>
              <li>That’s it. You only do this once.</li>
            </ol>
            <a class="go" href={downloads.mac.href} data-os="mac">{downloads.mac.label}<span class="go-arrow" aria-hidden="true">↓</span></a>
            <p class="fine">{downloads.mac.note}</p>
          </article>
          <article class="os" data-os-card="windows" data-reveal>
            <p class="os-tag">Your computer</p>
            <h3 class="os-h">Windows</h3>
            <ol class="os-steps">
              <li>Download MCatalyst for Windows and run the installer.</li>
              <li>If Windows says <b>Windows protected your PC</b>, click <b>More info</b>, then <b>Run anyway</b>.</li>
              <li>Follow the installer. MCatalyst opens when it’s done.</li>
            </ol>
            <a class="go" href={downloads.windows.href} data-os="windows">{downloads.windows.label}<span class="go-arrow" aria-hidden="true">↓</span></a>
            <p class="fine">{downloads.windows.note}</p>
          </article>
        </div>
        <aside class="why" data-reveal>
          <p class="why-h">Why the warning?</p>
          <p>
            Apps from big companies are signed with a paid developer certificate, so your computer can check who made
            them. We’re a student club, so MCatalyst isn’t, and your computer says it can’t verify it. That’s all the
            warning means. The app comes straight from The <span class="nb">M-CATS</span>. After the first launch it updates itself, and new
            questions arrive on their own.
          </p>
        </aside>
      </div>
    </section>

    <!-- ── Your data and questions ──────────────────────────────── -->
    <section class="slab small">
      <div class="wrap small-grid">
        <div>
          <p class="kick"><span>07</span>Your data</p>
          <ul class="data">
            <li><b>No account</b><span>Your progress stays on your computer.</span></li>
            <li><b>Anonymous usage data</b><span>When you open MCatalyst, which checks you start and finish, and whether each answer was right. It never sends what you type, your name or your email. It helps us a lot, and you can turn it off anytime in About.</span></li>
            <li><b>Reports</b><span>“Report a problem” sends the question and your note to the officers, and nothing about you.</span></li>
          </ul>
        </div>
        <div>
          <p class="kick"><span>08</span>Questions</p>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Last call ────────────────────────────────────────────── -->
    <section class="end">
      <div class="wrap end-in">
        <img src={icon} alt="" width="88" height="88" />
        <h2 class="end-h" data-reveal>Check what<br />you’ve read</h2>
        <div class="dl" data-downloads>
          {Object.entries(downloads).map(([os, d]) => (
            <a class="go" href={d.href} data-os={os}>{d.label}<span class="go-arrow" aria-hidden="true">↓</span></a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const mc = document.querySelector<HTMLElement>('[data-mc]')!;
  const html = document.documentElement;

  // ── Downloads: the visitor's own platform first and solid. On a phone, say it's a desktop app.
  const ua = navigator.userAgent;
  const phone = /iPhone|iPad|Android/i.test(ua) || (navigator.maxTouchPoints > 1 && /Macintosh/.test(ua));
  const mine = /Windows/i.test(ua) ? 'windows' : /Mac/i.test(ua) ? 'mac' : null;
  if (phone) document.querySelector<HTMLElement>('[data-phone]')!.hidden = false;
  else if (mine) {
    document.querySelectorAll<HTMLAnchorElement>(`a[data-os="${mine}"]`).forEach((a) => a.classList.add('solid'));
    document.querySelectorAll<HTMLElement>('[data-downloads]').forEach((box) => {
      const first = box.querySelector(`a[data-os="${mine}"]`);
      if (first) box.prepend(first);
    });
    const card = document.querySelector<HTMLElement>(`[data-os-card="${mine}"]`)!;
    card.classList.add('mine');
    card.parentElement!.prepend(card);
  }

  // ── Motion. Off by default for anyone whose system asks for less; either way the button decides.
  // Off makes every animation jump to its end; on, for someone whose system asks for less, sets
  // .full-motion so global.css lets this page move.
  const KEY = 'mcatalyst-page-motion';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let saved: string | null = null;
  try { saved = localStorage.getItem(KEY); } catch {}
  let moving = saved ? saved === 'on' : !reduce;
  const motionBtn = document.querySelector<HTMLButtonElement>('[data-motion]')!;
  const svgs = () => document.querySelectorAll<SVGSVGElement>('.mc svg');
  function setMotion(on: boolean, remember = false) {
    moving = on;
    mc.classList.toggle('still', !on);
    html.classList.toggle('full-motion', on && reduce);
    motionBtn.setAttribute('aria-pressed', String(on));
    motionBtn.querySelector('b')!.textContent = on ? 'on' : 'off';
    svgs().forEach((s) => (on ? s.unpauseAnimations() : s.pauseAnimations()));
    if (remember) try { localStorage.setItem(KEY, on ? 'on' : 'off'); } catch {}
    if (!on) resetMega();
  }
  motionBtn.addEventListener('click', () => setMotion(!moving, true));

  // ── The name: letters near the pointer pull narrow, then flow back out.
  const mega = document.querySelector<HTMLElement>('[data-mega]')!;
  const letters = [...mega.children] as HTMLElement[];
  const WIDE = 150, NARROW = 78;
  const now = letters.map(() => WIDE), target = letters.map(() => WIDE);
  let centers: number[] = [], reach = 1, frame = 0, ready = false;
  const measure = () => {
    letters.forEach((l) => (l.style.fontStretch = ''));
    centers = letters.map((l) => { const r = l.getBoundingClientRect(); return r.left + r.width / 2; });
    reach = mega.getBoundingClientRect().width / 7;
    letters.forEach((l, i) => (l.style.fontStretch = `${now[i]}%`));
  };
  const tick = () => {
    let busy = false;
    letters.forEach((l, i) => {
      const d = target[i] - now[i];
      if (Math.abs(d) > 0.05) { now[i] += d * 0.14; busy = true; } else now[i] = target[i];
      l.style.fontStretch = `${now[i]}%`;
    });
    frame = busy ? requestAnimationFrame(tick) : 0;
  };
  const kick = () => { if (!frame) frame = requestAnimationFrame(tick); };
  function resetMega() {
    target.fill(WIDE);
    if (moving) kick(); else { cancelAnimationFrame(frame); frame = 0; now.fill(WIDE); letters.forEach((l) => (l.style.fontStretch = '')); }
  }
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const hero = mega.closest('header')!;
    mega.addEventListener('animationend', () => { ready = true; measure(); }, { once: true });
    if (!moving || getComputedStyle(mega).animationName === 'none') ready = true;
    addEventListener('resize', () => { if (ready) measure(); });
    hero.addEventListener('pointermove', (e) => {
      if (!moving || !ready) return;
      if (!centers.length) measure();
      const box = mega.getBoundingClientRect();
      const near = e.clientY > box.top - box.height * 0.6 && e.clientY < box.bottom + box.height * 0.6;
      centers.forEach((c, i) => {
        const x = (e.clientX - c) / reach;
        target[i] = near ? WIDE - (WIDE - NARROW) * Math.exp(-x * x) : WIDE;
      });
      kick();
    });
    hero.addEventListener('pointerleave', resetMega);
  }

  // ── The rail: MCatalyst's step drops into its empty slot once the rail is on screen.
  const rail = document.querySelector<HTMLElement>('[data-rail]')!;
  if (moving) {
    rail.classList.add('wait');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      rail.classList.add('drop');
      setTimeout(() => rail.classList.remove('wait'), 250);
    }, { rootMargin: '0px 0px -25% 0px' });
    io.observe(rail);
  }

  // ── How it works: the step in the middle of the screen drives the app window. On narrow screens
  // the window sits above the steps and moves on by itself while it's in view; a tap picks a step.
  const app = document.querySelector<HTMLElement>('[data-app]')!;
  const stepEls = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const typed = app.querySelector<HTMLElement>('[data-type]')!;
  const sentence = typed.textContent!;
  let at = -1, typing = 0;
  function show(i: number) {
    if (i === at) return;
    at = i;
    app.dataset.at = String(i);
    stepEls.forEach((s, k) => s.classList.toggle('on', k === i));
    dots.forEach((d, k) => d.classList.toggle('on', k === i));
    clearInterval(typing);
    if (i === 0 && moving) {
      let n = 0;
      typed.textContent = '';
      typing = window.setInterval(() => {
        typed.textContent = sentence.slice(0, ++n);
        if (n >= sentence.length) clearInterval(typing);
      }, 34);
    } else typed.textContent = sentence;
  }
  const narrow = matchMedia('(max-width: 900px)');
  const middle = new IntersectionObserver(
    (entries) => {
      if (narrow.matches) return;
      entries.forEach((e) => e.isIntersecting && show(Number((e.target as HTMLElement).dataset.step)));
    },
    { rootMargin: '-48% 0px -48% 0px' },
  );
  stepEls.forEach((s) => middle.observe(s));
  let cycle = 0, appSeen = false;
  const auto = () => { clearInterval(cycle); cycle = window.setInterval(() => moving && show((at + 1) % 3), 5200); };
  new IntersectionObserver(([e]) => {
    appSeen = e.isIntersecting;
    if (appSeen && at < 0) show(0);
    if (appSeen && narrow.matches) auto(); else clearInterval(cycle);
  }, { threshold: 0.35 }).observe(app);
  stepEls.forEach((s, i) => s.addEventListener('click', () => {
    if (!narrow.matches) return;
    show(i);
    if (appSeen) auto();
  }));

  // ── Feature cards: a soft light follows the pointer.
  document.querySelector('[data-bento]')!.addEventListener('pointermove', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', `${(e as PointerEvent).clientX - r.left}px`);
    card.style.setProperty('--my', `${(e as PointerEvent).clientY - r.top}px`);
  });

  // ── What's live: status.json from the content releases bucket.
  interface Chapter { code: string; book: string; bookName: string; number: number; title: string; questions: number; since: string | null; updated: string | null }
  interface Status { updated: string; connections: number; chapters: Chapter[] }
  const board = document.querySelector<HTMLElement>('[data-board]')!;
  const $ = <T extends HTMLElement>(sel: string) => board.querySelector<T>(sel)!;
  const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
  const el = (tag: string, cls: string, text?: string | number) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = String(text);
    return n;
  };
  function fill(s: Status) {
    const live = s.chapters.filter((c) => c.questions > 0);
    const questions = live.reduce((n, c) => n + c.questions, 0) + s.connections;
    const pct = s.chapters.length ? Math.round((live.length / s.chapters.length) * 100) : 0;
    count(live.length);
    $('[data-n-all]').textContent = String(s.chapters.length);
    $('[data-n-q]').textContent = `${questions.toLocaleString('en-US')} question${questions === 1 ? '' : 's'} approved${s.connections ? `, ${s.connections} of them connecting chapters` : ''}`;
    $('[data-pct]').textContent = `${pct}%`;
    board.style.setProperty('--pct', `${pct}%`);
    document.querySelector<HTMLElement>('[data-updated]')!.textContent = `Updated ${day(s.updated)}`;

    const added = live.filter((c) => c.updated === s.updated);
    if (added.length) {
      $('[data-latest-date]').textContent = day(s.updated);
      const list = $('[data-latest-list]');
      list.replaceChildren(...added.map((c) => {
        const li = el('li', '');
        li.append(el('span', 'l-new', c.since === s.updated ? 'New' : 'Updated'), el('span', 'l-t', `${c.bookName} ${c.number}: ${c.title}`), el('span', 'l-q', `${c.questions} questions`));
        return li;
      }));
      $('[data-latest]').hidden = false;
    }

    const books = new Map<string, Chapter[]>();
    s.chapters.forEach((c) => books.set(c.bookName, [...(books.get(c.bookName) ?? []), c]));
    $('[data-books]').replaceChildren(...[...books].map(([name, chs]) => {
      const box = el('div', 'book');
      const head = el('p', 'book-h', name);
      head.append(el('span', '', `${chs.filter((c) => c.questions).length}/${chs.length}`));
      const ul = el('ul', '');
      ul.append(...chs.map((c) => {
        const li = el('li', c.questions ? 'on' : '');
        li.append(el('span', 'box'), el('span', 'c-n', c.number), el('span', 'c-t', c.title), el('span', 'c-q', c.questions || ''));
        li.title = c.questions ? `${c.questions} questions, live since ${day(c.since!)}` : 'Not live yet';
        return li;
      }));
      box.append(head, ul);
      return box;
    }));
    board.dataset.state = 'ready';
  }
  // The meter fills, and the count runs up, once the board is on screen.
  let seen = false, liveN = 0;
  function count(n?: number) {
    if (n !== undefined) liveN = n;
    const out = $('[data-n-live]');
    if (!seen || !moving || !liveN) { out.textContent = String(seen || !moving ? liveN : 0); return; }
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1400);
      out.textContent = String(Math.round(liveN * (1 - Math.pow(1 - k, 3))));
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  new IntersectionObserver(([e], io) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    seen = true;
    board.classList.add('seen');
    count();
  }, { rootMargin: '0px 0px -20% 0px' }).observe(board);

  // A development build can look at a sample: /mcatalyst/?status=<url of a status.json>.
  const src = (import.meta.env.DEV && new URLSearchParams(location.search).get('status')) || board.dataset.src!;
  fetch(src, { cache: 'no-cache' })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then(fill)
    .catch(() => {
      board.dataset.state = 'failed';
      $('[data-fail]').hidden = false;
    });

  setMotion(moving);
</script>

