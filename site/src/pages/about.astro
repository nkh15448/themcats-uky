---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Gallery from '../components/Gallery.astro';
import { letter, beliefs, futureMilestones } from '../data/about';
import { scholarship } from '../data/scholarship';
import { impact } from '../data/impact';
import { meetings, library, fmtDate, meetingUrl } from '../lib/data';
import { chapter } from '../lib/kaplan';

const all = await meetings();
const lib = await library();
const iso = (d: Date) => d.toISOString().slice(0, 10);

// ── Our story: milestones pulled from the meeting and scholarship data ──
const firstMeeting = all[0];
const kickoff = all.find((m) => m.data.title === 'Introductory Meeting');
const firstSeminar = all.find((m) => m.data.covers.length > 0);
const lastMeeting = all.at(-1)!;
const sessions = all.filter((m) => m.data.covers.length || m.data.topics.length).length;
const awards = scholarship.awards.need + scholarship.awards.merit;

const story = [
  firstMeeting && { date: iso(firstMeeting.data.date), label: 'The first general interest meeting', note: 'Introducing the club to its first members, in JSB.', href: meetingUrl(firstMeeting) },
  kickoff && { date: iso(kickoff.data.date), label: 'Our first semester begins', note: 'The introductory meeting, and UWorld discounts for members.', href: meetingUrl(kickoff) },
  firstSeminar && {
    date: iso(firstSeminar.data.date),
    label: 'The first seminar',
    note: firstSeminar.data.covers.map((c) => `${chapter(c).short}: ${chapter(c).title}`).join(' · '),
    href: meetingUrl(firstSeminar),
  },
  { date: scholarship.opens.slice(0, 10), label: 'Scholarship applications open', note: `${awards} awards covering the MCAT registration fee.`, href: url('/scholarship/') },
  { date: scholarship.timeline.at(-1)!.date, label: 'First scholarship recipients', note: 'Announced with conditional acceptance.', href: url('/scholarship/') },
  { date: iso(lastMeeting.data.date), label: 'Semester wrap-up', note: `${sessions} sessions on the books, and a pizza party.`, href: meetingUrl(lastMeeting) },
].filter(Boolean) as { date: string; label: string; note: string; href: string }[];

// ── Numbers: what's computable at build time; meeting counts are finished in the browser ──
const meetingData = all.map((m) => ({ d: iso(m.data.date), c: m.data.covers }));
const scholarshipTotal = scholarship.amount * awards;

// Hand-counted impact numbers: each appears only once it has a value.
const saved = impact.uworldSavings != null ? impact.uworldSavings + scholarshipTotal : null;
const handCounted = [
  impact.hoursTeaching != null && { label: 'Hours teaching & tutoring', value: impact.hoursTeaching },
  impact.studentsTutored != null && { label: 'Students tutored one-on-one', value: impact.studentsTutored },
  saved != null && {
    label: 'Saved for members',
    value: saved,
    money: true,
    note: `$${impact.uworldSavings!.toLocaleString('en-US')} in UWorld discounts + $${scholarshipTotal.toLocaleString('en-US')} in scholarships`,
  },
].filter(Boolean) as { label: string; value: number; money?: boolean; note?: string }[];
const asOf = impact.asOf ? fmtDate(new Date(`${impact.asOf}T12:00:00Z`), { month: 'long', day: 'numeric', year: 'numeric' }) : null;
---
<Base title="About" description="Why The M-CATS exists: a letter from our founder, what we believe, and our story so far.">
  <header class="wrap head">
    <p class="label">About · The M-CATS at the University of Kentucky</p>
    <h1 class="display ca ca-in">Nobody faces<br />it alone.</h1>
    <p class="intro italic">A free, peer-driven MCAT community, started by students who learned the hard way how isolating this exam can be.</p>
  </header>

  <!-- ── The letter ─────────────────────────────────────────── -->
  <section class="letter-wrap">
    <div class="wrap letter-grid">
      <aside class="letter-side">
        <p class="label">A letter from the founder</p>
        <div class="progress" aria-hidden="true"><span data-letter-progress></span></div>
      </aside>
      <article class="letter" data-letter>
        {letter.paragraphs.map((p, i) =>
          p.pull ? (
            <blockquote class="pull italic" data-lit>{p.text}</blockquote>
          ) : (
            <p class={i === 0 ? 'body first' : 'body'} data-lit>{p.text}</p>
          ),
        )}
        <footer class="sign">
          <Logo class="sign-lion" label="" />
          <div>
            <p class="sign-name italic">{letter.author}</p>
            <p class="mono sign-title">{letter.title}</p>
          </div>
        </footer>
        {letter.postscript && <p class="ps" data-lit>{letter.postscript}</p>}
      </article>
    </div>
  </section>

  <!-- ── By the numbers ─────────────────────────────────────── -->
  <section class="wrap section-tight">
    <div class="section-head"><p class="label">So far</p><p class="label" data-asof></p></div>
    <dl class="nums" data-reveal>
      <div><dt class="label">Seminars held</dt><dd class="display" data-count data-k="held">0</dd></div>
      <div><dt class="label">Kaplan chapters taught</dt><dd class="display" data-count data-k="chapters">0</dd></div>
      <div><dt class="label">In the library</dt><dd class="display" data-count={lib.length}>0</dd></div>
      <div><dt class="label">In scholarships this year</dt><dd class="display"><span>$</span><span data-count={scholarshipTotal}>0</span></dd></div>
      <div class="zero"><dt class="label">Cost to you</dt><dd class="display nebula-text">$0</dd></div>
    </dl>
    {handCounted.length > 0 && (
      <>
        <div class="section-head hand-head">
          <p class="label">Counted by hand</p>
          {asOf && <p class="label">As of {asOf}</p>}
        </div>
        <dl class="nums hand" data-reveal style={`--cols:${handCounted.length}`}>
          {handCounted.map((h) => (
            <div>
              <dt class="label">{h.label}</dt>
              <dd class="display">{h.money && <span>$</span>}<span data-count={h.value}>0</span></dd>
              {h.note && <p class="hand-note mono">{h.note}</p>}
            </div>
          ))}
        </dl>
      </>
    )}
  </section>

  <!-- ── What we believe ────────────────────────────────────── -->
  <section class="wrap section-tight">
    <div class="section-head"><p class="label">What we believe</p></div>
    <ol class="beliefs">
      {beliefs.map((b, i) => (
        <li data-reveal style={`--d:${i * 80}ms`}>
          <span class="mono b-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="b-t display">{b.title}</h3>
          <p class="b-b">{b.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── Our story ──────────────────────────────────────────── -->
  <section class="wrap section-tight">
    <div class="section-head"><p class="label">Our story so far</p></div>
    <ol class="story">
      {story.map((s) => (
        <li data-date={s.date} data-reveal>
          <span class="star" aria-hidden="true"></span>
          <a href={s.href} class="st-link">
            <span class="mono st-date">{fmtDate(new Date(`${s.date}T12:00:00Z`), { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="st-label">{s.label}</span>
            <span class="st-note italic">{s.note}</span>
          </a>
        </li>
      ))}
      {futureMilestones.map((f) => (
        <li class="future" data-reveal>
          <span class="star" aria-hidden="true"></span>
          <div class="st-link">
            <span class="mono st-date">Next</span>
            <span class="st-label">{f.label}</span>
            <span class="st-note italic">{f.note}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <Gallery />

  <section class="wrap cta" data-reveal>
    <p class="cta-line display">Come study with us.</p>
    <div class="cta-actions">
      <a class="btn btn-solid" href={url('/join/')}>Join the M-CATS →</a>
      <a class="btn" href={url('/team/')}>Meet the team</a>
      <a class="btn" href={url('/meetings/')}>See the schedule</a>
    </div>
  </section>

  <script type="application/json" id="about-data" set:html={JSON.stringify(meetingData)} />
</Base>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  const now = new Date();
  const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Letter: words brighten as they cross the reading line ──
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-lit]')];
  const words: HTMLElement[][] = blocks.map((el) => {
    const parts = el.textContent!.split(/(\s+)/);
    el.textContent = '';
    return parts.flatMap((w) => {
      if (/^\s+$/.test(w)) {
        el.append(w);
        return [];
      }
      const span = document.createElement('span');
      span.className = 'w';
      span.textContent = w;
      el.append(span);
      return [span];
    });
  });
  const bar = document.querySelector<HTMLElement>('[data-letter-progress]');
  const article = document.querySelector<HTMLElement>('[data-letter]')!;
  let ticking = false;
  function light() {
    ticking = false;
    const line = innerHeight * 0.68;
    // Measure everything first, then change classes, so the browser lays out once per frame.
    const rects = blocks.map((el) => el.getBoundingClientRect());
    const a = article.getBoundingClientRect();
    const tops = blocks.map((_, b) =>
      rects[b].top <= line && rects[b].bottom >= line ? words[b].map((w) => w.getBoundingClientRect().top) : null,
    );
    blocks.forEach((_, b) => {
      const r = rects[b];
      const ws = words[b];
      if (r.bottom < line) return ws.forEach((w) => w.classList.add('on'));
      if (r.top > line) return ws.forEach((w) => w.classList.remove('on'));
      // inside this block: light every word whose line is above the reading line
      ws.forEach((w, i) => w.classList.toggle('on', tops[b]![i] < line));
    });
    const p = Math.min(1, Math.max(0, (line - a.top) / a.height));
    if (bar) bar.style.transform = `scaleY(${p})`;
  }
  if (reduce) {
    words.flat().forEach((w) => w.classList.add('on'));
  } else {
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(light); } }, { passive: true });
    addEventListener('resize', light);
    light();
  }

  // ── Numbers: finish the meeting counts with today's date, then count up ──
  const data: { d: string; c: string[] }[] = JSON.parse(document.getElementById('about-data')!.textContent!);
  const past = data.filter((m) => m.d < today && m.c.length);
  const values: Record<string, number> = { held: past.length, chapters: new Set(past.flatMap((m) => m.c)).size };
  document.querySelector('[data-asof]')!.textContent = `As of ${now.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}`;
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  const target = (el: HTMLElement) => (el.dataset.k ? values[el.dataset.k] : Number(el.dataset.count));
  const run = (el: HTMLElement) => {
    const end = target(el);
    if (reduce) return void (el.textContent = end.toLocaleString('en-US'));
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1400);
      el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))).toLocaleString('en-US');
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (run(e.target as HTMLElement), io.unobserve(e.target))));
  counters.forEach((c) => io.observe(c));

  // ── Story: mark what has already happened ──
  document.querySelectorAll<HTMLElement>('.story li[data-date]').forEach((li) => li.classList.toggle('done', li.dataset.date! <= today));
</script>

<style>
  .head {
    padding-block: clamp(3rem, 7vw, 5rem) 2rem;
  }
  .head h1 {
    font-size: clamp(3.4rem, 11.5vw, 10.5rem);
    letter-spacing: -0.035em;
    line-height: 0.86;
    margin: 1rem 0 1.75rem;
  }
  .intro {
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    line-height: 1.25;
    color: var(--fg-dim);
    max-width: 36ch;
  }
  .section-tight {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  /* ── Letter ── */
  .letter-wrap {
    border-block: 1px solid var(--rule);
    padding-block: clamp(4rem, 9vw, 7rem);
    margin-top: 3rem;
  }
  .letter-grid {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .letter-side {
    position: sticky;
    top: 110px;
    align-self: start;
    display: grid;
    gap: 1.5rem;
  }
  .progress {
    width: 1px;
    height: 40vh;
    background: var(--rule);
    position: relative;
  }
  .progress span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--neb-indigo), var(--neb-violet) 45%, var(--neb-rose) 80%, var(--neb-gold));
    transform-origin: top;
    transform: scaleY(0);
    box-shadow: 0 0 8px rgba(160, 140, 246, 0.5);
  }
  .letter {
    max-width: 36rem;
    display: grid;
    gap: 1.6rem;
  }
  .body {
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    line-height: 1.55;
  }
  .first::first-letter {
    float: left;
    font-family: var(--display);
    font-weight: 700;
    font-size: 5.2em;
    line-height: 0.78;
    padding: 0.06em 0.12em 0 0;
    color: var(--fg);
  }
  .pull {
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    line-height: 1.12;
    margin-block: 1.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--neb-violet);
  }
  /* each word starts dim and brightens as it passes the reading line */
  .letter :global(.w) {
    color: var(--faint);
    transition: color 0.5s var(--ease);
  }
  .letter :global(.w.on) {
    color: var(--fg);
  }
  .body :global(.w.on) {
    color: var(--fg-dim);
  }
  .first::first-letter {
    color: var(--fg);
  }
  .sign {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .sign :global(.sign-lion) {
    width: 46px;
    height: auto;
    color: var(--fg);
  }
  .sign-name {
    font-size: 2.2rem;
    line-height: 1;
  }
  .sign-title {
    font-size: 0.68rem;
    color: var(--muted);
    margin-top: 0.35rem;
  }

  /* ── Numbers ── */
  .nums {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .nums div {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-right: 1rem;
  }
  .nums div + div {
    border-left: 1px solid var(--rule);
    padding-left: clamp(0.75rem, 2.5vw, 1.75rem);
  }
  .nums dd {
    /* a smaller optical size keeps thousands commas from reading as periods */
    --opsz: 72;
    font-size: clamp(2.6rem, 5.5vw, 4.8rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .zero dd {
    font-size: clamp(3rem, 6.5vw, 5.6rem);
  }
  .hand-head {
    margin-top: 3.5rem;
  }
  .nums.hand {
    grid-template-columns: repeat(var(--cols), 1fr);
  }
  .hand-note {
    font-size: 0.62rem;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  /* Postscript: lighter, more personal */
  .ps {
    margin-top: 2rem;
    font-style: italic;
    font-size: clamp(1.2rem, 1.7vw, 1.4rem);
    line-height: 1.5;
    max-width: 34rem;
  }
  .ps :global(.w.on) {
    color: var(--fg-dim);
  }

  /* ── Beliefs ── */
  .beliefs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(2rem, 5vw, 4rem);
  }
  .beliefs li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.4rem 1rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--rule);
    transition-delay: var(--d);
  }
  .b-n {
    color: var(--muted);
    font-size: 0.72rem;
    padding-top: 0.6rem;
  }
  .b-t {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    text-transform: none;
  }
  .b-b {
    grid-column: 2;
    color: var(--fg-dim);
    font-size: 1.2rem;
    max-width: 40ch;
  }

  /* ── Story: an orbit line with a star at each milestone ── */
  .story {
    list-style: none;
    position: relative;
    margin-left: 0.5rem;
    padding-left: 2.5rem;
  }
  .story::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(180deg, var(--neb-indigo), var(--neb-violet) 50%, var(--neb-rose) 85%, transparent);
    opacity: 0.6;
  }
  .story li {
    position: relative;
    padding-bottom: 2.4rem;
  }
  .star {
    position: absolute;
    left: -2.5rem;
    top: 0.55rem;
    width: 9px;
    height: 9px;
    translate: -4px 0;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--fg-dim);
  }
  .story li.done .star {
    background: #fff;
    border-color: #fff;
    box-shadow: 0 0 6px 1px rgba(255, 255, 255, 0.7), 0 0 16px 4px rgba(160, 140, 246, 0.35);
  }
  .future .star {
    border-style: dashed;
    border-color: var(--neb-violet);
  }
  .st-link {
    display: grid;
    gap: 0.2rem;
    max-width: 44rem;
  }
  .st-date {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .st-label {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.1;
    transition: color 0.2s;
  }
  a.st-link:hover .st-label {
    color: var(--neb-violet);
  }
  .st-note {
    font-size: 1.15rem;
    color: var(--fg-dim);
  }
  .story li:not(.done):not(.future) .st-label {
    color: var(--fg-dim);
  }

  /* ── CTA ── */
  .cta {
    padding-block: 2rem clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--rule);
  }
  .cta-line {
    font-size: clamp(2.6rem, 7vw, 6rem);
    text-transform: none;
    letter-spacing: -0.02em;
    margin: 3rem 0 2rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .letter-grid {
      grid-template-columns: 1fr;
    }
    .letter-side {
      position: static;
    }
    .progress {
      display: none;
    }
    .nums {
      grid-template-columns: 1fr 1fr;
      row-gap: 2rem;
    }
    .nums div:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .beliefs {
      grid-template-columns: 1fr;
    }
  }
</style>
