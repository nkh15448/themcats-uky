---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { intro, groups, roles, everyone, palettes, pledge, makeItYours, briefHeads, also, done, sending } from '../data/hiring';
import teaching from '../assets/present/classes/04.jpg';
import whiteboard from '../assets/present/classes/05.jpg';
import nihal from '../assets/help/nihal-endocrine.jpg';
import anmol from '../assets/help/anmol-dna.jpg';
import lee from '../assets/help/lee-orgo.jpg';

// The small photo grid on the "what is The M-CATS" screen, in order. Names and alt text are in hiring.ts.
const p = intro.photos;
const pics = [{ img: nihal, ...p.nihal }, { img: anmol, ...p.anmol }, { img: lee, ...p.lee }, { img: whiteboard, ...p.whiteboard }];

// The opening animation's lion: the logo's own drawing, with every stroke given a length of 1 so
// the whole lion can draw itself on in one sweep.
import logoRaw from '../assets/logo.svg?raw';
const introMark = logoRaw
  .replace(/<\?xml[^>]*\?>/, '')
  .replace(/\s(id|data-name)="[^"]*"/g, '')
  .replace(/stroke:\s*#fff;/g, 'stroke: currentColor;')
  .replace(/<path /g, '<path pathLength="1" ')
  .replace('<svg ', '<svg class="intro-mark" aria-hidden="true" ');

// Set live to true to start taking applications. Until then the page shows a Preview tag, sends
// nothing and says so at the end. Applications go to the join-request function in Supabase
// (catalyst/supabase/functions/join-request), which saves them and posts each one in #applications.
// In dev, HELP_SEND=1 sends for real so the whole path can be tested before going live.
const live = true;
const preview = !live && !(import.meta.env.DEV && process.env.HELP_SEND === '1');
const endpoint = 'https://mkcpsnyskwbfaqccbbtt.supabase.co/functions/v1/join-request';
const data = { intro, groups, roles, everyone, palettes, pledge, makeItYours, briefHeads, also, done, sending, preview, endpoint };
---
<Base title="Join the team" description="Help run free MCAT prep at UK." bare>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="app" id="app">
    <div class="bar" aria-hidden="true"><span id="fill"></span></div>
    <header class="top">
      <button class="back mono" id="back" type="button" hidden>← Back</button>
      <span class="brand mono"><Logo class="mark" label="" /> The M-CATS</span>
      <span class="count mono" id="count"></span>
    </header>
    <div id="stage"></div>
    {data.preview && <p class="mono preview-tag">Preview</p>}
    <div class="intro" id="intro" aria-hidden="true">
      <div class="intro-field"><Fragment set:html={introMark} /></div>
      <div class="intro-ink"><Fragment set:html={introMark} /></div>
    </div>
    <!-- Left empty by people; bots that fill in every field get a quiet fake success. -->
    <input class="hp" id="hp" name="m-extra" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />


    <div class="sheet-wrap" id="sheet" hidden>
      <div class="scrim" id="scrim"></div>
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
        <div class="sheet-scroll" id="sheet-scroll">
          <figure class="hero-fig">
            <img class="sheet-hero" src={teaching.src} width={teaching.width} height={teaching.height} alt={p.hero.alt} />
            {p.hero.who && <figcaption class="mono tag" aria-hidden="true">{p.hero.who} · {p.hero.topic}</figcaption>}
          </figure>
          <div class="sheet-body">
            <h2 id="sheet-title">{intro.title}</h2>
            <p class="lead">{intro.lead}</p>
            <p class="need">{intro.need}</p>
            <p class="mono does-title">{intro.doesTitle}</p>
            <ul class="does">
              {intro.does.map((d) => <li><span class="mono">{d.title}</span><span>{d.body}</span></li>)}
            </ul>
            <div class="pics">
              {pics.map((x) => (
                <figure>
                  <img src={x.img.src} width={x.img.width} height={x.img.height} loading="lazy" alt={x.alt} />
                  {x.who && <figcaption class="mono tag" aria-hidden="true">{x.who} · {x.topic}</figcaption>}
                </figure>
              ))}
            </div>
            <p class="caption">{intro.caption}</p>
            <p class="mcat-note">{intro.mcatNote}</p>
          </div>
        </div>
        <div class="sheet-foot">
          <button class="cta" id="got-it" type="button">{intro.button} <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="hiring-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import type { Question, Role, Palette } from '../data/hiring';
  import { track } from '../lib/track';

  type Data = {
    intro: { question: string };
    groups: { question: string; open: string; mcat: string };
    roles: Role[];
    everyone: Question[];
    palettes: Palette[];
    pledge: { kicker: string; title: string; body: string; button: string };
    makeItYours: { title: string; body: string };
    briefHeads: { gets: string; expect: string };
    also: { q: string; help: string; mcatNote: string; mcatNoteOne: string };
    done: { title: string; next: string[] };
    sending: { button: string; failed: string; slow: string; check: string };
    preview: boolean;
    endpoint: string;
  };
  const data: Data = JSON.parse(document.getElementById('hiring-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const app = $('app');
  const stage = $('stage');
  const sheet = $('sheet');
  // Calm motion if the device asks for it, or if they picked Reduced in the main site's motion switch.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || (() => { try { return localStorage.getItem('mcats-motion') === 'reduced'; } catch { return false; } })();
  const EASE = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const answers: Record<string, string> = {};
  let role: Role | null = null;
  let palette: Palette = data.palettes[0];
  let at = 'know';
  let current: HTMLElement | null = null;
  let busy = false;

  // Multiple picks are stored together, separated by |.
  const picked = (id: string) => (answers[id] ?? '').split('|').filter(Boolean);

  function alsoQuestion(main: Role): Question {
    const others = data.roles.filter((r) => r.id !== main.id);
    const needMcat = others.filter((r) => r.group === 'mcat');
    return {
      id: 'also',
      type: 'multi',
      q: data.also.q,
      help: data.also.help,
      optional: true,
      options: others.map((r) => r.name),
      note: needMcat.length ? { from: needMcat[0].name, text: needMcat.length > 1 ? data.also.mcatNote : data.also.mcatNoteOne } : undefined,
    };
  }

  // The main role's questions, then "anything else", then whatever those extra picks need. No question is asked twice.
  function allQuestions(): Question[] {
    if (!role) return data.everyone;
    const extras = data.roles.filter((r) => picked('also').includes(r.name)).flatMap((r) => r.questions);
    const seen = new Set<string>();
    return [...(role.parts ? [role.parts] : []), ...data.everyone, ...role.questions, alsoQuestion(role), ...extras].filter((q) => !seen.has(q.id) && seen.add(q.id));
  }
  const questions = () => allQuestions().filter((q) => !q.showIf || picked(q.showIf.id).includes(q.showIf.is));
  const order = () => ['know', 'pledge', 'roles', ...(role ? ['brief', ...questions().map((q) => q.id), 'done'] : [])];
  const question = (id: string) => allQuestions().find((q) => q.id === id);

  function setRole(next: Role) {
    if (role?.id !== next.id) delete answers.also;
    role = next;
    const c = palette.roles[next.id];
    app.style.setProperty('--accent', c.bg);
    app.style.setProperty('--accent-ink', c.ink);
    app.style.setProperty('--tint', c.tint);
  }

  function applyPalette(p: Palette) {
    palette = p;
    const root = document.documentElement.style;
    root.setProperty('--paper', p.paper);
    root.setProperty('--ink', p.ink);
    root.setProperty('--dim', p.dim);
    root.setProperty('--primary', p.primary);
    root.setProperty('--primary-ink', p.primaryInk);
    root.setProperty('--primary-tint', p.primaryTint);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', p.paper);
    if (role) setRole(role);
  }

  // ── Screens ─────────────────────────────────────────────
  function make(cls: string, html: string) {
    const el = document.createElement('section');
    el.className = `screen ${cls}`;
    el.innerHTML = `<div class="inner">${html}</div>`;
    return el;
  }

  function knowScreen() {
    const el = make('', `
      <h1 tabindex="-1">${esc(data.intro.question)}</h1>
      <div class="pair">
        <button class="cta" data-know="yes" type="button">Yes</button>
        <button class="cta ghost" data-know="no" type="button">No</button>
      </div>`);
    el.querySelector('[data-know=yes]')!.addEventListener('click', (e) => go('pledge', tapPoint(e as MouseEvent)));
    el.querySelector('[data-know=no]')!.addEventListener('click', openSheet);
    return el;
  }

  function pledgeScreen() {
    const p = data.pledge;
    const el = make('primary tall', `
      <p class="mono kicker">${esc(p.kicker)}</p>
      <h1 tabindex="-1">${esc(p.title)}</h1>
      <p class="about">${esc(p.body)}</p>
      <button class="cta" data-next type="button">${esc(p.button)} <span aria-hidden="true">→</span></button>`);
    el.querySelector('[data-next]')!.addEventListener('click', next);
    return el;
  }

  function rolesScreen() {
    const row = (r: Role) => {
      const c = palette.roles[r.id];
      return `<li><button class="role" type="button" data-role="${r.id}" style="--r:${c.bg};--ri:${c.ink}">
        <span class="role-top"><span class="role-name">${esc(r.name)}</span><span class="arrow" aria-hidden="true">→</span></span>
        <span class="role-line">${esc(r.line)}</span>
      </button></li>`;
    };
    const group = (label: string, list: Role[]) => `<h2 class="mono group">${esc(label)}</h2><ul class="roles">${list.map(row).join('')}</ul>`;
    const el = make('tall', `
      <h1 tabindex="-1">${esc(data.groups.question)}</h1>
      ${group(data.groups.open, data.roles.filter((r) => r.group === 'open'))}
      ${group(data.groups.mcat, data.roles.filter((r) => r.group === 'mcat'))}`);
    el.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((b) =>
      b.addEventListener('click', (e) => {
        setRole(data.roles.find((r) => r.id === b.dataset.role)!);
        go('brief', tapPoint(e));
      }),
    );
    return el;
  }

  function tapPoint(e: MouseEvent) {
    return { x: e.clientX || innerWidth / 2, y: e.clientY || innerHeight / 2 };
  }

  function briefScreen() {
    const r = role!;
    const list = (items: string[]) => `<ul class="expect">${items.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>`;
    const el = make('color tall', `
      <p class="mono kicker">${esc(r.name)}</p>
      <h1 tabindex="-1">${esc(r.hook)}</h1>
      <p class="about">${esc(r.about)}</p>
      ${r.warning ? `<p class="warning">${esc(r.warning)}</p>` : ''}
      <h2 class="mono group">${esc(data.briefHeads.gets)}</h2>
      ${list(r.gets)}
      <h2 class="mono group">${esc(data.makeItYours.title)}</h2>
      <p class="yours">${esc(data.makeItYours.body)} ${esc(r.yours)}</p>
      <h2 class="mono group">${esc(data.briefHeads.expect)}</h2>
      ${list(r.expect)}
      <button class="cta" data-next type="button">I’m interested <span aria-hidden="true">→</span></button>`);
    el.querySelector('[data-next]')!.addEventListener('click', next);
    return el;
  }

  function validate(q: Question, v: string) {
    if (!v) return q.optional ? '' : 'We’ll need this one.';
    if (q.type === 'tel' && v.replace(/\D/g, '').length < 10) return 'That phone number looks too short.';
    if (q.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return 'That email doesn’t look right.';
    if (q.type === 'url' && !/\S+\.\S+/.test(v)) return 'That link doesn’t look right.';
    return '';
  }

  function questionScreen(q: Question) {
    const help = q.help ? `<p class="help">${esc(q.help)}</p>` : '';
    const isLast = () => { const l = order(); return l[l.indexOf(q.id) + 1] === 'done'; };
    const ctaLabel = (filled: boolean) => (filled || !q.optional ? (isLast() ? 'Send' : 'Continue') : isLast() ? 'Skip and send' : 'Skip');
    if (q.type === 'multi') {
      const el = make('tall', `
        <form novalidate>
          <h1 tabindex="-1">${esc(q.q)}</h1>${help}
          ${q.optional ? '<p class="mono optional">Optional</p>' : ''}
          <div class="choices">${q.options!.map((o) => `${q.note?.from === o ? `<p class="mono choice-note">${esc(q.note.text)}</p>` : ''}<button class="choice multi${picked(q.id).includes(o) ? ' on' : ''}" type="button" aria-pressed="${picked(q.id).includes(o)}" data-v="${esc(o)}">${esc(o)}</button>`).join('')}</div>
          <p class="error mono" role="alert" hidden></p>
          <button class="cta" type="submit"><span class="cta-text"></span> <span aria-hidden="true">→</span></button>
        </form>`);
      const text = el.querySelector('.cta-text')!;
      const err = el.querySelector('.error') as HTMLElement;
      text.textContent = ctaLabel(picked(q.id).length > 0);
      el.querySelectorAll<HTMLButtonElement>('.choice').forEach((b) =>
        b.addEventListener('click', () => {
          const on = b.classList.toggle('on');
          b.setAttribute('aria-pressed', String(on));
          answers[q.id] = [...el.querySelectorAll<HTMLElement>('.choice.on')].map((x) => x.dataset.v!).join('|');
          save();
          err.hidden = true;
          text.textContent = ctaLabel(picked(q.id).length > 0);
          chrome();
        }),
      );
      el.querySelector('form')!.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!q.optional && !picked(q.id).length) { err.textContent = 'Pick at least one.'; err.hidden = false; return; }
        next();
      });
      return el;
    }
    if (q.type === 'choice') {
      const el = make('', `
        <h1 tabindex="-1">${esc(q.q)}</h1>${help}
        <div class="choices">${q.options!.map((o) => `<button class="choice${answers[q.id] === o ? ' on' : ''}" type="button" data-v="${esc(o)}">${esc(o)}</button>`).join('')}</div>
        <p class="error mono" role="alert" hidden></p>`);
      el.querySelectorAll<HTMLButtonElement>('.choice').forEach((b) =>
        b.addEventListener('click', () => {
          answers[q.id] = b.dataset.v!;
          el.querySelectorAll('.choice').forEach((x) => x.classList.toggle('on', x === b));
          window.setTimeout(next, reduce ? 0 : 170);
        }),
      );
      return el;
    }
    const value = esc(answers[q.id] ?? '');
    const attrs = `id="field" autocomplete="${q.type === 'tel' ? 'tel' : q.type === 'email' ? 'email' : q.id === 'name' ? 'name' : 'off'}" placeholder="${esc(q.placeholder ?? '')}" aria-label="${esc(q.q)}"`;
    const control = q.type === 'long'
      ? `<textarea rows="3" maxlength="800" ${attrs}>${value}</textarea>`
      : `<input type="${q.type === 'tel' ? 'tel' : q.type === 'email' ? 'email' : 'text'}" ${q.type === 'url' ? 'inputmode="url" autocapitalize="off" autocorrect="off"' : ''} maxlength="200" value="${value}" ${attrs} />`;
    const label = () => ctaLabel(!!field.value.trim());
    const el = make('', `
      <form novalidate>
        <h1 tabindex="-1">${esc(q.q)}</h1>${help}
        ${q.optional ? '<p class="mono optional">Optional</p>' : ''}
        ${control}
        <p class="error mono" role="alert" hidden></p>
        <button class="cta" type="submit"><span class="cta-text"></span> <span aria-hidden="true">→</span></button>
      </form>`);
    const field = el.querySelector('#field') as HTMLInputElement;
    const text = el.querySelector('.cta-text')!;
    const err = el.querySelector('.error') as HTMLElement;
    text.textContent = label();
    // Kept as they type, so a reload mid-answer doesn't lose it. Moving on still needs a valid answer.
    field.addEventListener('input', () => { answers[q.id] = field.value; save(); text.textContent = label(); err.hidden = true; });
    el.querySelector('form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = field.value.trim();
      const problem = validate(q, v);
      if (problem) { err.textContent = problem; err.hidden = false; field.focus(); return; }
      answers[q.id] = v;
      next();
    });
    return el;
  }

  function doneScreen() {
    const first = (answers.name ?? '').split(/\s+/)[0];
    const byText = answers.preferred === 'Text';
    const el = make('color tall', `
      <p class="mono kicker">${esc(role!.name)}</p>
      <h1 tabindex="-1">${esc(data.done.title)}, ${esc(first)}.</h1>
      <p class="about">We’ll ${byText ? 'text' : 'email'} you at ${esc(byText ? answers.phone : answers.email)}.</p>
      <ol class="steps">${data.done.next.map((s, i) => `<li><span class="mono">0${i + 1}</span><span>${esc(s)}</span></li>`).join('')}</ol>
      ${data.preview ? '<p class="mono mock">This is a preview, so nothing was sent.</p>' : ''}`);
    return el;
  }

  function build(id: string) {
    if (id === 'know') return knowScreen();
    if (id === 'pledge') return pledgeScreen();
    if (id === 'roles') return rolesScreen();
    if (id === 'brief') return briefScreen();
    if (id === 'done') return doneScreen();
    return questionScreen(question(id)!);
  }

  // ── Moving between screens ──────────────────────────────
  function chrome() {
    const list = order();
    const qs = questions().map((q) => q.id);
    const n = qs.indexOf(at);
    $('count').textContent = n >= 0 ? `${n + 1} / ${qs.length}` : '';
    $('back').hidden = at === 'know' || at === 'done';
    const share = role ? list.indexOf(at) / (list.length - 1) : 0;
    $('fill').style.transform = `scaleX(${share})`;
  }

  function settle(el: HTMLElement) {
    busy = false;
    const target = el.querySelector<HTMLElement>('#field') ?? el.querySelector<HTMLElement>('h1');
    target?.focus({ preventScroll: true });
    if (queued) { const id = queued; queued = null; go(id, undefined, 'none'); }
  }

  // ── History and saving ──────────────────────────────────
  // Each screen is its own step in the browser's history, so a phone's back swipe (or the browser's
  // back button) goes back one screen like ← Back does, instead of leaving the form. Answers are kept
  // for this tab only (sessionStorage), so a reload, or a phone reopening the tab after switching
  // apps, picks up where they left off. They're cleared once the application is sent, and the
  // browser drops them when the tab closes.
  type Step = { help?: string; n?: number; sheet?: boolean };
  type Saved = { role: string | null; answers: Record<string, string>; at: string; counted: string[] };
  const KEY = 'mcats-help';
  let depth = 0; // how many steps into the form this history entry is
  let queued: string | null = null; // a back or forward that came in mid-animation
  function save() {
    try {
      if (at === 'done') sessionStorage.removeItem(KEY);
      else sessionStorage.setItem(KEY, JSON.stringify({ role: role?.id ?? null, answers, at, counted: [...counted] } satisfies Saved));
    } catch {
      // private browsing or storage turned off: the form still works, it just won't survive a reload
    }
  }
  function restore(): Saved | null {
    try { return JSON.parse(sessionStorage.getItem(KEY) ?? 'null'); } catch { return null; }
  }

  // how: 'push' adds a history step (moving forward), 'replace' swaps the current one, and 'none' is
  // for when the browser already moved (a back or forward swipe).
  function go(id: string, from?: { x: number; y: number }, how: 'push' | 'replace' | 'none' = 'push') {
    if (busy) { if (how === 'none') queued = id; return; }
    busy = true;
    at = id;
    if (how === 'push') { depth += 1; history.pushState({ help: id, n: depth } satisfies Step, ''); }
    else if (how === 'replace') history.replaceState({ help: id, n: depth } satisfies Step, '');
    save();
    if (id === 'brief') count('started');
    const el = build(id);
    const old = current;
    current = el;
    chrome();
    stage.append(el);
    el.scrollTop = 0;
    if (reduce || !old) {
      old?.remove();
      settle(el);
      return;
    }
    if (from) {
      const r = Math.hypot(Math.max(from.x, innerWidth - from.x), Math.max(from.y, innerHeight - from.y));
      el.animate(
        [{ clipPath: `circle(0px at ${from.x}px ${from.y}px)` }, { clipPath: `circle(${r}px at ${from.x}px ${from.y}px)` }],
        { duration: 620, easing: EASE },
      ).finished.then(() => { old.remove(); settle(el); });
      return;
    }
    old.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-14px)' }], { duration: 200, easing: 'ease-in', fill: 'forwards' });
    el.animate([{ opacity: 0, transform: 'translateY(18px)' }, { opacity: 1, transform: 'none' }], { duration: 440, delay: 110, easing: EASE, fill: 'backwards' })
      .finished.then(() => { old.remove(); settle(el); });
  }

  // ── Where they came from ────────────────────────────────
  // Each flyer or link gets its own label: themcats.org/help?from=library-poster. GoatCounter counts
  // three steps per label as events, "help opened: library-poster" when the page loads, "help started"
  // when they pick a role and "help sent" when the application goes through, so we can see which
  // places bring people in and where they drop off. A visit with no label counts as "no label".
  // The same label goes along with the application, so its #applications post says where it came
  // from. Nothing is counted while the page is a preview.
  const source = (new URLSearchParams(location.search).get('from') ?? '').toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 40);
  const counted = new Set<string>();
  function count(step: 'opened' | 'started' | 'sent') {
    if (data.preview || counted.has(step)) return;
    counted.add(step);
    track(`help ${step}: ${source || 'no label'}`);
  }

  // ── Sending ─────────────────────────────────────────────
  // Only answers to questions still on the path count, so an answer to a question that was later
  // skipped (like a social link after unpicking Social media) isn't sent.
  function application() {
    const asked = new Set(questions().map((q) => q.id));
    const get = (id: string) => (asked.has(id) ? answers[id] ?? '' : '');
    return {
      website: ($('hp') as HTMLInputElement).value,
      role: { id: role!.id, name: role!.name },
      parts: role!.parts && asked.has(role!.parts.id) ? picked(role!.parts.id) : [],
      also: data.roles.filter((r) => asked.has('also') && picked('also').includes(r.name)).map((r) => ({ id: r.id, name: r.name })),
      name: get('name'), phone: get('phone'), email: get('email'), preferred: get('preferred'),
      year: get('year'), major: get('major'), experience: get('experience'),
      portfolio: get('portfolio'), social: get('social-link'), taken: get('taken'), score: get('score'),
      source,
    };
  }

  const fieldNames: Record<string, string> = { name: 'name', phone: 'phone number', email: 'email' };
  let sendingNow = false;
  async function send(screen: HTMLElement) {
    const err = screen.querySelector('.error') as HTMLElement | null;
    const label = screen.querySelector('.cta-text');
    const was = label?.textContent;
    const buttons = [...screen.querySelectorAll<HTMLButtonElement>('button')];
    sendingNow = true;
    buttons.forEach((b) => (b.disabled = true));
    if (label) label.textContent = data.sending.button;
    if (err) err.hidden = true;
    const stop = new AbortController();
    const timer = window.setTimeout(() => stop.abort(), 20000);
    let problem = data.sending.failed;
    try {
      const res = await fetch(data.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(application()), signal: stop.signal });
      if (res.ok) { count('sent'); return true; }
      const body = await res.json().catch(() => ({}));
      if (res.status === 429) problem = data.sending.slow;
      else if (body.field && fieldNames[body.field]) problem = data.sending.check.replace('{field}', fieldNames[body.field]);
    } catch {
      // offline or timed out: the default message fits
    } finally {
      window.clearTimeout(timer);
      sendingNow = false;
    }
    buttons.forEach((b) => (b.disabled = false));
    if (label && was) label.textContent = was;
    if (err) { err.textContent = problem; err.hidden = false; }
    return false;
  }

  async function next() {
    if (sendingNow) return;
    const list = order();
    const to = list[list.indexOf(at) + 1];
    if (to === 'done' && !data.preview && current && !(await send(current))) return;
    go(to);
  }

  // ← Back steps back through the browser's history, so it and the phone's back swipe always agree.
  $('back').addEventListener('click', () => {
    if (sendingNow) return;
    if (((history.state as Step | null)?.n ?? 0) > 0) history.back();
    else { const list = order(); go(list[list.indexOf(at) - 1], undefined, 'replace'); }
  });

  window.addEventListener('popstate', (e) => {
    const s = e.state as Step | null;
    // After sending, going back shouldn't land on the last question, where they could send it again.
    // The first back jumps to the start of the form's history (Thanks stays up), the next one leaves.
    if (at === 'done') { if (s?.n) history.go(-s.n); return; }
    if (!sheet.hidden && !s?.sheet) closeSheet(false);
    if (s?.sheet && sheet.hidden) openSheet(false);
    if (sendingNow || !s?.help) return;
    depth = s.n ?? 0;
    const target = order().includes(s.help) ? s.help : 'know';
    if (target !== at) go(target, undefined, 'none');
  });

  // ── The "what is this" sheet ────────────────────────────
  // Opening it is a history step too, so a back swipe closes it instead of leaving the page.
  const panel = sheet.querySelector('.sheet') as HTMLElement;
  const scrim = $('scrim');
  function openSheet(push = true) {
    if (push) { depth += 1; history.pushState({ help: 'know', n: depth, sheet: true } satisfies Step, ''); }
    sheet.hidden = false;
    $('sheet-scroll').scrollTop = 0;
    $('got-it').focus({ preventScroll: true });
    if (reduce) return;
    panel.animate([{ transform: 'translateY(100%)' }, { transform: 'none' }], { duration: 560, easing: EASE });
    scrim.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300 });
  }
  async function closeSheet(thenRoles: boolean) {
    if (!reduce) {
      await Promise.all([
        panel.animate([{ transform: 'none' }, { transform: 'translateY(100%)' }], { duration: 340, easing: 'ease-in', fill: 'forwards' }).finished,
        scrim.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 340, fill: 'forwards' }).finished,
      ]);
      panel.getAnimations().forEach((a) => a.cancel());
      scrim.getAnimations().forEach((a) => a.cancel());
    }
    sheet.hidden = true;
    // "Got it" takes the sheet's place in history, so back from the next screen returns to the question.
    if (thenRoles) go('pledge', { x: innerWidth / 2, y: innerHeight * 0.85 }, 'replace');
  }
  // Tapping outside it or pressing Escape steps back in history, and popstate closes it.
  const dismissSheet = () => ((history.state as Step | null)?.sheet ? history.back() : closeSheet(false));
  $('got-it').addEventListener('click', () => closeSheet(true));
  scrim.addEventListener('click', dismissSheet);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) dismissSheet(); });

  // ── Opening ─────────────────────────────────────────────
  // The lion draws itself on the purple field, then the field lifts like a curtain while the lion
  // flies into its spot in the header and the first question rises into place underneath. About a
  // second long; a tap or key skips to the end, and it doesn't play with reduced motion.
  function opening(instant = false) {
    const intro = $('intro');
    const field = intro.querySelector('.intro-field') as HTMLElement;
    const ink = intro.querySelector('.intro-ink') as HTMLElement;
    const mark = field.querySelector('.intro-mark') as SVGSVGElement;
    const inkMark = ink.querySelector('.intro-mark') as SVGSVGElement;
    const target = document.querySelector('.brand .mark') as SVGSVGElement;
    const finish = () => { intro.remove(); target.style.opacity = ''; };
    if (reduce || instant) { finish(); return; }
    intro.style.animation = 'none'; // the script is running, so the safety timeout isn't needed
    target.style.opacity = '0';

    // Where the lion starts and where it lands, measured before anything moves.
    const from = mark.getBoundingClientRect();
    const to = target.getBoundingClientRect();
    const dx = to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = to.top + to.height / 2 - (from.top + from.height / 2);

    const LIFT = 'cubic-bezier(0.76, 0, 0.24, 1)';
    const start = 440, lift = 680;
    const anims: Animation[] = [];
    mark.querySelectorAll('path').forEach((path) =>
      anims.push(path.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 560, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'forwards' })),
    );
    anims.push(mark.animate([{ opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }], { duration: 420, easing: EASE, fill: 'backwards' }));
    const timing = { duration: lift, delay: start, easing: LIFT, fill: 'forwards' } as const;
    for (const m of [mark, inkMark]) anims.push(m.animate([{ translate: '0 0', scale: 1 }, { translate: `${dx}px ${dy}px`, scale: to.width / from.width }], timing));
    const curtain = field.animate([{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(0 0 100% 0)' }], timing);
    anims.push(curtain, ink.animate([{ clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0 0 0 0)' }], timing));
    const inner = current?.querySelector('.inner');
    if (inner) anims.push(inner.animate([{ transform: 'translateY(48px)' }, { transform: 'none' }], { duration: lift + 160, delay: start, easing: EASE, fill: 'backwards' }));

    curtain.finished.then(finish, finish);
    const skip = () => anims.forEach((a) => a.finish());
    intro.addEventListener('pointerdown', skip, { once: true });
    document.addEventListener('keydown', skip, { once: true });
  }

  // ── Starting up ─────────────────────────────────────────
  // Pick up a saved application in this tab if there is one; otherwise start fresh, on one role if
  // the flyer's link names it (/help?role=video).
  const saved = restore();
  if (saved) {
    const r = data.roles.find((x) => x.id === saved.role);
    if (r) setRole(r);
    Object.assign(answers, saved.answers ?? {});
    (saved.counted ?? []).forEach((c) => counted.add(c));
  } else {
    const preset = data.roles.find((r) => r.id === new URLSearchParams(location.search).get('role'));
    if (preset) setRole(preset);
  }
  const here = history.state as Step | null;
  depth = here?.n ?? 0;
  let start = 'know';
  if (saved && here?.help && here.help !== 'done' && order().includes(here.help)) start = here.help;
  else if (saved && saved.at !== 'done' && order().includes(saved.at)) start = saved.at;

  applyPalette(data.palettes[0]);
  go(start, undefined, 'replace');
  opening(start !== 'know'); // someone picking up mid-form doesn't need the opening again

  // The counter script loads in the background, so wait for it before counting the visit. A reload
  // of a saved application doesn't count twice.
  if (document.readyState === 'complete') count('opened');
  else window.addEventListener('load', () => count('opened'), { once: true });
</script>

