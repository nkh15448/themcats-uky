---
// Masonry collage of club photos with captions, plus a lightbox.
// Photos come from src/assets/gallery/; captions from src/data/gallery.ts.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { gallery } from '../data/gallery';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}', { eager: true });
const byName = new Map(Object.entries(files).map(([path, mod]) => [path.split('/').at(-1)!, mod.default]));

// Listed photos first, in list order; then any unlisted ones by filename.
const listed = gallery.filter((g) => byName.has(g.file));
const unlisted = [...byName.keys()]
  .filter((name) => !gallery.some((g) => g.file === name))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((file) => ({ file }));

const photos = await Promise.all(
  [...listed, ...unlisted].map(async (g, i) => {
    const src = byName.get(g.file)!;
    const large = await getImage({ src, width: 1800, format: 'webp' });
    const date = g.date
      ? new Date(`${g.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
      : undefined;
    // a small, repeatable tilt so the collage feels laid out by hand
    const tilt = [-1.1, 0.7, -0.4, 1.0, -0.8, 0.3][i % 6];
    return { ...g, src, large: large.src, date, tilt };
  }),
);

interface Props {
  title?: string;
}
const { title = 'Moments' } = Astro.props;
---
{photos.length > 0 && (
  <section class="wrap gallery-section">
    <div class="section-head">
      <p class="label">{title}</p>
      <p class="label">{photos.length} photo{photos.length === 1 ? '' : 's'}</p>
    </div>

    <ul class="collage">
      {photos.map((p, i) => (
        <li class="shot" style={`--tilt:${p.tilt}deg`} data-reveal>
          <button class="frame" data-open={i} aria-label={`Open photo${p.caption ? `: ${p.caption}` : ''}`}>
            <Image src={p.src} alt={p.caption ?? ''} widths={[400, 700, 1000]} sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 380px" loading="lazy" />
          </button>
          {(p.caption || p.date) && (
            <p class="cap">
              {p.caption && <span class="italic">{p.caption}</span>}
              {p.date && <span class="mono when">{p.date}</span>}
            </p>
          )}
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label="Photo viewer">
      <button class="lb-close mono" data-close aria-label="Close">esc ✕</button>
      <button class="lb-nav prev mono" data-step="-1" aria-label="Previous photo">←</button>
      <figure>
        <img alt="" data-lb-img />
        <figcaption>
          <span class="italic" data-lb-cap></span>
          <span class="mono when" data-lb-meta></span>
        </figcaption>
      </figure>
      <button class="lb-nav next mono" data-step="1" aria-label="Next photo">→</button>
    </dialog>
    <script type="application/json" data-gallery set:html={JSON.stringify(photos.map((p) => ({ src: p.large, caption: p.caption ?? '', date: p.date ?? '' })))} />
  </section>
)}

<script>
  const data = document.querySelector<HTMLScriptElement>('[data-gallery]');
  if (data) {
    const items: { src: string; caption: string; date: string }[] = JSON.parse(data.textContent!);
    const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const meta = dlg.querySelector<HTMLElement>('[data-lb-meta]')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + items.length) % items.length;
      const it = items[at];
      img.src = it.src;
      img.alt = it.caption;
      cap.textContent = it.caption;
      meta.textContent = [it.date, items.length > 1 ? `${at + 1} / ${items.length}` : ''].filter(Boolean).join(' · ');
    };
    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset.open));
        dlg.showModal();
      }),
    );
    dlg.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.step))));
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
    if (items.length < 2) dlg.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => (b.hidden = true));
  }
</script>

<style>
  .gallery-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  /* Masonry via columns: every photo keeps its own shape. */
  .collage {
    list-style: none;
    columns: 3 280px;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .shot {
    break-inside: avoid;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    padding: 0.4rem;
  }
  .frame {
    display: block;
    width: 100%;
    padding: 7px;
    background: #171716;
    border: 1px solid var(--rule-strong);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.9);
    cursor: zoom-in;
    transform: rotate(var(--tilt)); /* only the print tilts; captions stay level */
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .frame :global(img) {
    width: 100%;
    height: auto;
    filter: saturate(0.55) contrast(1.04) brightness(0.92);
    transition: filter 0.7s var(--ease);
  }
  .shot:hover .frame,
  .frame:focus-visible {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      -2px 0 0 rgba(255, 30, 70, 0.4),
      2px 0 0 rgba(30, 140, 255, 0.4),
      0 26px 50px -20px rgba(0, 0, 0, 0.95);
  }
  .shot:hover .frame :global(img),
  .frame:focus-visible :global(img) {
    filter: none;
  }
  .cap {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.8rem;
    padding-inline: 0.2rem;
  }
  .cap .italic {
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--fg-dim);
  }
  .when {
    font-size: 0.62rem;
    color: var(--muted);
  }

  /* Lightbox */
  .lightbox {
    margin: auto;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--fg);
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: 4rem 1fr 4rem;
    align-items: center;
    animation: lb-in 0.35s var(--ease);
  }
  .lightbox::backdrop {
    background: rgba(8, 8, 8, 0.9);
    backdrop-filter: blur(8px);
  }
  @keyframes lb-in {
    from { opacity: 0; }
  }
  .lightbox figure {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: 3rem;
    max-height: 100vh;
  }
  .lightbox img {
    max-width: min(100%, 1400px);
    max-height: calc(100vh - 10rem);
    object-fit: contain;
    border: 1px solid var(--rule-strong);
  }
  .lightbox figcaption {
    display: grid;
    gap: 0.3rem;
    text-align: center;
  }
  .lightbox figcaption .italic {
    font-size: 1.4rem;
  }
  .lb-nav {
    height: 3rem;
    font-size: 1.1rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  .lb-nav:hover,
  .lb-close:hover {
    color: var(--fg);
  }
  .lb-close {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .lightbox[open] {
      grid-template-columns: 2.5rem 1fr 2.5rem;
    }
  }
</style>
