---
import { url, stripBase } from '../lib/url';
import Logo from './Logo.astro';
import { links as ext } from '../data/join';
const path = stripBase(Astro.url.pathname);
const links = [
  { href: '/resources/', label: 'Resources' },
  { href: '/meetings/', label: 'Meetings' },
  { href: '/scholarship/', label: 'Scholarship' },
  { href: '/team/', label: 'Team' },
  { href: '/about/', label: 'About' },
];
const menuLinks = [{ href: '/', label: 'Home' }, ...links, { href: '/join/', label: 'Join' }];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href={url('/')} class="brand" aria-label="The M-CATS home">
      <Logo class="brand-mark" />
      <span class="brand-word">The M-CATS</span>
    </a>
    <nav class="desktop-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-actions">
      <button class="search-trigger" data-open-palette aria-label="Search everything">
        <svg class="search-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>
        <span class="st-text">Search</span><kbd>⌘K</kbd>
      </button>
      <a class="btn btn-solid join" href={url('/join/')}>Join</a>
      <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Phone menu: a full-screen sheet with the pages set large. -->
<div class="menu" id="menu" hidden>
  <nav aria-label="Main">
    <ol class="menu-list">
      {menuLinks.map((l, i) => (
        <li style={`--i:${i}`}>
          <a href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            <span class="mono m-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="m-label display">{l.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="menu-foot" style={`--i:${menuLinks.length}`}>
    <button class="btn" data-open-palette data-close-menu>Search everything</button>
    <a class="btn" href={ext.tutoring} target="_blank" rel="noopener">Book tutoring ↗</a>
    <a class="btn" href={ext.groupme} target="_blank" rel="noopener">GroupMe ↗</a>
  </div>
</div>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu')!;
  const root = document.documentElement;

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    root.classList.toggle('menu-open', open);
    if (open) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('in'));
      menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    } else {
      menu.classList.remove('in');
      setTimeout(() => { if (!menu.classList.contains('in')) menu.hidden = true; }, 350);
    }
  }
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a, [data-close-menu]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.classList.contains('menu-open')) {
      setOpen(false);
      btn.focus();
    }
  });
  // If the window grows past phone size while the menu is open, close it.
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 95;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand :global(.brand-mark) {
    width: 26px;
    height: auto;
    color: var(--fg);
  }
  .brand :global(.brand-mark path) {
    stroke-width: 0.9px;
  }
  .brand-word {
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: 'opsz' 40;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    word-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .desktop-nav {
    margin-left: auto;
  }
  .desktop-nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
  .desktop-nav a {
    font-family: var(--mono);
    font-weight: 300;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s;
    position: relative;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current] {
    color: var(--fg);
  }
  .desktop-nav a[aria-current]::before {
    content: '';
    position: absolute;
    left: -0.9em;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--neb-violet);
    box-shadow: 0 0 6px var(--neb-violet);
    transform: translateY(-50%);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem 0.5rem 0.9rem;
    border: 1px solid var(--rule);
    font-family: var(--mono);
    font-weight: 300;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: border-color 0.2s, color 0.2s;
  }
  .search-trigger:hover {
    border-color: var(--rule-strong);
    color: var(--fg);
  }
  .search-icon {
    display: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }
  .join {
    padding: 0.6rem 1.1rem;
  }

  /* ── menu button: two lines that cross into an X ── */
  .menu-btn {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }
  .menu-btn span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1px;
    background: var(--fg);
    transition: transform 0.45s var(--ease), top 0.45s var(--ease);
  }
  .menu-btn span:first-child { top: 18px; }
  .menu-btn span:last-child { top: 25px; }
  .menu-btn[aria-expanded='true'] span:first-child { top: 22px; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:last-child { top: 22px; transform: rotate(-45deg); }

  /* ── the sheet ── */
  .menu {
    position: fixed;
    inset: 64px 0 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
    background:
      radial-gradient(ellipse 80% 50% at 90% 0%, rgba(111, 134, 242, 0.14), transparent 70%),
      radial-gradient(ellipse 70% 40% at 0% 100%, rgba(229, 143, 196, 0.08), transparent 70%),
      var(--bg);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu.in {
    opacity: 1;
  }
  .menu-list {
    list-style: none;
  }
  .menu-list li,
  .menu-foot {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }
  .menu.in .menu-list li,
  .menu.in .menu-foot {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .menu-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .m-n {
    font-size: 0.66rem;
    color: var(--muted);
    width: 1.6rem;
  }
  .m-label {
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    text-transform: none;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--fg-dim);
  }
  .menu-list a[aria-current] .m-label {
    color: var(--fg);
  }
  .menu-list a[aria-current] .m-n {
    color: var(--neb-violet);
  }
  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 2rem;
  }
  .menu-foot .btn {
    flex: 1 1 auto;
    justify-content: center;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .desktop-nav,
    .join,
    .search-trigger kbd,
    .st-text {
      display: none;
    }
    .nav-actions {
      margin-left: auto;
      gap: 0.25rem;
    }
    .search-trigger {
      border: 0;
      padding: 0;
      width: 44px;
      height: 44px;
      justify-content: center;
    }
    .search-icon {
      display: block;
    }
    .menu-btn {
      display: block;
    }
  }
  @media (min-width: 901px) {
    .menu {
      display: none !important;
    }
  }
</style>
