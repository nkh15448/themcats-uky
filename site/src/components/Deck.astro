    background: linear-gradient(90deg, var(--o-b), #f4efe7 50%, var(--o-r));
    opacity: 0.55;
  }
  /* Still on purpose: moving grain flickers on a projector and tires the eyes.
     The same tile twice, at sizes that don't divide, so the grain never repeats. */
  .o-grain {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-image: url('../assets/present/orbit/grain.webp'), url('../assets/present/orbit/grain.webp');
    background-size: 192px, 263px;
    background-position: 0 0, 97px 41px;
