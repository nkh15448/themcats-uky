    color: var(--fg-dim);
  }
  .cls-where {
    position: absolute;
    left: 154px;
    top: 900px;
    font-size: 20px;
    color: var(--rose);
  }
  .cls-fan {
    position: absolute;
    left: 880px;
    top: 250px;
    list-style: none;
  }
  .cls-fan li {
    position: absolute;
    left: calc(var(--k) * 100px);
