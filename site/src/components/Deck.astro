    /* undo the track's squash and tilt, then centre (rightmost applies first) */
    transform: scaleY(calc(1 / var(--k))) rotate(calc(var(--tilt, 0deg) * -1)) translate(-50%, -50%);
    animation: o-nearfar var(--dur, 24s) linear infinite;
  }

  /* The wordmark: THE MCAT in the print's wide caps, under the orbits. */
  .deck[data-theme='orbit'] .mark {
