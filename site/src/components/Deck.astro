---
// ─────────────────────────────────────────────────────────────
//  The club-visit talk, as a full-screen slideshow. Three looks share it:
//    /present       theme="classic"  soft glows, the wildcat on the title
//    /presentSpace  theme="space"    nebula, orbits and a planet horizon,
//                                     after the merch mockups (unlisted)
//    /presentOrbit  theme="orbit"    the multi-orbit back print: fringed
//                                     rings, a flaring star, painted nebula,
//                                     still film grain (unlisted)
//  Content lives here once, so an update shows in all three.
//
//  Keys:  → / Space / PageDown = next   ← / PageUp = back
//         F = fullscreen   B = blank screen   Home / End = first / last
//  Mouse: click / scroll down / forward button = next
//         right-click / scroll up / back button = back
//
//  Each <section class="slide"> is one slide on a fixed 1920×1080 stage,
//  scaled to fit the screen. Inside a slide, anything with data-step="n"
//  appears on the nth click. The wordmark, wildcat and glows live outside
//  the slides and glide to a new spot on each slide (like PowerPoint Morph).
//  A slide picks their spot with data-mark / data-cat (and, in space and orbit,
//  data-neb / data-sys / data-sun / data-hz), e.g. data-cat="gone 1:hero" =
//  hidden at first, the big hero from click 1 on. Spots are styled under
//  "Persistent layer", "Space" and "Orbit"; the classic glows move per slide.
// ─────────────────────────────────────────────────────────────
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import QRCode from 'qrcode';
import Logo from './Logo.astro';
import { leadership } from '../data/team';
import { links } from '../data/join';
import { scholarship } from '../data/scholarship';
// The MCatalyst slide wears the app's own look, like themcats.org/mcatalyst.
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/mona-sans/wght.css';
// Baked by scripts/bake-space.mjs: live blurs this size stutter in some browsers.
import nebulaImg from '../assets/present/nebula.webp';
import horizonImg from '../assets/present/horizon.webp';
import starsImg from '../assets/present/stars.webp';
// Baked by scripts/bake-orbit.mjs (the orbit look).
import oRings from '../assets/present/orbit/rings.webp';
import oRingsSoft from '../assets/present/orbit/rings-soft.webp';
import oFlare from '../assets/present/orbit/flare.webp';
import oFlareViolet from '../assets/present/orbit/flare-violet.webp';
import oSpark from '../assets/present/orbit/spark.webp';
import oSparkPink from '../assets/present/orbit/spark-pink.webp';
import oNebula from '../assets/present/orbit/nebula.webp';
import oStars from '../assets/present/orbit/stars.webp';
import oHaze from '../assets/present/orbit/haze.webp';
import oMini from '../assets/present/orbit/orbit-mini.webp';
import oGeo from '../assets/present/orbit/geometry.json';

interface Props {
  theme?: 'classic' | 'space' | 'orbit';
}
const { theme = 'classic' } = Astro.props;
const classic = theme === 'classic';
const space = theme === 'space';
const orbit = theme === 'orbit';

// Coloured by MCAT section: c = Chem/Phys, b = Bio/Biochem, p = Psych/Soc, s = all of them.
const subjects: [string, 'c' | 'b' | 'p' | 's'][] = [
  ['Orgo 1', 'c'],
  ['Orgo 2', 'c'],
  ['Gen Chem 1', 'c'],
  ['Gen Chem 2', 'c'],
  ['Physics 1', 'c'],
  ['Physics 2', 'c'],
  ['Biology', 'b'],
  ['Physiology', 'b'],
  ['Cell Biology', 'b'],
  ['Genetics', 'b'],
  ['Biochemistry 1 & 2', 'b'],
  ['Psychology', 'p'],
  ['Sociology', 'p'],
  ['Statistics', 's'],
];

const costs = [
  { label: 'MCAT registration', amount: 360, note: 'we provide a scholarship', accent: 'rose' },
  { label: 'AAMC resources', amount: 323.7 },
  { label: 'UWorld', amount: 339, note: 'we provide a discount', accent: 'violet' },
  { label: 'Kaplan books', amount: 200, note: 'talk to us before buying', accent: 'gold' },
];
const total = costs.reduce((a, c) => a + c.amount, 0);

// Officer portraits, cropped for the slides: src/assets/present/<team id>.jpg
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/present/*.jpg', { eager: true });
const officers = leadership.map((m) => ({ ...m, photo: portraits[`../assets/present/${m.id}.jpg`]?.default }));
// Full-length photos: keep the face, not the shoes.
const tall = new Set(['anmol-nayak', 'zander-houchens', 'andrew-peng']);

const qr = (url: string) =>
  QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#0d0d0c', light: '#eeebe4' } });
const [qrGroupme, qrBbn] = await Promise.all([qr(links.groupme), qr(links.bbnvolved)]);
const awards = scholarship.awards.need + scholarship.awards.merit;
const day = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
// "Nov 1–13", or "Oct 30–Nov 2" across a month
const span = (t: { date: string; end?: string }) => {
  if (!t.end) return day(t.date);
  const [a, b] = [day(t.date), day(t.end)];
  return a.split(' ')[0] === b.split(' ')[0] ? `${a}–${b.split(' ')[1]}` : `${a}–${b}`;
};

// Cover slides from this semester's classes: src/assets/present/classes/*.jpg
const covers = Object.values(import.meta.glob<{ default: ImageMetadata }>('../assets/present/classes/*.jpg', { eager: true })).map((m) => m.default);

// ── Space theme ──────────────────────────────────────────────
// A tilted ellipse as an SVG path, starting at its right end. Positive rot = clockwise.
const ellipse = (cx: number, cy: number, rx: number, ry: number, rot: number) => {
  const r = (rot * Math.PI) / 180;
  const at = (t: number) =>
    [cx + rx * Math.cos(t) * Math.cos(r) - ry * Math.sin(t) * Math.sin(r), cy + rx * Math.cos(t) * Math.sin(r) + ry * Math.sin(t) * Math.cos(r)].map((v) => v.toFixed(1));
  const [x1, y1] = at(0);
  const [x2, y2] = at(Math.PI);
  return `M ${x1} ${y1} A ${rx} ${ry} ${rot} 1 1 ${x2} ${y2} A ${rx} ${ry} ${rot} 1 1 ${x1} ${y1}`;
};
const SUN = { x: 1440, y: 470 }; // where the nebula, orbits and star sit on the title
// Drawn around (0, 0): the orbit system moves as one piece from slide to slide.
const orbits = [ellipse(0, 0, 400, 118, -12), ellipse(0, 0, 438, 150, -9)];
const sparks = [
  { x: 1130, y: 250, s: 26 },
  { x: 1770, y: 215, s: 18 },
  { x: 1700, y: 650, s: 30 },
  { x: 1210, y: 705, s: 16 },
  { x: 1010, y: 330, s: 12 },
  { x: 1560, y: 140, s: 14 },
];

// ── Orbit theme ──────────────────────────────────────────────
// Pin the live star and the travelling sparkles to the baked rings.
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const oFlareAt = `left:${pct(oGeo.orbit.star[0], oGeo.orbit.w)};top:${pct(oGeo.orbit.star[1], oGeo.orbit.h)}`;
const oRide = oGeo.orbit.rings[1]; // the one true ellipse among the rings
const oSat = [
  `--x:${pct(oGeo.orbit.cx + oRide.dx, oGeo.orbit.w)}`,
  `--y:${pct(oGeo.orbit.cy + oRide.dy, oGeo.orbit.h)}`,
  `--rx:${((oRide.a / oGeo.orbit.w) * 100).toFixed(3)}cqw`,
  `--k:${(oRide.b / oRide.a).toFixed(4)}`,
  `--tilt:${oRide.tilt}deg`,
  '--dur:30s',
].join(';');
const oMiniSat = (dur: string) =>
  `--x:50%;--y:50%;--rx:${((oGeo.mini.a / oGeo.mini.w) * 100).toFixed(3)}cqw;--k:${(oGeo.mini.b / oGeo.mini.a).toFixed(4)};--dur:${dur}`;

// The MCatalyst slide: the app icon's energy diagram, opened out, and the ticker band.
const mcxSpark = 'M0,-9.5 Q0,0 9.5,0 Q0,0 0,9.5 Q0,0 -9.5,0 Q0,0 0,-9.5Z';
const mcxTicker = ['Check every chapter', 'Free', 'No account', 'Every question approved by an officer', 'Made by The M-CATS'];

const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 });
// The same ledger near the end, crossed off line by line.
// What's left for a scholarship winner. UWorld keeps its price: members get a discount, not a replacement.
const rcLeft = total - costs[0].amount - costs[3].amount;
const recap = [
  { label: costs[0].label, was: money(costs[0].amount), now: `our scholarship · ${awards} a year`, accent: 'rose', step: 1, zero: true },
  { label: costs[1].label, was: money(costs[1].amount), now: 'most people buy less', accent: 'violet', step: 5, keep: true },
  { label: costs[2].label, was: money(costs[2].amount), now: 'member discount', accent: 'violet', step: 2, keep: true },
  { label: costs[3].label, was: money(costs[3].amount), now: 'we teach all of it', accent: 'gold', step: 4, zero: true },
  { label: 'Tutoring', was: '∞', now: 'free with our officers', accent: 'gold', step: 3, zero: true },
];
---
  <div class="deck" data-theme={theme} data-palette="aurora" data-slide="0" data-mark="hero" data-cat={classic ? 'hero' : 'gone'}>
    <div class="stage" aria-live="polite">
      <!-- ── Persistent layer ───────────────────────────────── -->
      {classic && (
        <div class="glow" aria-hidden="true">
          <span class="g g1"></span>
          <span class="g g2"></span>
          <span class="g g3"></span>
        </div>
      )}
      {space && (
        <Fragment>
          <img class="stars" src={starsImg.src} width="2100" height="1200" alt="" decoding="async" aria-hidden="true" />
          <div class="neb" style={`left:${SUN.x - 1000}px;top:${SUN.y - 450}px`} aria-hidden="true">
            <div class="nebula"><img src={nebulaImg.src} width="2000" height="900" alt="" decoding="async" /></div>
          </div>
        </Fragment>
      )}
      {orbit && (
        <Fragment>
          <img class="o-stars" src={oStars.src} width="2400" height="1500" alt="" decoding="async" aria-hidden="true" />
          <img class="o-haze" src={oHaze.src} width="960" height="600" alt="" decoding="async" aria-hidden="true" />
          <div class="o-neb" aria-hidden="true">
            <img class="o-nebula" src={oNebula.src} width="2600" height="1500" alt="" decoding="async" />
          </div>
        </Fragment>
      )}
      <div class="cat" aria-hidden="true">
        {/* space and orbit: red and blue copies under the white one make the lens fringe */}
        {!classic && <Logo label="" class="cat-r" />}
        {!classic && <Logo label="" class="cat-b" />}
        <Logo label="" />
      </div>
      {space && (
        <Fragment>
          <div class="sys" style={`left:${SUN.x}px;top:${SUN.y}px`} aria-hidden="true">
            <svg class="orb" width="1040" height="440" viewBox="-520 -220 1040 440">
              {orbits.map((d, i) => (
                <g class={`orb-${i}`}>
                  <path d={d} pathLength="1" class="o-r" />
                  <path d={d} pathLength="1" class="o-b" />
                  <path d={d} pathLength="1" class="o-w" />
                </g>
              ))}
            </svg>
            <span class="traveler" style={`offset-path:path('${orbits[0]}')`}>
              <span class="star mini">
                <span class="st-h"></span><span class="st-v"></span><span class="st-core"></span>
              </span>
            </span>
          </div>
          <div class="sun" style={`left:${SUN.x}px;top:${SUN.y}px`} aria-hidden="true">
            <span class="star">
              <span class="st-halo"></span>
              <span class="st-h r"></span><span class="st-h b"></span><span class="st-h"></span>
              <span class="st-v r"></span><span class="st-v b"></span><span class="st-v"></span>
              <span class="st-core"></span>
            </span>
          </div>
          <div class="hz" aria-hidden="true">
            <img class="horizon" src={horizonImg.src} width="1920" height="250" alt="" decoding="async" />
            <span class="flare"><span class="fl-h"></span><span class="fl-h2"></span><span class="fl-v"></span><span class="fl-core"></span></span>
          </div>
        </Fragment>
      )}
      {orbit && (
        <Fragment>
          {/* The orbits move as one piece; the star and the sparkle ride them. */}
          <div class="o-sys" aria-hidden="true">
            <div class="o-spin">
              <img class="o-rings-soft" src={oRingsSoft.src} width="1100" height="575" alt="" decoding="async" />
              <img class="o-rings" src={oRings.src} width="2200" height="1150" alt="" decoding="async" />
              <span class="sat" style={oSat}>
                <span class="sat-arm"><span class="sat-body"><span class="sat-fix"><img src={oSpark.src} width="240" height="240" alt="" /></span></span></span>
              </span>
              <span class="o-flare" style={oFlareAt}><img src={oFlare.src} width="1400" height="1400" alt="" decoding="async" /></span>
            </div>
          </div>
          <div class="o-sun" aria-hidden="true"><img src={oFlareViolet.src} width="1400" height="1400" alt="" decoding="async" /></div>
        </Fragment>
      )}
      <h1 class="mark">
        <span class="mark-the italic">the</span>
        <span class="mark-mcat display ca">MCAT</span>
      </h1>

      <!-- ── 1 · Title ──────────────────────────────────────── -->
      {classic && (
      <section class="slide s-title" aria-label="Title" data-mark="hero" data-cat="hero">
        <p class="label kicker">The M-CATS presents</p>
        <p class="mono t-sub">A brief introduction</p>
        <div class="t-foot">
          <p class="mono">The M-CATS @ University of Kentucky</p>
          <span class="t-rule"></span>
          <p class="mono">themcats.org</p>
        </div>
      </section>
      )}

      <!-- ── 1 · Title, space: nebula, orbits and horizon are the persistent layer ── -->
      {space && (
      <section class="slide s-title s-orbit" aria-label="Title" data-mark="hero" data-cat="gone" data-neb="hero" data-sys="hero" data-sun="hero" data-hz="up">
        {sparks.map((p, i) => (
          <span class="spark" style={`left:${p.x}px;top:${p.y}px;--s:${p.s}px;--k:${i}`} aria-hidden="true"></span>
        ))}

        <p class="label kicker fx-in">01 · The M-CATS presents</p>
        <p class="mono t-sub fx-in" style="--i:6">A brief introduction</p>
        <p class="o-dots fx-in" style="--i:8" aria-hidden="true"><i></i><i></i><i></i><i></i></p>
        <span class="o-rule fx-in" style="--i:9"></span>

        <p class="o-tag label fx-in" style="--i:22">Different minds.<br />Same orbit.</p>
        <p class="o-coords mono fx-in" style="--i:16">38.0406° N &nbsp;·&nbsp; 84.5037° W</p>

        <p class="o-foot mono fx-in" style="--i:18">The M-CATS <span>✦</span> University of Kentucky</p>
      </section>
      )}

      <!-- ── 1 · Title, orbit: the back print. Orbits, star, wordmark, lockup ── -->
      {orbit && (
      <section class="slide s-title s-halo" aria-label="Title" data-mark="hero" data-cat="gone" data-neb="gone" data-sys="hero" data-sun="gone" data-hz="down">
        <p class="h-plate h-tl mono fx-in" style="--i:34">The M-CATS presents</p>
        <p class="h-plate h-tr mono fx-in" style="--i:35">38.0406° N &nbsp;·&nbsp; 84.5037° W</p>
        <p class="h-sub mono fx-in" style="--i:24">A brief introduction</p>
        <p class="h-twins fx-in" style="--i:28" aria-hidden="true">
          <img src={oSpark.src} width="240" height="240" alt="" />
          <img src={oSparkPink.src} width="240" height="240" alt="" />
        </p>
        <p class="h-motto mono fx-in" style="--i:31">Different minds.<br />Same orbit.</p>
        <p class="h-foot mono fx-in" style="--i:36"><span class="h-rule"></span>The M-CATS <span class="h-x">×</span> University of Kentucky<span class="h-rule"></span></p>
      </section>
      )}

      <!-- ── 2 · What it is ─────────────────────────────────── -->
      <section class="slide s-what" aria-label="What the MCAT is" data-mark="header" data-cat="mark" data-neb="corner" data-sys="gone 1:clock" data-sun="gone 1:clock" data-hz="down">
        <p class="label what-full" data-n="02">Medical College Admission Test</p>

        <div class="what-time fx fx-rise" data-step="1">
          <p class="mono what-cap">One sitting</p>
          <p class="display what-clock ca"><span data-count="450" data-format="hm">7h 30m</span></p>
          <p class="italic what-note">of testing. The longest standardized exam most of us will ever take.</p>
        </div>

        <div class="what-load" data-step="2">
          <p class="what-n fx fx-ca"><span class="display ca">14</span> <span class="italic">classes’ worth of content</span></p>
          <ul class="pills">
            {subjects.map(([name, s], i) => (
              <li class={`pill fx fx-pop`} data-s={s} style={`--i:${i}`}>{name}</li>
            ))}
          </ul>
          <p class="legend mono fx fx-fade" style="--i:15">
            <span><i data-s="c"></i>Chem / Phys</span>
            <span><i data-s="b"></i>Bio / Biochem</span>
            <span><i data-s="p"></i>Psych / Soc</span>
            <span><i data-s="s"></i>Everywhere</span>
          </p>
        </div>
      </section>

      <!-- ── 3 · What it costs ──────────────────────────────── -->
      <section class="slide s-cost" aria-label="What the MCAT costs" data-mark="header" data-cat="mark" data-neb="study" data-sys="gone" data-sun={`gone ${costs.length + 3}:study`} data-hz="down">
        <p class="label what-full" data-n="03">What it costs</p>

        <ol class="ledger">
          {costs.map((c, i) => (
            <li class="row fx fx-slide" data-step={i + 1}>
              <span class="r-label">{c.label}</span>
              {c.note && <span class={`r-note mono`} data-accent={c.accent}>{c.note}</span>}
              <span class="r-dots" aria-hidden="true"></span>
              <span class="r-amt mono">{money(c.amount)}</span>
            </li>
          ))}
          <li class="row row-total fx fx-fade" data-step={costs.length + 1}>
            <span class="r-label label">Total</span>
            <span class="r-dots" aria-hidden="true"></span>
            <span class="r-amt display ca">~<span data-count={total} data-format="money">{money(total)}</span></span>
          </li>
          <li class="row row-inf fx fx-slide" data-step={costs.length + 2}>
            <span class="r-label">Tutoring <span class="italic dim">(optional)</span></span>
            <span class="r-dots" aria-hidden="true"></span>
            <span class="r-amt inf">∞</span>
          </li>
        </ol>

        <aside class="study fx fx-blur" data-step={costs.length + 3}>
          <p class="display study-n ca nebula-fringe">$6,357</p>
          <p class="italic study-txt">spent on average on MCAT preparation and related costs by Canadian applicants in 2015.</p>
          <p class="mono cite">Fortin et al. (2018), <i>MedEdPublish</i> 7:243 · doi.org/10.15694/mep.2018.0000243.1</p>
        </aside>

        <p class="punch italic fx fx-ca" data-step={costs.length + 4}>
          …and you can still pay all of this and still fail. <span class="mono">;-;</span>
        </p>
      </section>

      <!-- ── 4 · The turn ───────────────────────────────────── -->
      <section class="slide s-turn" aria-label="What do you do?" data-mark="gone" data-cat="gone 1:hero" data-neb="center 1:cat" data-sys="gone 1:cat" data-sun="gone 1:cat" data-hz="down">
        <h2 class="turn-q italic">What do you <span class="turn-do">do?</span></h2>
        <div class="turn-us" data-step="1">
          <p class="turn-word display">
            <span class="ca fx fx-ca">The</span>
            <span class="ca fx fx-ca" style="--i:3">M-CATS</span>
          </p>
          <p class="mono turn-at fx fx-fade" style="--i:8">@ University of Kentucky</p>
          <p class="italic turn-tag fx fx-rise" style="--i:10">A free, peer-driven MCAT prep community.</p>
        </div>
      </section>

      <!-- ── 5 · Officers ───────────────────────────────────── -->
      <section class="slide s-team" aria-label="The team" data-mark="gone" data-cat="mark" data-neb="top" data-sys="gone" data-sun="gone" data-hz="down">
        <p class="label what-full team-label" data-n="05">Leadership</p>
        <h2 class="team-h display ca">Run by students</h2>
        <ul class="team" data-step="1">
          {officers.map((m, i) => (
            <li class="person fx fx-person" style={`--i:${i * 2}`}>
              <div class="frame">
                {m.photo && <Image src={m.photo} alt="" widths={[300, 520]} sizes="320px" loading="eager" class={tall.has(m.id) ? 'tall' : ''} />}
              </div>
              <p class="p-name">{m.name}</p>
              <p class="p-role mono">{m.role}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── 6 · What we do ─────────────────────────────────── -->
      <section class="slide s-offer" aria-label="What we offer" data-mark="gone" data-cat="mark" data-neb="bottom" data-sys="gone" data-sun="gone" data-hz="down">
        <p class="label what-full team-label" data-n="06">What we do</p>
        <h2 class="team-h display ca">All of it, free</h2>
        <ol class="offers">
          <li class="offer fx fx-rise" data-step="1" data-accent="rose">
            {orbit && (
              <span class="o-mini" aria-hidden="true">
                <img src={oMini.src} width="800" height="400" alt="" />
                <span class="sat" style={oMiniSat('19s')}><span class="sat-arm"><span class="sat-body"><span class="sat-fix"><img src={oSpark.src} width="240" height="240" alt="" /></span></span></span></span>
              </span>
            )}
            <p class="o-free italic">free</p>
            <h3 class="o-title display">MCAT classes</h3>
            <dl class="o-sched mono">
              <div><dt>Mon · 6–9 PM</dt><dd>Chemistry</dd></div>
              <div><dt>Wed · 5–9 PM</dt><dd>Bio / Biochem</dd></div>
            </dl>
            <p class="o-body">Seminars that walk the Kaplan books chapter by chapter, slides posted after.</p>
            <p class="o-where mono">→ White Hall 231</p>
          </li>
          <li class="offer fx fx-rise" data-step="2" data-accent="violet">
            {orbit && (
              <span class="o-mini" aria-hidden="true">
                <img src={oMini.src} width="800" height="400" alt="" />
                <span class="sat" style={oMiniSat('24s')}><span class="sat-arm"><span class="sat-body"><span class="sat-fix"><img src={oSpark.src} width="240" height="240" alt="" /></span></span></span></span>
              </span>
            )}
            <p class="o-free italic">free</p>
            <h3 class="o-title display">Peer tutoring</h3>
            <p class="o-body">A one-on-one appointment with one of our officers, booked online whenever you need it.</p>
          </li>
