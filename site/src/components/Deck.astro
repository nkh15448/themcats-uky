  /* ═════════════════════════════════════════════════════════════
     Orbit (/presentOrbit): the multi-orbit back print.
     The art is baked (scripts/bake-orbit.mjs) and only moved and faded
     here. Nothing in this look runs a live filter: the site's .ca blur and
     the blur-in builds are switched off, and the colour split comes from
     text-shadow, so it stays smooth in Firefox.
     ═════════════════════════════════════════════════════════════ */
  .deck[data-theme='orbit'] {
    --bg: #0a0c0e;
    --bg-raise: #111318;
    --fg: #efeae2;
    --fg-dim: #c9c4bd;
    --muted: #918f96;
    --faint: #5d5f68;
    --rule-strong: rgba(239, 234, 226, 0.22);
    --lav: #c9b6ee;
    --blush: #f1d9ee;
    --ca-rest: 0.012em;
    --o-r: rgba(255, 77, 106, 0.62);
    --o-b: rgba(58, 120, 255, 0.68);
    --o-display: 'Playfair Variable', var(--display);
    font-family: var(--o-display);
    font-variation-settings: 'opsz' 24, 'wdth' 100;
  }
  /* the site's moving grain is swapped for a still, baked one (.o-grain) */
  :global(body:has(.deck[data-theme='orbit'])::after) {
    display: none;
  }
  .deck[data-theme='orbit'] .slide,
  .deck[data-theme='orbit'] .slide :global(*),
  .deck[data-theme='orbit'] .mark,
  .deck[data-theme='orbit'] .mark :global(*) {
    filter: none !important;
  }
  /* Slides change with a fade and a breath of scale, never a blur. */
  .deck[data-theme='orbit'] .slide {
    transform: scale(1.012);
  }
  .deck[data-theme='orbit'] .slide.past {
    transform: scale(0.988);
  }
  .deck[data-theme='orbit'] .slide.on {
    transform: none;
  }

  /* Type: wide caps for display, Playfair italic for the voice, mono labels. */
  .deck[data-theme='orbit'] .display {
    font-family: var(--o-display);
    font-weight: 420;
    font-variation-settings: 'opsz' 30, 'wdth' 112.5;
    letter-spacing: 0.1em;
    line-height: 1;
  }
  .deck[data-theme='orbit'] .italic {
    font-family: var(--o-display);
    font-style: italic;
    font-weight: 360;
    font-variation-settings: 'opsz' 40, 'wdth' 100;
  }
  .deck[data-theme='orbit'] .mono,
  .deck[data-theme='orbit'] .label {
    font-weight: 400;
  }
  .deck[data-theme='orbit'] .ca {
    text-shadow:
      calc(var(--ca) * -1) calc(var(--ca) * -0.25) 0 var(--o-r),
      var(--ca) calc(var(--ca) * 0.25) 0 var(--o-b),
      0 0 0.14em rgba(255, 232, 226, 0.2),
      0 0 0.45em rgba(255, 96, 110, 0.1);
  }
  /* Numbers: Playfair's text cut, normal width, a little lighter. */
  .deck[data-theme='orbit'] :is(.what-clock, .what-n .display, .row-total .r-amt, .study-n) {
    font-weight: 340;
    font-variation-settings: 'opsz' 144, 'wdth' 100;
    letter-spacing: -0.02em;
    text-transform: none;
  }
  /* "02 ——— Medical College Admission Test" */
  .deck[data-theme='orbit'] [data-n] {
    color: var(--muted);
    letter-spacing: 0.42em;
  }
  .deck[data-theme='orbit'] [data-n]::before {
    content: attr(data-n);
    display: inline-block;
    margin-right: 26px;
    padding-right: 76px;
    color: var(--fg);
    letter-spacing: 0.2em;
    background: linear-gradient(90deg, rgba(239, 234, 226, 0.4), transparent) right center / 52px 1px no-repeat;
  }

  /* ── Orbit: the persistent layer ─────────────────────────────── */
  .o-stars {
    position: absolute;
    left: -120px;
    top: -110px;
    width: 2160px;
    height: 1350px;
    opacity: 0.85;
    transform: translate(calc(var(--px, 0) * -26px), calc(var(--px, 0) * 6px));
    transition: transform 1.8s var(--ease);
    will-change: transform;
  }
  .o-haze {
    position: absolute;
    left: 960px;
    top: 360px;
    width: 2300px;
    height: auto;
    translate: -50% -50%;
    opacity: 0.12;
    transition: opacity 1.8s var(--ease);
  }
  .deck[data-sys='hero'] .o-haze {
    opacity: 0.38;
  }
  .o-neb,
  .o-sys,
  .o-sun {
    position: absolute;
    transition:
      transform 1.9s var(--ease),
      opacity 1.5s var(--ease);
    will-change: transform, opacity;
  }

  /* The painted nebula, drifting. Where it sits, per slide (data-neb). */
  .o-neb {
    left: -40px;
    top: -37px;
    width: 2000px;
    height: 1154px;
    opacity: 0;
    transform: scale(0.9);
