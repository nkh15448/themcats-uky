  .deck[data-neb='join'] .o-neb { transform: translate(-300px, -120px) rotate(-4deg) scale(0.85); opacity: 0.5; }

  /* The orbits: centred on the rings' middle (art 1100, 520), so each spot
     below is "move the centre here, at this size". Per slide: data-sys. */
  .o-sys {
    left: 340px;
