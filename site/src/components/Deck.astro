<style>
  /* ── Frame ─────────────────────────────────────────────────── */
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  :global(body) {
    cursor: default;
  }
  .deck {
    --rose: var(--neb-rose);
    --violet: var(--neb-violet);
    --indigo: var(--neb-indigo);
    --gold: var(--neb-gold);
    --grad: linear-gradient(90deg, #9f93ff, #f09ac0 55%, #f6d39c);
    --dur: 1.3s;
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
    user-select: none;
  }
  .deck.idle {
    cursor: none;
  }
  /* A fixed 1920×1080 canvas, scaled to the screen by the script. */
  .stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1920px;
    height: 1080px;
    transform: translate(-50%, -50%) scale(var(--scale, 0.5));
    overflow: hidden;
  }

  /* ── Persistent layer ──────────────────────────────────────── */
  /* Everything here moves with transform/opacity only, so it glides. */
  .glow,
  .cat,
  .mark {
    position: absolute;
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
