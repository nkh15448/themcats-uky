    margin-bottom: 18px;
  }
  .what-clock {
    font-size: 210px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-transform: none;
  }
  .what-note {
    margin-top: 36px;
    font-size: 38px;
    line-height: 1.25;
    color: var(--fg-dim);
    max-width: 560px;
  }
  .what-load {
    position: absolute;
    left: 900px;
    right: 150px;
    top: 330px;
  }
  .what-n {
    display: flex;
    align-items: baseline;
    gap: 22px;
    margin-bottom: 44px;
  }
  .what-n .display {
    font-size: 150px;
  }
  .what-n .italic {
    font-size: 48px;
    color: var(--fg-dim);
  }
  .pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 14px;
  }
  .pill {
    --c: var(--fg);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 23px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    color: color-mix(in srgb, var(--c) 70%, var(--fg));
    box-shadow: 0 0 34px -8px color-mix(in srgb, var(--c) 60%, transparent);
  }
  [data-s='c'] { --c: var(--cp); }
  [data-s='b'] { --c: var(--bb); }
  [data-s='p'] { --c: var(--ps); }
  [data-s='s'] { --c: var(--cars); }
  .legend {
    display: flex;
    gap: 36px;
    margin-top: 48px;
    font-size: 15px;
    color: var(--muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  /* ── 3 · Cost ──────────────────────────────────────────────── */
  .ledger {
    position: absolute;
    left: 150px;
    top: 290px;
    width: 1000px;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 22px;
    padding: 14px 0;
    font-size: 38px;
  }
  .r-label {
    white-space: nowrap;
  }
  .r-note {
    font-size: 15px;
    padding: 6px 14px;
    border-radius: 999px;
    align-self: center;
    white-space: nowrap;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
    background: color-mix(in srgb, var(--c) 10%, transparent);
  }
  [data-accent='rose'] { --c: var(--rose); }
  [data-accent='violet'] { --c: var(--violet); }
  [data-accent='gold'] { --c: var(--gold); }
  .r-dots {
    flex: 1;
    border-bottom: 2px dotted var(--faint);
    transform: translateY(-8px);
  }
  .r-amt {
    font-size: 40px;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }
  .row-total {
    margin-top: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-strong);
    align-items: center;
  }
  .row-total .r-label {
    font-size: 20px;
  }
  .row-total .r-dots {
    border: 0;
  }
  .row-total .r-amt {
    font-size: 96px;
    font-weight: 700;
    text-transform: none;
    font-family: var(--display);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .row-inf .r-amt {
    font-family: var(--serif);
    font-size: 96px;
    line-height: 0.6;
    color: var(--rose);
    text-shadow: 0 0 40px color-mix(in srgb, var(--rose) 60%, transparent);
  }
  .dim {
    color: var(--muted);
  }
  .study {
    position: absolute;
    left: 1290px;
    right: 150px;
    top: 360px;
  }
  .study-n {
    font-size: 140px;
    text-transform: none;
    font-variant-numeric: lining-nums;
    color: var(--gold);
  }
  .study-txt {
    margin-top: 30px;
    font-size: 36px;
    line-height: 1.25;
    color: var(--fg-dim);
  }
  .cite {
    margin-top: 28px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .punch {
    position: absolute;
    left: 150px;
    bottom: 96px;
    font-size: 56px;
    color: var(--fg);
  }
  .punch .mono {
    font-size: 40px;
    color: var(--rose);
    margin-left: 12px;
  }

  /* ── 4 · The turn ──────────────────────────────────────────── */
  .turn-q {
    position: absolute;
    left: 0;
    right: 0;
    top: 380px;
    text-align: center;
    font-size: 190px;
    font-weight: 400;
    line-height: 1;
    transform-origin: 50% 0;
    transition:
      transform 1.3s var(--ease),
      opacity 1.3s var(--ease),
      filter 1.3s var(--ease);
  }
  .turn-do {
    color: var(--rose);
    text-shadow: 0 0 60px color-mix(in srgb, var(--rose) 55%, transparent);
  }
  .deck[data-slide='3'][data-build='1'] .turn-q {
    transform: translate(-520px, -240px) scale(0.32);
    opacity: 0.55;
  }
  .turn-us {
    position: absolute;
    left: 150px;
    top: 330px;
  }
  .turn-word {
    display: flex;
    flex-direction: column;
    margin: 26px 0 30px;
  }
  .turn-word span:first-child {
    font-size: 150px;
  }
  .turn-word span:last-child {
    font-size: 260px;
  }
  .turn-at {
    font-size: 22px;
    color: var(--fg-dim);
    letter-spacing: 0.3em;
  }
  .turn-tag {
    margin-top: 30px;
    font-size: 46px;
    color: var(--fg-dim);
  }

  /* ── 5 · Team ──────────────────────────────────────────────── */
  .team-label {
    top: 150px;
  }
  .team-h {
    position: absolute;
    left: 150px;
    top: 200px;
    font-size: 110px;
    --ca-rest: 0.025em;
  }
  .team {
    position: absolute;
    left: 150px;
    right: 150px;
    top: 400px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 28px;
  }
  .frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    background: var(--bg-raise);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .frame :global(img.tall) {
    object-position: 50% 12%;
  }
  .p-name {
    margin-top: 22px;
    font-size: 34px;
    line-height: 1.1;
  }
  .p-role {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  /* ── 6 · Offer ─────────────────────────────────────────────── */
  .offers {
    position: absolute;
    left: 150px;
    right: 150px;
    top: 400px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
  }
  .offer {
    --c: var(--fg);
    padding-top: 30px;
    border-top: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }
  .o-free {
    font-size: 84px;
    line-height: 0.9;
    color: var(--c);
    text-shadow: 0 0 50px color-mix(in srgb, var(--c) 50%, transparent);
  }
  .o-title {
    margin: 14px 0 28px;
    font-size: 64px;
    /* the hairline 1200 cut breaks letter spacing at this size */
    --opsz: 144;
  }
  .o-body {
    font-size: 32px;
    line-height: 1.3;
    color: var(--fg-dim);
  }
  .o-body b {
    font-weight: 600;
    color: var(--c);
  }
  .o-sched {
    display: grid;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 20px;
  }
  .o-sched div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 10px;
    border-bottom: 1px dotted var(--faint);
  }
  .o-sched dd {
    color: var(--c);
  }
  .o-where {
    margin-top: 24px;
    font-size: 20px;
    color: var(--c);
  }

  /* ── 7 · MCatalyst ───────────────────────────────────────── */
  .mc-sub {
    position: absolute;
    left: 154px;
    top: 340px;
    font-size: 34px;
    color: var(--fg-dim);
  }
  .mc-feats {
    position: absolute;
    left: 150px;
    top: 460px;
    width: 720px;
    list-style: none;
    display: grid;
    gap: 40px;
  }
  .mc-feats li {
    --c: var(--fg);
    display: grid;
    grid-template-columns: 64px 1fr;
    font-size: 26px;
    line-height: 1.35;
    color: var(--fg-dim);
  }
  .mc-feats li > .mono {
    grid-row: span 2;
    padding-top: 14px;
    font-size: 18px;
    color: var(--c);
  }
  .mc-feats b {
    font-size: 44px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--fg);
  }
  .mc-card {
    position: absolute;
    left: 1000px;
    right: 150px;
    top: 160px;
    padding: 40px 44px;
    border: 1px solid var(--rule-strong);
    background: color-mix(in srgb, var(--bg-raise) 82%, transparent);
    box-shadow: 0 40px 120px -40px color-mix(in srgb, var(--violet) 45%, transparent);
  }
  .mc-meta {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .mc-stem {
    margin: 22px 0 26px;
    font-size: 30px;
    line-height: 1.3;
  }
  .mc-choices {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .mc-choices li {
    padding: 12px 18px;
    font-size: 24px;
    border: 1px solid var(--faint);
    transition: opacity 0.8s var(--ease), border-color 0.8s var(--ease), background 0.8s var(--ease), box-shadow 0.8s var(--ease);
  }
  .mc-choices li .mono {
    margin-right: 18px;
    font-size: 17px;
    color: var(--muted);
  }
  .mc-card:has(.mc-why.shown) .mc-choices li:not(.right) {
    opacity: 0.4;
  }
  .mc-card:has(.mc-why.shown) .right {
    border-color: var(--violet);
    background: color-mix(in srgb, var(--violet) 16%, transparent);
    box-shadow: 0 0 40px -6px color-mix(in srgb, var(--violet) 55%, transparent);
  }
  .mc-why {
    margin-top: 22px;
    font-size: 21px;
    line-height: 1.4;
    color: var(--fg-dim);
    transition: opacity 0.9s var(--ease) 0.25s, filter 0.9s var(--ease) 0.25s, transform 0.9s var(--ease) 0.25s;
  }
  .mc-why .mono {
    display: block;
    margin-bottom: 6px;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: var(--violet);
  }
  .mc-why:not(.shown) {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(14px);
    transition-delay: 0s;
  }
  .mc-check {
    position: absolute;
    left: 1000px;
    right: 150px;
    top: 830px;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .mc-dots {
    list-style: none;
    display: flex;
    gap: 12px;
    margin-top: 18px;
  }
  .mc-dots li {
    flex: 1;
    height: 12px;
    border-radius: 6px;
    background: var(--violet);
    box-shadow: 0 0 18px -2px color-mix(in srgb, var(--violet) 70%, transparent);
    transform-origin: left;
    transition: transform 0.7s var(--ease), opacity 0.7s var(--ease);
    transition-delay: calc(var(--i) * 70ms);
  }
  .mc-dots li[data-v='0'] {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rose);
  }
  .mc-dots li[data-v='2'] {
    background: var(--gold);
    box-shadow: 0 0 18px -2px color-mix(in srgb, var(--gold) 70%, transparent);
  }
  .mc-check:not(.shown) .mc-dots li {
    transform: scaleX(0);
    opacity: 0;
    transition-delay: 0s;
  }

  /* Intro: the mark draws itself, then tucks into the corner beside the name. */
  .mci-logo { position: absolute; left: 710px; top: 190px; width: 500px; height: 500px; transition: transform 1.4s var(--ease); }
  .mci-logo::before {
    content: ''; position: absolute; inset: -30%;
    background: radial-gradient(circle, color-mix(in srgb, #f09ac0 30%, transparent), color-mix(in srgb, #9f93ff 14%, transparent) 40%, transparent 68%);
    transition: opacity 1.6s var(--ease) 0.8s;
  }
  .mci-logo svg { position: relative; width: 100%; height: 100%; overflow: visible; }
  .mci-dots { stroke-opacity: 0.55; transition: stroke-opacity 1s var(--ease) 0.3s; }
  .mci-arc { stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.8s var(--ease) 0.15s; }
  .mci-spark {
    transform-box: fill-box; transform-origin: center;
    transition: transform 1s var(--ease) 1.4s, opacity 0.6s var(--ease) 1.4s;
    animation: twinkle 3.2s ease-in-out 3.2s infinite;
  }
  .slide:not(.on) .mci-dots { stroke-opacity: 0; transition-delay: 0s; }
  .s-mci:not(:has(.mci-go.shown)) .mci-arc { stroke-dashoffset: 1; transition-delay: 0s; }
  .s-mci:not(:has(.mci-go.shown)) .mci-spark { transform: scale(0) rotate(-120deg); opacity: 0; transition-delay: 0s; }
  .s-mci:not(:has(.mci-go.shown)) .mci-logo::before { opacity: 0; transition-delay: 0s; }
  @keyframes twinkle {
    0%, 100% { filter: drop-shadow(0 0 1px #fff); }
    50% { filter: drop-shadow(0 0 5px #fff) drop-shadow(0 0 10px #f09ac0); }
  }
  .s-mci:has(.mci-name.shown) .mci-logo { transform: translate(-760px, -200px) scale(0.3); }
  .s-mci:has(.mci-name.shown) .mci-logo::before { opacity: 0.4; transition-delay: 0s; }
  .mci-name { position: absolute; left: 360px; top: 150px; font-size: 150px; line-height: 1; }
  .mci-name span {
    display: inline-block;
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.9s var(--ease);
    transition-delay: calc(0.55s + var(--i) * 60ms);
  }
  .mci-name:not(.shown) span { opacity: 0; transform: translateY(50px) rotate(4deg); filter: blur(14px); transition-delay: 0s; }
  .mci-tag { position: absolute; left: 366px; top: 320px; font-size: 40px; color: var(--fg-dim); }
  .mci-big { position: absolute; left: 150px; top: 560px; width: 1500px; font-size: 76px; line-height: 1.15; }
  .mci-free, .qb-us .qb-n {
    background: var(--grad);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* Chapter checks: the concept web, the question, the reference chart. */
  .s-mc .team-h { font-size: 88px; }
  .s-mc .mc-sub { top: 308px; width: 760px; font-size: 28px; line-height: 1.3; }
  .mc-web { position: absolute; left: 150px; top: 470px; width: 760px; height: 400px; }
  .mc-web svg { position: absolute; inset: 0; overflow: visible; }
  .mc-web line {
    stroke: var(--violet); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 0;
    filter: drop-shadow(0 0 6px var(--violet));
    transition: stroke-dashoffset 1.1s var(--ease); transition-delay: calc(0.35s + var(--i) * 160ms);
  }
  .mc-web:not(.shown) line { stroke-dashoffset: 1; transition-delay: 0s; }
  .mc-node {
    position: absolute; translate: -50% -50%; padding: 12px 20px;
    font-size: 24px; white-space: nowrap; text-align: center;
    border: 1px solid var(--rule-strong); background: var(--bg-raise);
    transition: opacity 0.8s var(--ease), transform 0.8s var(--ease), filter 0.8s var(--ease);
    transition-delay: calc(var(--i) * 160ms);
  }
  .mc-node small { display: block; margin-top: 4px; font-size: 13px; letter-spacing: 0.15em; color: var(--muted); }
  .mc-node.hub { font-size: 34px; border-color: var(--rose); box-shadow: 0 0 50px -8px var(--rose); }
  .mc-web:not(.shown) .mc-node { opacity: 0; transform: scale(0.8); filter: blur(8px); transition-delay: 0s; }
  .s-mc .mc-card { left: 1000px; right: 420px; top: 150px; padding: 34px 36px; }
  .s-mc .mc-stem { font-size: 27px; }
  .s-mc .mc-choices li { font-size: 21px; padding: 10px 16px; }
  .s-mc .mc-why { font-size: 19px; }
  .mc-fig { position: absolute; left: 1380px; top: 470px; width: 440px; rotate: 2deg; }
  .mc-fig img { display: block; width: 100%; height: auto; padding: 14px; background: #f4f1ea; box-shadow: 0 40px 90px -20px rgb(0 0 0 / 0.75); }
  .mc-fig figcaption { margin-top: 12px; font-size: 14px; letter-spacing: 0.15em; color: var(--muted); }

  /* The Q-bank: what it costs elsewhere, and here. */
  .qb-side { position: absolute; top: 400px; }
  .qb-side .mono { font-size: 20px; letter-spacing: 0.2em; color: var(--muted); }
  .qb-them { left: 150px; transition: opacity 0.9s var(--ease); }
  .qb-us { left: 900px; }
  .qb-n { font-size: 230px; line-height: 1; }
  .qb-them .qb-n { position: relative; color: var(--fg-dim); }
  .qb-them .qb-n::after {
    content: ''; position: absolute; left: -2%; right: -2%; top: 52%; height: 6px;
    background: var(--rose); box-shadow: 0 0 24px var(--rose);
    transform-origin: left; transition: transform 0.9s var(--ease) 0.5s;
  }
  .s-qb:not(:has(.qb-us.shown)) .qb-them .qb-n::after { transform: scaleX(0); transition-delay: 0s; }
  .s-qb:has(.qb-us.shown) .qb-them { opacity: 0.45; }
  .qb-feats { position: absolute; left: 150px; right: 150px; top: 760px; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 60px; }
  .qb-feats li { --c: var(--fg); padding-top: 22px; border-top: 1px solid color-mix(in srgb, var(--c) 50%, transparent); font-size: 26px; line-height: 1.35; color: var(--fg-dim); }
  .qb-feats b { display: block; margin-bottom: 8px; font-size: 44px; font-weight: 400; color: var(--fg); }

  /* The chapter map, drawn the way the app draws it. */
  .s-cm .team-h { top: 188px; font-size: 72px; }
  .cm-sub { position: absolute; left: 154px; top: 278px; font-size: 28px; color: var(--fg-dim); }
  .cm { position: absolute; inset: 0; }
  .cm svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cm-rail { stroke: color-mix(in srgb, var(--c) 35%, transparent); stroke-width: 2; }
  .cm-draw {
    fill: none; stroke: #fff; stroke-width: 14; stroke-dasharray: 1; stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.3s var(--ease); transition-delay: calc(0.2s + var(--i) * 90ms);
  }
  .cm:not(.shown) .cm-draw { stroke-dashoffset: 1; transition-delay: 0s; transition-duration: 0.3s; }
  .cm-link {
    fill: none; stroke: rgb(255 255 255 / 0.5); stroke-width: 2.5; stroke-dasharray: 6 8; stroke-linecap: round;
    animation: cm-flow 1.4s linear infinite;
  }
  @keyframes cm-flow { to { stroke-dashoffset: -28; } }
  .cm-head { position: absolute; top: 335px; font-size: 15px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--c); }
  .cm ol { list-style: none; }
  .cm-row { position: absolute; display: flex; align-items: center; width: 400px; translate: 0 -50%; font-size: 19px; line-height: 1.1; }
  .cm-row .mono { width: 29px; font-size: 13px; color: var(--faint); }
  .cm-row i {
    position: relative; flex: none; width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid var(--c); background: #121318;
    transform: scale(0.45); transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }
  .cm-row b { position: relative; margin-left: 16px; font-weight: 400; color: var(--muted); opacity: 0.5; transition: opacity 0.6s var(--ease), color 0.6s var(--ease); }
  .cm.shown .cm-row.hit i, .cm-row.hub i { transform: none; }
  .cm.shown .cm-row.hit b, .cm-row.hub b { opacity: 1; color: var(--fg); }
  .cm.shown .cm-row.hit i, .cm.shown .cm-row.hit b { transition-delay: calc(1.1s + var(--i) * 90ms); }
  .cm.shown .cm-row.hit i { box-shadow: 0 0 16px -2px var(--c); }
  .cm-row.hub::before {
    content: ''; position: absolute; left: 24px; right: 6px; top: -12px; bottom: -12px;
    border: 1px solid var(--rule-strong); border-radius: 12px; background: rgb(30 32 40 / 0.85);
  }
  .cm-row.hub i { box-shadow: 0 0 0 8px color-mix(in srgb, var(--c) 25%, transparent), 0 0 30px var(--c); }

  /* Inside a check: the chart sits left of the question now. */
  .s-mc .mc-card { right: 150px; }
  .mc-fig { left: 190px; top: 440px; width: 560px; rotate: -2deg; }

  /* Shared by the intros: words that rise in letter by letter when the slide arrives. */
  .intro-word span { display: inline-block; transition: opacity 1s var(--ease), transform 1s var(--ease), filter 1s var(--ease); transition-delay: calc(0.9s + var(--i) * 70ms); }
  .slide:not(.on) .intro-word span { opacity: 0; transform: translateY(60px) rotate(5deg); filter: blur(16px); transition-delay: 0s; }
  .intro-in { transition: opacity 1.2s var(--ease), filter 1.2s var(--ease), transform 1.2s var(--ease); transition-delay: calc(0.9s + var(--i) * 70ms); }
  .slide:not(.on) .intro-in { opacity: 0; filter: blur(12px); transform: translateY(24px); transition-delay: 0s; }

  /* Classes intro: a seminar photo, full bleed, settling in from a slow zoom. */
  .ci-photo { position: absolute; inset: 0; overflow: hidden; }
  .ci-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); filter: none; opacity: 1; transition: transform 7s cubic-bezier(0.2, 0.6, 0.2, 1), filter 2s var(--ease), opacity 1.6s var(--ease); }
  .slide:not(.on) .ci-photo :global(img) { transform: scale(1.18); filter: blur(18px) brightness(0.4); opacity: 0; transition-duration: 0.4s; }
  .ci-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(8 8 10 / 0.92) 0%, rgb(8 8 10 / 0.65) 45%, rgb(8 8 10 / 0.15) 100%), linear-gradient(0deg, rgb(8 8 10 / 0.8), transparent 45%); }
