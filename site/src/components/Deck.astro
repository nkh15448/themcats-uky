  /* ── Slides ────────────────────────────────────────────────── */
  .slide {
    position: absolute;
    inset: 0;
    padding: 110px 150px;
    opacity: 0;
    filter: blur(18px);
    transform: scale(1.025);
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 1.1s var(--ease);
  }
  .slide.past {
    transform: scale(0.975);
  }
  .slide.on {
    opacity: 1;
    /* none, not blur(0): any filter makes the browser redraw the whole slide
       whenever something inside it moves */
    filter: none;
    transform: none;
    pointer-events: auto;
    transition-delay: 0.25s;
  }

  /* Build steps. Hidden until the slide reaches their step. */
  .fx {
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: calc(var(--i, 0) * 55ms);
  }
  [data-step]:not(.shown) .fx,
  .fx[data-step]:not(.shown) {
    opacity: 0;
    transition-delay: 0s;
  }
  [data-step]:not(.shown) .fx-rise,
  .fx-rise[data-step]:not(.shown) {
    transform: translateY(40px);
    filter: blur(10px);
  }
  [data-step]:not(.shown) .fx-pop {
    transform: translateY(24px) scale(0.92);
    filter: blur(8px);
  }
  .fx-slide[data-step]:not(.shown) {
    transform: translateX(-50px);
    filter: blur(8px);
  }
  .fx-blur[data-step]:not(.shown) {
    filter: blur(24px);
    transform: scale(1.04);
  }
  [data-step]:not(.shown) .fx-person {
    transform: translateY(50px);
    filter: blur(12px) grayscale(1);
  }
  /* Animates in as soon as its slide arrives, no click needed. */
  .fx-in {
    transition:
      opacity 1s var(--ease),
      filter 1s var(--ease),
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--i, 0) * 70ms);
  }
  .slide:not(.on) .fx-in {
    opacity: 0;
    filter: blur(14px);
    transform: translateY(30px);
    transition-delay: 0s;
  }
  [data-step].shown .fx-ca,
  .fx-ca[data-step].shown {
    animation: ca-in 1.6s var(--ease) both;
  }
  [data-step]:not(.shown) .fx-ca,
  .fx-ca[data-step]:not(.shown) {
    filter: blur(14px);
  }

  /* ── 1 · Title ─────────────────────────────────────────────── */
  .kicker {
    position: absolute;
    left: 154px;
    top: 150px;
    font-size: 20px;
    letter-spacing: 0.4em;
  }
  .t-sub {
    position: absolute;
    left: 158px;
    top: 830px;
    font-size: 26px;
    letter-spacing: 0.55em;
    color: var(--fg-dim);
  }
  .t-foot {
    position: absolute;
    left: 158px;
    right: 150px;
    bottom: 90px;
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 16px;
    color: var(--muted);
  }
  .t-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--rule-strong), var(--violet) 60%, var(--rose));
    opacity: 0.6;
  }

  /* ── 1 · Title, orbit draft ─────────────────────────────────── */
  /* The wordmark sits above the slides so the nebula never covers it. */
  .mark {
    z-index: 3;
  }
  .s-orbit .t-sub {
    top: 770px;
  }
  .o-dots {
    position: absolute;
    left: 158px;
    top: 840px;
    display: flex;
    gap: 16px;
  }
  .o-dots i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0, var(--c) 45%, color-mix(in srgb, var(--c) 40%, #000) 100%);
  }
  .o-dots i:nth-child(1) { --c: var(--violet); }
  .o-dots i:nth-child(2) { --c: var(--indigo); }
  .o-dots i:nth-child(3) { --c: var(--rose); }
  .o-dots i:nth-child(4) { --c: #8d93a8; }
  .o-rule {
    position: absolute;
    left: 158px;
    top: 905px;
    width: 280px;
    height: 1px;
    background: var(--rule-strong);
  }
  .o-tag {
    position: absolute;
    right: 130px;
    top: 720px;
    text-align: right;
    font-size: 17px;
    line-height: 1.9;
    letter-spacing: 0.35em;
    color: var(--fg-dim);
  }
  .o-coords {
    position: absolute;
    left: 70px;
    top: 540px;
    translate: -50% -50%;
    rotate: -90deg;
    white-space: nowrap;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--faint);
  }
  .o-foot {
    position: absolute;
    left: 0;
    right: 0;
    top: 1022px;
    text-align: center;
    font-size: 14px;
    letter-spacing: 0.55em;
    color: var(--muted);
  }
  .o-foot span {
    margin: 0 0.8em;
    color: var(--fg);
  }

  /* ── Space: the persistent layer ──────────────────────────────
     Baked images (scripts/bake-space.mjs) and thin lines that glide between
     slides. Only transform and opacity animate, which every browser does smoothly. */
  .stars {
    position: absolute;
    left: -90px;
    top: -60px;
    width: 2100px;
    height: 1200px;
    transform: translate(calc(var(--px, 0) * -24px), calc(var(--px, 0) * 5px));
    transition: transform 1.8s var(--ease);
    will-change: transform;
  }
  .neb,
  .sys,
  .sun,
  .hz {
    position: absolute;
    transition:
      transform 1.8s var(--ease),
      opacity 1.4s var(--ease);
    will-change: transform, opacity;
  }
  .neb {
    width: 2000px;
    height: 900px;
  }
  .sys,
  .sun {
    width: 0;
    height: 0;
  }
  .hz {
    inset: 0;
  }
  .orb {
    position: absolute;
    left: -520px;
    top: -220px;
    overflow: visible;
  }

  /* Where each piece sits, per slide (data-neb / data-sys / data-sun / data-hz). */
  .deck[data-neb='corner'] .neb { transform: translate(330px, -380px) rotate(14deg) scale(0.8); opacity: 0.55; }
  .deck[data-neb='study'] .neb { transform: translate(60px, 90px) rotate(10deg) scale(0.75); opacity: 0.5; }
  .deck[data-neb='center'] .neb { transform: translate(-480px, 80px) rotate(34deg) scale(1.15); opacity: 0.7; }
  .deck[data-neb='cat'] .neb { transform: translate(80px, 70px); opacity: 0.85; }
  /* the club intro: the wildcat sits a little right, centred in its orbits */
  .deck[data-theme='space'][data-cat='hero'] .cat { transform: translateX(60px); }
  .deck[data-neb='top'] .neb { transform: translate(-500px, -400px) rotate(30deg) scale(1.1); opacity: 0.5; }
  .deck[data-neb='bottom'] .neb { transform: translate(-500px, 470px) rotate(34deg) scale(1.2); opacity: 0.45; }
  .deck[data-neb='join'] .neb { transform: translate(60px, -40px) scale(0.95); opacity: 0.85; }

  .deck[data-sys='clock'] .sys { transform: translate(-970px, 16px) scale(0.9); }
  .deck[data-sys='cat'] .sys { transform: translate(80px, 60px) scale(0.95); }
  .deck[data-sys='gone'] .sys,
  .deck[data-sys='join'] .sys { transform: scale(0.6); opacity: 0; }

  .deck[data-sun='clock'] .sun { transform: translate(-618px, -59px) scale(0.45); }
  .deck[data-sun='study'] .sun { transform: translate(280px, -95px) scale(0.4); }
  .deck[data-sun='cat'] .sun { transform: translate(301px, -75px) scale(0.6); }
  .deck[data-sun='gone'] .sun { transform: scale(0.1); opacity: 0; }

  .deck[data-hz='down'] .hz { transform: translateY(320px); opacity: 0; }

  /* The nebula image: tilted, and drifting slowly the whole time. */
  .nebula {
    position: absolute;
    inset: 0;
    width: 2000px;
    height: 900px;
    rotate: -34deg;
    will-change: transform, opacity;
    animation: nb-drift 40s ease-in-out infinite alternate;
  }
  .nebula img {
    display: block;
    width: 100%;
    height: 100%;
  }
  @keyframes nb-drift {
    to {
      rotate: -31deg;
      translate: -30px 20px;
    }
  }

  /* Orbits: hairlines with a red/blue fringe, drawn in on arrival. */
  .orb path {
    fill: none;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-linecap: round;
  }
  .o-w {
    stroke: rgba(255, 255, 255, 0.85);
  }
  .o-r {
    stroke: var(--ca-r);
    opacity: 0.45;
    translate: -2px 0;
  }
  .o-b {
    stroke: var(--ca-b);
    opacity: 0.55;
    translate: 2px 0;
  }
  .orb-1 {
    opacity: 0.4;
  }
  .orb-1 path {
    stroke-width: 1;
  }

  /* Four-point stars: long thin rays with a chromatic fringe, and a hot core. */
  .star {
    position: absolute;
    width: 0;
    height: 0;
    --len: 560px;
  }
  .star > span {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    border-radius: 2px;
  }
  .st-halo {
    width: 300px;
    height: 300px;
    border-radius: 50% !important;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.5), rgba(229, 143, 196, 0.25) 45%, transparent);
  }
  .st-h {
    width: var(--len);
    height: 3px;
    background: linear-gradient(90deg, transparent, #fff 50%, transparent);
    animation: twinkle 3.4s ease-in-out infinite alternate;
  }
  .st-v {
    width: 3px;
    height: calc(var(--len) * 0.72);
    background: linear-gradient(180deg, transparent, #fff 50%, transparent);
    animation: twinkle 4.1s ease-in-out infinite alternate-reverse;
  }
  .st-h.r,
  .st-h.b {
    height: 4px;
  }
  .st-h.r {
    background: linear-gradient(90deg, transparent, var(--ca-r) 50%, transparent);
    translate: calc(-50% - 5px) calc(-50% + 1px);
  }
  .st-h.b {
    background: linear-gradient(90deg, transparent, var(--ca-b) 50%, transparent);
    translate: calc(-50% + 5px) calc(-50% - 1px);
  }
  .st-v.r {
    background: linear-gradient(180deg, transparent, var(--ca-r) 50%, transparent);
    translate: calc(-50% - 3px) -50%;
  }
  .st-v.b {
    background: linear-gradient(180deg, transparent, var(--ca-b) 50%, transparent);
    translate: calc(-50% + 3px) -50%;
  }
  .st-core {
    width: 18px;
    height: 18px;
    border-radius: 50% !important;
    background: #fff;
    box-shadow:
      0 0 18px 6px #fff,
      0 0 60px 22px rgba(229, 143, 196, 0.55);
  }
  @keyframes twinkle {
    to {
      scale: 0.82;
      opacity: 0.8;
    }
  }
  .star.mini {
    --len: 90px;
  }
  .star.mini .st-core {
    width: 6px;
    height: 6px;
    box-shadow:
      0 0 8px 3px #fff,
      0 0 22px 8px rgba(156, 193, 234, 0.6);
  }
  .traveler {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    offset-rotate: 0deg;
    animation: travel 34s linear infinite;
  }
  @keyframes travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  /* Small sparkle crosses. */
  .spark {
    position: absolute;
    width: var(--s);
    height: var(--s);
    translate: -50% -50%;
    background:
      linear-gradient(90deg, transparent, #fff 50%, transparent) center / 100% 1.5px no-repeat,
      linear-gradient(180deg, transparent, #fff 50%, transparent) center / 1.5px 100% no-repeat,
      radial-gradient(circle, #fff 0 1.5px, transparent 3px);
    animation: spark 3.6s ease-in-out infinite;
    animation-delay: calc(var(--k) * -0.7s);
  }
  @keyframes spark {
    50% {
      opacity: 0.35;
      scale: 0.75;
    }
  }

  /* The planet's horizon along the bottom, and its lens flare. */
  .horizon {
    position: absolute;
    left: 0;
    top: 830px;
    width: 1920px;
    height: 250px;
    will-change: transform, opacity;
  }
  .flare {
    position: absolute;
    left: 960px;
    top: 972px;
    width: 0;
    height: 0;
  }
  .flare > span {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
  }
  .fl-h {
    width: 1500px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(190, 210, 255, 0.95) 50%, transparent);
  }
  .fl-h2 {
    width: 900px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(140, 170, 255, 0.6), transparent);
  }
  .fl-v {
    width: 2px;
    height: 150px;
    background: linear-gradient(180deg, transparent, #fff 50%, transparent);
  }
  .fl-core {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 16px 6px #fff,
      0 0 70px 24px rgba(140, 170, 255, 0.6);
  }

  /* Arrival on the title: horizon rises, nebula condenses, orbits draw, the star ignites. */
  .deck[data-slide='0'] .horizon {
    animation: o-rise 2.4s var(--ease) both;
  }
  .deck[data-slide='0'] .flare {
    animation: o-flare 1.6s 1s var(--ease) both;
  }
  .deck[data-slide='0'] .nebula {
    animation:
      o-nebula 3s 0.3s var(--ease) both,
      nb-drift 40s ease-in-out infinite alternate;
  }
  /* Orbits draw whenever they appear: slowly on the title, briskly elsewhere. */
  .deck:not([data-sys='gone'], [data-sys='join']) .orb path {
    animation: o-draw 2.2s 0.4s var(--ease) both;
  }
  .deck[data-slide='0'] .orb path {
    animation-duration: 2.6s;
    animation-delay: 1.1s;
  }
  .deck[data-slide='0'] .orb-1 path {
    animation-delay: 1.5s;
  }
  .deck[data-slide='0'] .sun .star {
    animation: o-star 1.4s 2.1s var(--ease) both;
  }
  .deck[data-slide='0'] .traveler {
    animation:
      o-fade 1s 3s both,
      travel 34s 3s linear infinite;
  }
  .s-orbit.on .spark {
    animation:
      o-fade 1.2s calc(1.6s + var(--k) * 0.18s) both,
      spark 3.6s calc(var(--k) * -0.7s) ease-in-out infinite;
  }
  @keyframes o-rise {
    from {
      translate: 0 140px;
      opacity: 0;
    }
  }
  @keyframes o-flare {
    from {
      scale: 0 1;
      opacity: 0;
    }
  }
  @keyframes o-nebula {
    from {
      opacity: 0;
      scale: 1.12;
    }
  }
  @keyframes o-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes o-star {
    0% {
      opacity: 0;
      scale: 0.1;
    }
    55% {
      opacity: 1;
      scale: 1.3;
    }
  }
  @keyframes o-fade {
    from {
      opacity: 0;
    }
  }

  /* ── 2 · What ──────────────────────────────────────────────── */
  .what-full {
    position: absolute;
    left: 154px;
    top: 232px;
    font-size: 18px;
    letter-spacing: 0.4em;
  }
  .what-time {
    position: absolute;
    left: 150px;
