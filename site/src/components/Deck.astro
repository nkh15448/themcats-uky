  /* ── Slides ────────────────────────────────────────────────── */
  .slide {
    position: absolute;
    inset: 0;
    padding: 110px 150px;
    opacity: 0;
    filter: blur(18px);
    transform: scale(1.025);
    pointer-events: none;
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 1.1s var(--ease);
  }
  .slide.past {
    transform: scale(0.975);
  }
  .slide.on {
    opacity: 1;
    /* none, not blur(0): any filter makes the browser redraw the whole slide
       whenever something inside it moves */
    filter: none;
    transform: none;
    pointer-events: auto;
    transition-delay: 0.25s;
  }

  /* Build steps. Hidden until the slide reaches their step. */
  .fx {
    transition:
      opacity 0.9s var(--ease),
      filter 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: calc(var(--i, 0) * 55ms);
  }
  [data-step]:not(.shown) .fx,
  .fx[data-step]:not(.shown) {
    opacity: 0;
    transition-delay: 0s;
  }
  [data-step]:not(.shown) .fx-rise,
  .fx-rise[data-step]:not(.shown) {
    transform: translateY(40px);
    filter: blur(10px);
  }
  [data-step]:not(.shown) .fx-pop {
    transform: translateY(24px) scale(0.92);
    filter: blur(8px);
  }
  .fx-slide[data-step]:not(.shown) {
    transform: translateX(-50px);
    filter: blur(8px);
  }
  .fx-blur[data-step]:not(.shown) {
    filter: blur(24px);
    transform: scale(1.04);
  }
  [data-step]:not(.shown) .fx-person {
    transform: translateY(50px);
    filter: blur(12px) grayscale(1);
  }
  /* Animates in as soon as its slide arrives, no click needed. */
  .fx-in {
    transition:
      opacity 1s var(--ease),
      filter 1s var(--ease),
      transform 1s var(--ease);
    transition-delay: calc(0.35s + var(--i, 0) * 70ms);
  }
  .slide:not(.on) .fx-in {
    opacity: 0;
    filter: blur(14px);
    transform: translateY(30px);
    transition-delay: 0s;
  }
  [data-step].shown .fx-ca,
  .fx-ca[data-step].shown {
    animation: ca-in 1.6s var(--ease) both;
  }
  [data-step]:not(.shown) .fx-ca,
  .fx-ca[data-step]:not(.shown) {
    filter: blur(14px);
  }

  /* ── 1 · Title ─────────────────────────────────────────────── */
  .kicker {
    position: absolute;
    left: 154px;
    top: 150px;
    font-size: 20px;
    letter-spacing: 0.4em;
  }
  .t-sub {
    position: absolute;
    left: 158px;
    top: 830px;
    font-size: 26px;
    letter-spacing: 0.55em;
    color: var(--fg-dim);
  }
  .t-foot {
    position: absolute;
    left: 158px;
    right: 150px;
    bottom: 90px;
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 16px;
    color: var(--muted);
  }
  .t-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--rule-strong), var(--violet) 60%, var(--rose));
    opacity: 0.6;
  }

  /* ── 1 · Title, orbit draft ─────────────────────────────────── */
  /* The wordmark sits above the slides so the nebula never covers it. */
  .mark {
    z-index: 3;
  }
  .s-orbit .t-sub {
    top: 770px;
  }
  .o-dots {
    position: absolute;
    left: 158px;
    top: 840px;
    display: flex;
    gap: 16px;
  }
  .o-dots i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0, var(--c) 45%, color-mix(in srgb, var(--c) 40%, #000) 100%);
  }
  .o-dots i:nth-child(1) { --c: var(--violet); }
  .o-dots i:nth-child(2) { --c: var(--indigo); }
  .o-dots i:nth-child(3) { --c: var(--rose); }
  .o-dots i:nth-child(4) { --c: #8d93a8; }
  .o-rule {
    position: absolute;
    left: 158px;
    top: 905px;
    width: 280px;
    height: 1px;
    background: var(--rule-strong);
  }
  .o-tag {
    position: absolute;
    right: 130px;
    top: 720px;
    text-align: right;
    font-size: 17px;
    line-height: 1.9;
    letter-spacing: 0.35em;
    color: var(--fg-dim);
  }
  .o-coords {
    position: absolute;
    left: 70px;
    top: 540px;
    translate: -50% -50%;
    rotate: -90deg;
    white-space: nowrap;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--faint);
  }
  .o-foot {
    position: absolute;
    left: 0;
    right: 0;
    top: 1022px;
    text-align: center;
    font-size: 14px;
    letter-spacing: 0.55em;
    color: var(--muted);
  }
  .o-foot span {
    margin: 0 0.8em;
    color: var(--fg);
  }

  /* ── Space: the persistent layer ──────────────────────────────
     Baked images (scripts/bake-space.mjs) and thin lines that glide between
     slides. Only transform and opacity animate, which every browser does smoothly. */
  .stars {
    position: absolute;
    left: -90px;
    top: -60px;
    width: 2100px;
    height: 1200px;
    transform: translate(calc(var(--px, 0) * -24px), calc(var(--px, 0) * 5px));
    transition: transform 1.8s var(--ease);
    will-change: transform;
  }
  .neb,
  .sys,
  .sun,
  .hz {
    position: absolute;
    transition:
      transform 1.8s var(--ease),
      opacity 1.4s var(--ease);
    will-change: transform, opacity;
  }
  .neb {
    width: 2000px;
    height: 900px;
  }
  .sys,
  .sun {
    width: 0;
    height: 0;
  }
  .hz {
    inset: 0;
  }
  .orb {
    position: absolute;
    left: -520px;
    top: -220px;
    overflow: visible;
  }

  /* Where each piece sits, per slide (data-neb / data-sys / data-sun / data-hz). */
  .deck[data-neb='corner'] .neb { transform: translate(330px, -380px) rotate(14deg) scale(0.8); opacity: 0.55; }
  .deck[data-neb='study'] .neb { transform: translate(60px, 90px) rotate(10deg) scale(0.75); opacity: 0.5; }
  .deck[data-neb='center'] .neb { transform: translate(-480px, 80px) rotate(34deg) scale(1.15); opacity: 0.7; }
  .deck[data-neb='cat'] .neb { transform: translate(80px, 70px); opacity: 0.85; }
  /* the club intro: the wildcat sits a little right, centred in its orbits */
  .deck[data-theme='space'][data-cat='hero'] .cat { transform: translateX(60px); }
  .deck[data-neb='top'] .neb { transform: translate(-500px, -400px) rotate(30deg) scale(1.1); opacity: 0.5; }
  .deck[data-neb='bottom'] .neb { transform: translate(-500px, 470px) rotate(34deg) scale(1.2); opacity: 0.45; }
  .deck[data-neb='join'] .neb { transform: translate(60px, -40px) scale(0.95); opacity: 0.85; }

  .deck[data-sys='clock'] .sys { transform: translate(-970px, 16px) scale(0.9); }
  .deck[data-sys='cat'] .sys { transform: translate(80px, 60px) scale(0.95); }
  .deck[data-sys='gone'] .sys,
  .deck[data-sys='join'] .sys { transform: scale(0.6); opacity: 0; }

  .deck[data-sun='clock'] .sun { transform: translate(-618px, -59px) scale(0.45); }
  .deck[data-sun='study'] .sun { transform: translate(280px, -95px) scale(0.4); }
  .deck[data-sun='cat'] .sun { transform: translate(301px, -75px) scale(0.6); }
  .deck[data-sun='gone'] .sun { transform: scale(0.1); opacity: 0; }

  .deck[data-hz='down'] .hz { transform: translateY(320px); opacity: 0; }

  /* The nebula image: tilted, and drifting slowly the whole time. */
  .nebula {
    position: absolute;
    inset: 0;
    width: 2000px;
    height: 900px;
    rotate: -34deg;
    will-change: transform, opacity;
    animation: nb-drift 40s ease-in-out infinite alternate;
  }
  .nebula img {
    display: block;
    width: 100%;
    height: 100%;
  }
  @keyframes nb-drift {
    to {
      rotate: -31deg;
      translate: -30px 20px;
    }
  }

  /* Orbits: hairlines with a red/blue fringe, drawn in on arrival. */
  .orb path {
    fill: none;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-linecap: round;
  }
  .o-w {
    stroke: rgba(255, 255, 255, 0.85);
  }
  .o-r {
    stroke: var(--ca-r);
    opacity: 0.45;
    translate: -2px 0;
  }
  .o-b {
    stroke: var(--ca-b);
    opacity: 0.55;
    translate: 2px 0;
  }
  .orb-1 {
    opacity: 0.4;
  }
  .orb-1 path {
    stroke-width: 1;
  }

  /* Four-point stars: long thin rays with a chromatic fringe, and a hot core. */
  .star {
    position: absolute;
    width: 0;
    height: 0;
    --len: 560px;
  }
  .star > span {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    border-radius: 2px;
  }
  .st-halo {
    width: 300px;
    height: 300px;
    border-radius: 50% !important;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.5), rgba(229, 143, 196, 0.25) 45%, transparent);
  }
  .st-h {
    width: var(--len);
    height: 3px;
    background: linear-gradient(90deg, transparent, #fff 50%, transparent);
    animation: twinkle 3.4s ease-in-out infinite alternate;
  }
  .st-v {
    width: 3px;
    height: calc(var(--len) * 0.72);
    background: linear-gradient(180deg, transparent, #fff 50%, transparent);
    animation: twinkle 4.1s ease-in-out infinite alternate-reverse;
  }
  .st-h.r,
  .st-h.b {
    height: 4px;
  }
  .st-h.r {
    background: linear-gradient(90deg, transparent, var(--ca-r) 50%, transparent);
    translate: calc(-50% - 5px) calc(-50% + 1px);
  }
  .st-h.b {
    background: linear-gradient(90deg, transparent, var(--ca-b) 50%, transparent);
    translate: calc(-50% + 5px) calc(-50% - 1px);
  }
  .st-v.r {
    background: linear-gradient(180deg, transparent, var(--ca-r) 50%, transparent);
    translate: calc(-50% - 3px) -50%;
  }
  .st-v.b {
    background: linear-gradient(180deg, transparent, var(--ca-b) 50%, transparent);
    translate: calc(-50% + 3px) -50%;
  }
  .st-core {
    width: 18px;
    height: 18px;
    border-radius: 50% !important;
    background: #fff;
    box-shadow:
      0 0 18px 6px #fff,
      0 0 60px 22px rgba(229, 143, 196, 0.55);
  }
  @keyframes twinkle {
    to {
      scale: 0.82;
      opacity: 0.8;
    }
  }
  .star.mini {
    --len: 90px;
  }
  .star.mini .st-core {
    width: 6px;
    height: 6px;
    box-shadow:
      0 0 8px 3px #fff,
      0 0 22px 8px rgba(156, 193, 234, 0.6);
  }
  .traveler {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    offset-rotate: 0deg;
    animation: travel 34s linear infinite;
  }
  @keyframes travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  /* Small sparkle crosses. */
  .spark {
    position: absolute;
    width: var(--s);
    height: var(--s);
    translate: -50% -50%;
    background:
      linear-gradient(90deg, transparent, #fff 50%, transparent) center / 100% 1.5px no-repeat,
      linear-gradient(180deg, transparent, #fff 50%, transparent) center / 1.5px 100% no-repeat,
      radial-gradient(circle, #fff 0 1.5px, transparent 3px);
    animation: spark 3.6s ease-in-out infinite;
    animation-delay: calc(var(--k) * -0.7s);
  }
  @keyframes spark {
    50% {
      opacity: 0.35;
      scale: 0.75;
    }
  }

  /* The planet's horizon along the bottom, and its lens flare. */
  .horizon {
    position: absolute;
    left: 0;
    top: 830px;
    width: 1920px;
    height: 250px;
    will-change: transform, opacity;
  }
  .flare {
    position: absolute;
    left: 960px;
    top: 972px;
    width: 0;
    height: 0;
  }
  .flare > span {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
  }
  .fl-h {
    width: 1500px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(190, 210, 255, 0.95) 50%, transparent);
  }
  .fl-h2 {
    width: 900px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(140, 170, 255, 0.6), transparent);
  }
  .fl-v {
    width: 2px;
    height: 150px;
    background: linear-gradient(180deg, transparent, #fff 50%, transparent);
  }
  .fl-core {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 16px 6px #fff,
      0 0 70px 24px rgba(140, 170, 255, 0.6);
  }

  /* Arrival on the title: horizon rises, nebula condenses, orbits draw, the star ignites. */
  .deck[data-slide='0'] .horizon {
    animation: o-rise 2.4s var(--ease) both;
  }
  .deck[data-slide='0'] .flare {
    animation: o-flare 1.6s 1s var(--ease) both;
  }
  .deck[data-slide='0'] .nebula {
    animation:
      o-nebula 3s 0.3s var(--ease) both,
      nb-drift 40s ease-in-out infinite alternate;
  }
  /* Orbits draw whenever they appear: slowly on the title, briskly elsewhere. */
  .deck:not([data-sys='gone'], [data-sys='join']) .orb path {
    animation: o-draw 2.2s 0.4s var(--ease) both;
  }
  .deck[data-slide='0'] .orb path {
    animation-duration: 2.6s;
    animation-delay: 1.1s;
  }
  .deck[data-slide='0'] .orb-1 path {
    animation-delay: 1.5s;
  }
  .deck[data-slide='0'] .sun .star {
    animation: o-star 1.4s 2.1s var(--ease) both;
  }
  .deck[data-slide='0'] .traveler {
    animation:
      o-fade 1s 3s both,
      travel 34s 3s linear infinite;
  }
  .s-orbit.on .spark {
    animation:
      o-fade 1.2s calc(1.6s + var(--k) * 0.18s) both,
      spark 3.6s calc(var(--k) * -0.7s) ease-in-out infinite;
  }
  @keyframes o-rise {
    from {
      translate: 0 140px;
      opacity: 0;
    }
  }
  @keyframes o-flare {
    from {
      scale: 0 1;
      opacity: 0;
    }
  }
  @keyframes o-nebula {
    from {
      opacity: 0;
      scale: 1.12;
    }
  }
  @keyframes o-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes o-star {
    0% {
      opacity: 0;
      scale: 0.1;
    }
    55% {
      opacity: 1;
      scale: 1.3;
    }
  }
  @keyframes o-fade {
    from {
      opacity: 0;
    }
  }

  /* ── 2 · What ──────────────────────────────────────────────── */
  .what-full {
    position: absolute;
    left: 154px;
    top: 232px;
    font-size: 18px;
    letter-spacing: 0.4em;
  }
  .what-time {
    position: absolute;
    left: 150px;
    top: 360px;
    width: 640px;
  }
  .what-cap {
    font-size: 18px;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .what-clock {
    font-size: 210px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-transform: none;
  }
  .what-note {
    margin-top: 36px;
    font-size: 38px;
    line-height: 1.25;
    color: var(--fg-dim);
    max-width: 560px;
  }
  .what-load {
    position: absolute;
    left: 900px;
    right: 150px;
    top: 330px;
  }
  .what-n {
    display: flex;
    align-items: baseline;
    gap: 22px;
    margin-bottom: 44px;
  }
  .what-n .display {
    font-size: 150px;
  }
  .what-n .italic {
    font-size: 48px;
    color: var(--fg-dim);
  }
  .pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 14px;
  }
  .pill {
    --c: var(--fg);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 23px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    color: color-mix(in srgb, var(--c) 70%, var(--fg));
    box-shadow: 0 0 34px -8px color-mix(in srgb, var(--c) 60%, transparent);
  }
  [data-s='c'] { --c: var(--cp); }
  [data-s='b'] { --c: var(--bb); }
  [data-s='p'] { --c: var(--ps); }
  [data-s='s'] { --c: var(--cars); }
  .legend {
    display: flex;
    gap: 36px;
    margin-top: 48px;
    font-size: 15px;
    color: var(--muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  /* ── 3 · Cost ──────────────────────────────────────────────── */
  .ledger {
    position: absolute;
    left: 150px;
    top: 290px;
    width: 1000px;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 22px;
    padding: 14px 0;
    font-size: 38px;
  }
  .r-label {
    white-space: nowrap;
  }
  .r-note {
    font-size: 15px;
    padding: 6px 14px;
    border-radius: 999px;
    align-self: center;
    white-space: nowrap;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
    background: color-mix(in srgb, var(--c) 10%, transparent);
  }
  [data-accent='rose'] { --c: var(--rose); }
  [data-accent='violet'] { --c: var(--violet); }
  [data-accent='gold'] { --c: var(--gold); }
  .r-dots {
    flex: 1;
    border-bottom: 2px dotted var(--faint);
    transform: translateY(-8px);
  }
  .r-amt {
    font-size: 40px;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }
  .row-total {
    margin-top: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-strong);
    align-items: center;
  }
  .row-total .r-label {
    font-size: 20px;
  }
  .row-total .r-dots {
    border: 0;
  }
  .row-total .r-amt {
    font-size: 96px;
    font-weight: 700;
    text-transform: none;
    font-family: var(--display);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .row-inf .r-amt {
    font-family: var(--serif);
    font-size: 96px;
    line-height: 0.6;
    color: var(--rose);
    text-shadow: 0 0 40px color-mix(in srgb, var(--rose) 60%, transparent);
  }
  .dim {
    color: var(--muted);
  }
  .study {
    position: absolute;
    left: 1290px;
    right: 150px;
    top: 360px;
  }
  .study-n {
    font-size: 140px;
    text-transform: none;
    font-variant-numeric: lining-nums;
    color: var(--gold);
  }
  .study-txt {
    margin-top: 30px;
    font-size: 36px;
    line-height: 1.25;
    color: var(--fg-dim);
  }
  .cite {
    margin-top: 28px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .punch {
    position: absolute;
    left: 150px;
    bottom: 96px;
    font-size: 56px;
    color: var(--fg);
  }
  .punch .mono {
    font-size: 40px;
    color: var(--rose);
    margin-left: 12px;
  }

  /* ── 4 · The turn ──────────────────────────────────────────── */
  .turn-q {
    position: absolute;
    left: 0;
    right: 0;
    top: 380px;
    text-align: center;
    font-size: 190px;
    font-weight: 400;
    line-height: 1;
    transform-origin: 50% 0;
    transition:
      transform 1.3s var(--ease),
      opacity 1.3s var(--ease),
      filter 1.3s var(--ease);
  }
  .turn-do {
    color: var(--rose);
    text-shadow: 0 0 60px color-mix(in srgb, var(--rose) 55%, transparent);
  }
  .deck[data-slide='3'][data-build='1'] .turn-q {
    transform: translate(-520px, -240px) scale(0.32);
    opacity: 0.55;
  }
  .turn-us {
    position: absolute;
    left: 150px;
    top: 330px;
  }
  .turn-word {
    display: flex;
    flex-direction: column;
    margin: 26px 0 30px;
  }
  .turn-word span:first-child {
    font-size: 150px;
  }
  .turn-word span:last-child {
    font-size: 260px;
  }
  .turn-at {
    font-size: 22px;
    color: var(--fg-dim);
    letter-spacing: 0.3em;
  }
  .turn-tag {
    margin-top: 30px;
    font-size: 46px;
    color: var(--fg-dim);
  }

  /* ── 5 · Team ──────────────────────────────────────────────── */
  .team-label {
    top: 150px;
  }
  .team-h {
    position: absolute;
    left: 150px;
    top: 200px;
    font-size: 110px;
    --ca-rest: 0.025em;
  }
  .team {
    position: absolute;
    left: 150px;
    right: 150px;
    top: 400px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 28px;
  }
  .frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    background: var(--bg-raise);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .frame :global(img.tall) {
    object-position: 50% 12%;
  }
  .p-name {
    margin-top: 22px;
    font-size: 34px;
    line-height: 1.1;
  }
  .p-role {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
  }

  /* ── 6 · Offer ─────────────────────────────────────────────── */
  .offers {
    position: absolute;
    left: 150px;
    right: 150px;
    top: 400px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
  }
  .offer {
    --c: var(--fg);
    padding-top: 30px;
    border-top: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }
  .o-free {
    font-size: 84px;
    line-height: 0.9;
    color: var(--c);
    text-shadow: 0 0 50px color-mix(in srgb, var(--c) 50%, transparent);
  }
  .o-title {
    margin: 14px 0 28px;
    font-size: 64px;
    /* the hairline 1200 cut breaks letter spacing at this size */
    --opsz: 144;
  }
  .o-body {
    font-size: 32px;
    line-height: 1.3;
    color: var(--fg-dim);
  }
  .o-body b {
    font-weight: 600;
    color: var(--c);
  }
  .o-sched {
    display: grid;
    gap: 10px;
    margin-bottom: 24px;
    font-size: 20px;
  }
  .o-sched div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 10px;
    border-bottom: 1px dotted var(--faint);
  }
  .o-sched dd {
    color: var(--c);
  }
  .o-where {
    margin-top: 24px;
    font-size: 20px;
    color: var(--c);
  }

  /* Intro names: letters that rise in at their step (the scholarship intro). */
  .mci-name { position: absolute; left: 360px; top: 150px; font-size: 150px; line-height: 1; }
  .mci-name span {
    display: inline-block;
    transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.9s var(--ease);
    transition-delay: calc(0.55s + var(--i) * 60ms);
  }
  .mci-name:not(.shown) span { opacity: 0; transform: translateY(50px) rotate(4deg); filter: blur(14px); transition-delay: 0s; }
  .mci-big { position: absolute; left: 150px; top: 560px; width: 1500px; font-size: 76px; line-height: 1.15; }
  .mci-free {
    background: var(--grad);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ── 11 · MCatalyst, in the app's own look (as on themcats.org/mcatalyst): its own ink
     background over every theme, Anybody for the name, the icon's arc for colour. The name
     opens out from narrow and thin, the diagram draws itself, then the line and the band. */
  /* font-variation-settings: normal, or the orbit look's deck-wide axes would pin Anybody's width. */
  .s-mcx { --ink: #0b0a14; --paper: #f4f0e6; --arc: linear-gradient(100deg, #9f93ff, #f09ac0 55%, #f6d39c); color: var(--paper); font-variation-settings: normal; }
  .mcx-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(55% 50% at 50% 62%, rgb(125 108 245 / 0.2), transparent 70%),
      radial-gradient(35% 40% at 88% 92%, rgb(224 122 168 / 0.14), transparent 70%),
      var(--ink);
  }
  .mcx-tag { position: absolute; left: 150px; top: 112px; font-family: var(--mono); font-size: 20px; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(244 240 230 / 0.68); }
  .mcx-name {
    position: absolute; left: 0; right: 0; top: 168px; margin: 0; text-align: center;
    font-family: 'Anybody Variable', 'Arial Black', sans-serif; font-weight: 900; font-stretch: 150%;
    font-size: 158px; line-height: 0.8; letter-spacing: -0.01em; text-transform: uppercase; white-space: nowrap;
    transition: font-stretch 1.6s var(--ease) 0.35s, font-weight 1.6s var(--ease) 0.35s, letter-spacing 1.6s var(--ease) 0.35s, opacity 0.8s var(--ease) 0.35s;
  }
  .slide:not(.on) .mcx-name { font-stretch: 50%; font-weight: 200; letter-spacing: 0.2em; opacity: 0; transition-delay: 0s; }
  .mcx-barrier { position: absolute; left: 260px; width: 1400px; top: 330px; }
  .mcx-barrier svg { display: block; width: 100%; height: auto; overflow: visible; }
  .mcx-high { fill: none; stroke: rgb(244 240 230 / 0.42); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 0.1 14; transition: opacity 1s var(--ease) 0.9s; }
  .mcx-low { fill: none; stroke: url(#mcx-arc); stroke-width: 11; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.7s var(--ease) 1.1s; }
  .mcx-dot { fill: var(--paper); }
  .mcx-glow { fill: rgb(244 240 230 / 0.16); }
  .mcx-pop { transform-box: fill-box; transform-origin: center; transition: transform 0.9s var(--ease) 2.4s; }
  .mcx-spark { fill: var(--paper); transform: scale(2.6); transform-box: fill-box; transform-origin: center; animation: mcx-twinkle 4s ease-in-out infinite; }
  @keyframes mcx-twinkle { 50% { transform: scale(2) rotate(45deg); } }
  .slide:not(.on) .mcx-high { opacity: 0; transition-delay: 0s; }
  .slide:not(.on) .mcx-low { stroke-dashoffset: 1; transition: none; }
  .slide:not(.on) .mcx-pop { transform: scale(0) rotate(-90deg); transition-delay: 0s; }
  .mcx-lab { position: absolute; font-family: var(--mono); font-size: 19px; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; color: rgb(244 240 230 / 0.68); }
  .mcx-lab i { margin-right: 0.35em; font-style: normal; color: rgb(244 240 230 / 0.42); }
  .mcx-learn { left: 0; top: 55%; }
  .mcx-apply { right: 0; top: 71%; }
  .mcx-check { left: 50%; top: 58%; translate: -50% 0; padding: 0.35em 0.9em; border-radius: 99px; background: var(--arc); color: var(--ink); font-weight: 500; }
  .mcx-check i { color: rgb(11 10 20 / 0.55); }
  .mcx-without { left: calc(50% + 34px); top: 2%; color: rgb(244 240 230 / 0.42); }
  .mcx-line { position: absolute; left: 150px; top: 732px; width: 1240px; margin: 0; font-family: 'Mona Sans Variable', system-ui, sans-serif; font-weight: 500; font-size: 50px; line-height: 1.22; }
  .mcx-line em { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: 1.12em; line-height: 1; }
  .mcx-ticker {
    position: absolute; left: -80px; right: -80px; top: 905px; overflow: hidden;
    padding: 16px 0; background: var(--arc); color: var(--ink);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.7);
    transform: rotate(-2deg);
    transition: transform 1.1s var(--ease) 2.2s, opacity 0.8s var(--ease) 2.2s;
  }
  .slide:not(.on) .mcx-ticker { transform: translateY(90px) rotate(-2deg); opacity: 0; transition-delay: 0s; }
  .mcx-run { display: flex; width: max-content; animation: mcx-run 34s linear infinite; }
  .mcx-set { display: flex; }
  .mcx-item {
    display: inline-flex; align-items: center; gap: 30px; padding-right: 30px;
    font-family: 'Anybody Variable', 'Arial Black', sans-serif; font-weight: 900; font-stretch: 125%;
    font-size: 34px; text-transform: uppercase; white-space: nowrap;
  }
  .mcx-item svg { width: 1em; height: 1em; fill: var(--ink); }
  @keyframes mcx-run { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    :global(html:not(.full-motion)) .mcx-dot { display: none; }
  }

  /* Shared by the intros: words that rise in letter by letter when the slide arrives. */
  .intro-word span { display: inline-block; transition: opacity 1s var(--ease), transform 1s var(--ease), filter 1s var(--ease); transition-delay: calc(0.9s + var(--i) * 70ms); }
  .slide:not(.on) .intro-word span { opacity: 0; transform: translateY(60px) rotate(5deg); filter: blur(16px); transition-delay: 0s; }
  .intro-in { transition: opacity 1.2s var(--ease), filter 1.2s var(--ease), transform 1.2s var(--ease); transition-delay: calc(0.9s + var(--i) * 70ms); }
  .slide:not(.on) .intro-in { opacity: 0; filter: blur(12px); transform: translateY(24px); transition-delay: 0s; }

  /* Classes intro: a seminar photo, full bleed, settling in from a slow zoom. */
  .ci-photo { position: absolute; inset: 0; overflow: hidden; }
  .ci-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); filter: none; opacity: 1; transition: transform 7s cubic-bezier(0.2, 0.6, 0.2, 1), filter 2s var(--ease), opacity 1.6s var(--ease); }
  .slide:not(.on) .ci-photo :global(img) { transform: scale(1.18); filter: blur(18px) brightness(0.4); opacity: 0; transition-duration: 0.4s; }
  .ci-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(8 8 10 / 0.92) 0%, rgb(8 8 10 / 0.65) 45%, rgb(8 8 10 / 0.15) 100%), linear-gradient(0deg, rgb(8 8 10 / 0.8), transparent 45%); }
  .ci-kick { position: absolute; left: 154px; top: 520px; font-size: 20px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--rose); }
  .ci-name { position: absolute; left: 140px; top: 580px; font-size: 190px; line-height: 1; white-space: nowrap; }
  .ci-tag { position: absolute; left: 154px; top: 800px; font-size: 44px; color: var(--fg-dim); }

  /* Scholarship intro: a seal draws itself, then tucks into the corner beside the name. */
  .si-seal { position: absolute; left: 700px; top: 230px; width: 520px; height: 520px; transition: transform 1.4s var(--ease); }
  .si-seal::before { content: ''; position: absolute; inset: -35%; background: radial-gradient(circle, color-mix(in srgb, var(--rose) 28%, transparent), transparent 65%); transition: opacity 1.6s var(--ease) 0.6s; }
  .si-seal svg { position: relative; width: 100%; height: 100%; overflow: visible; }
  .si-o { fill: none; stroke: var(--rose); stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 0; filter: drop-shadow(0 0 8px var(--rose)); transition: stroke-dashoffset 2s var(--ease) 0.3s; }
  .si-i { fill: none; stroke: var(--rule-strong); stroke-width: 1; transition: opacity 1s var(--ease) 1s; }
  .si-spin { transform-box: view-box; transform-origin: 50% 50%; animation: si-spin 40s linear infinite; transition: opacity 1.2s var(--ease) 1.2s; }
  .si-spin text { font-family: var(--mono, ui-monospace, monospace); font-size: 15.5px; letter-spacing: 0.32em; fill: var(--fg-dim); }
  @keyframes si-spin { to { transform: rotate(360deg); } }
  .si-amt { position: absolute; inset: 0; display: grid; place-items: center; font-size: 130px; text-shadow: 0 0 60px color-mix(in srgb, var(--rose) 55%, transparent); transition: opacity 1s var(--ease) 1.8s, transform 1.2s var(--ease) 1.8s, filter 1s var(--ease) 1.8s; }
  .slide:not(.on) .si-o { stroke-dashoffset: 1; transition-delay: 0s; }
  .slide:not(.on) .si-i, .slide:not(.on) .si-spin, .slide:not(.on) .si-seal::before { opacity: 0; transition-delay: 0s; }
  .slide:not(.on) .si-amt { opacity: 0; transform: scale(0.8); filter: blur(12px); transition-delay: 0s; }
  .s-si:has(.si-name.shown) .si-seal { transform: translate(-730px, -270px) scale(0.3); }
  .si-kick { position: absolute; left: 366px; top: 128px; font-size: 20px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--rose); }
  .si-name { top: 160px; }

  /* Cost recap: the ledger from slide 3, crossed off line by line. */
  .rc-old { position: relative; display: inline-block; transition: opacity 0.6s var(--ease) 0.3s; }
  .rc-old::after {
    content: ''; position: absolute; left: -6%; right: -6%; top: 52%; height: 3px;
    background: var(--rose); box-shadow: 0 0 12px var(--rose);
    transform: scaleX(0); transform-origin: left; transition: transform 0.7s var(--ease);
  }
  .rc-row:not(.rc-keep):has(.rc-new.shown) .rc-old::after, .rc-total:has(.rc-left.shown) .rc-old::after { transform: none; }
  .rc-row:not(.rc-keep):has(.rc-new.shown) .rc-old, .rc-total:has(.rc-left.shown) .rc-old { opacity: 0.4; }
  .rc-new, .rc-zero, .rc-left { transition: opacity 0.7s var(--ease), filter 0.7s var(--ease), transform 0.7s var(--ease); }
  .rc-zero, .rc-left { display: inline-block; margin-left: 22px; transition-delay: 0.45s; }
  .rc-zero { color: var(--violet); }
  .rc-if { display: block; margin-top: 6px; font-size: 0.72em; letter-spacing: 0.14em; color: var(--muted); }
  .rc-total .r-amt { white-space: nowrap; }  /* both totals on one line, running past the column if they must */
  .rc-new:not(.shown), .rc-zero:not(.shown), .rc-left:not(.shown) { opacity: 0; filter: blur(8px); transform: translateY(10px); transition-delay: 0s; }

  /* ── 10 · Scholarship ─────────────────────────────────────── */
  .sch-amt {
    position: absolute;
    left: 150px;
    top: 370px;
    width: 860px;
  }
  .sch-n {
    font-size: 250px;
    line-height: 0.95;
    text-shadow: 0 0 90px color-mix(in srgb, var(--rose) 45%, transparent);
  }
  .sch-note {
    margin-top: 18px;
    max-width: 760px;
    font-size: 36px;
    line-height: 1.3;
    color: var(--fg-dim);
  }
  .sch-split {
    display: flex;
    gap: 56px;
    margin-top: 44px;
    font-size: 20px;
    color: var(--muted);
  }
  .sch-split b {
    margin-right: 12px;
    font-size: 46px;
    font-weight: 400;
    color: var(--c);
  }
  .sch-time {
    position: absolute;
    left: 1180px;
    right: 150px;
    top: 380px;
    padding-left: 44px;
    list-style: none;
  }
  .sch-time::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 40px;
    width: 1px;
    background: var(--rule-strong);
    transform-origin: top;
    transition: transform 1.4s var(--ease);
  }
  .sch-time:not(.shown)::before {
    transform: scaleY(0);
  }
  .sch-time li {
    position: relative;
    margin-bottom: 34px;
  }
  .sch-time li::before {
    content: '';
    position: absolute;
    left: -50px;
    top: 7px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg, #0d0d0c);
    border: 1px solid var(--fg-dim);
  }
  .sch-time li > span {
    display: block;
    font-size: 17px;
    letter-spacing: 0.15em;
    color: var(--muted);
  }
  .sch-time b {
    font-size: 32px;
    font-weight: 400;
  }
  .sch-time .key b {
    color: var(--rose);
  }
  .sch-time .key::before {
    background: var(--rose);
    border-color: var(--rose);
    box-shadow: 0 0 16px var(--rose);
  }
  .sch-apply {
    position: absolute;
    left: 1224px;
    top: 900px;
    font-size: 20px;
    color: var(--rose);
  }

  /* ── 11 · Classes ─────────────────────────────────────────── */
  .cls-sched {
    position: absolute;
    left: 150px;
    top: 390px;
    width: 600px;
    display: grid;
    gap: 26px;
  }
  .cls-sched div {
