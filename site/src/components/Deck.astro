    from { opacity: 0; scale: 1.05; }
  }
  @keyframes o-bloom {
    from { opacity: 0; scale: 0.15; }
  }
  @keyframes o-precess {
    from { rotate: -1.1deg; }
    to { rotate: 1.4deg; }
  }
  @keyframes o-twinkle {
    0% { scale: 0.97; rotate: -0.6deg; opacity: 0.94; }
    45% { scale: 1.03; rotate: 0.4deg; opacity: 1; }
    100% { scale: 0.95; rotate: 1.1deg; opacity: 0.9; }
  }
  @keyframes o-neb-drift {
