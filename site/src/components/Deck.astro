  }

  /* ── Chrome ────────────────────────────────────────────────── */
  .chrome {
    position: absolute;
    left: 150px;
    right: 150px;
    bottom: 42px;
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--faint);
    transition: opacity 0.6s;
  }
  .deck[data-slide='0'] .chrome {
    opacity: 0;
  }
  .count {
    font-variant-numeric: tabular-nums;
  }
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
  }
  .progress span {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--nebula);
    opacity: 0.7;
    transition: width 0.8s var(--ease);
  }
  .hint {
    position: fixed;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 5;
  }
  .hint kbd {
    margin-left: 8px;
  }
  .deck.show-hint .hint {
    opacity: 1;
  }
  .blank {
    position: fixed;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s;
    z-index: 200;
  }
  .deck.blanked .blank {
    opacity: 1;
  }

  .motion-ask {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgba(13, 13, 12, 0.72);
    backdrop-filter: blur(14px);
  }
  .motion-ask[hidden] {
    display: none;
  }
  .ask-card {
    max-width: 34rem;
    padding: 2.5rem;
    border: 1px solid var(--rule-strong);
    background: var(--bg-raise);
  }
  .ask-q {
    margin: 0.8rem 0 1rem;
    font-size: 2rem;
    line-height: 1.15;
    font-weight: 400;
  }
  .ask-q em {
    color: var(--neb-rose);
  }
  .ask-body {
    color: var(--fg-dim);
    font-size: 1.1rem;
  }
  .ask-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  /* Space: the wildcat gets the same red/blue lens fringe as the orbits,
     from offset copies rather than a filter (filters redraw every frame while it draws). */
  .deck:not([data-theme='classic']) .cat {
    --draw: 3.4s;
  }
  .deck:not([data-theme='classic']) .cat :global(svg) {
    filter: none;
  }
  .cat :global(.cat-r),
  .cat :global(.cat-b) {
    position: absolute;
    left: 0;
    top: 0;
  }
  .cat :global(.cat-r) {
    color: var(--ca-r);
    translate: -3px 0;
    opacity: 0.55;
  }
  .cat :global(.cat-b) {
    color: var(--ca-b);
    translate: 3px 0;
    opacity: 0.6;
  }

  /* Space: small touches on the slide content. */
  .deck[data-theme='space'] [data-n]::before {
    content: attr(data-n) '  ·  ';
    white-space: pre;
    color: var(--fg-dim);
  }
  .deck:not([data-theme='classic']) .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: color-mix(in srgb, var(--c) 7%, rgba(8, 8, 14, 0.55));
  }
  .deck:not([data-theme='classic']) .pill::before {
    content: '';
    width: 13px;
    height: 13px;
    flex: none;
    background:
      linear-gradient(90deg, transparent, var(--c) 50%, transparent) center / 100% 1.5px no-repeat,
      linear-gradient(180deg, transparent, var(--c) 50%, transparent) center / 1.5px 100% no-repeat;
  }
  .deck[data-theme='space'] .frame {
    border-color: color-mix(in srgb, var(--violet) 45%, transparent);
    box-shadow: 0 0 50px -14px color-mix(in srgb, var(--violet) 70%, transparent);
  }
  .deck[data-theme='space'] .offer {
    border-top: 0;
    padding-top: 0;
  }
  .deck[data-theme='space'] .offer::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 30px;
    background: linear-gradient(90deg, var(--c), transparent 85%);
    box-shadow: 0 0 14px 1px color-mix(in srgb, var(--c) 55%, transparent);
  }

  /* Wildcat line-art draws itself in (dash values set by the script). */
  .cat.drawing :global(path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw var(--draw, 2.6s) var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 1ms + 400ms);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* ═════════════════════════════════════════════════════════════
     Orbit (/presentOrbit): the multi-orbit back print.
     The art is baked (scripts/bake-orbit.mjs) and only moved and faded
     here. Nothing in this look runs a live filter: the site's .ca blur and
     the blur-in builds are switched off, and the colour split comes from
     text-shadow, so it stays smooth in Firefox.
     ═════════════════════════════════════════════════════════════ */
  .deck[data-theme='orbit'] {
    --bg: #0a0c0e;
    --bg-raise: #111318;
    --fg: #efeae2;
    --fg-dim: #c9c4bd;
    --muted: #918f96;
    --faint: #5d5f68;
    --rule-strong: rgba(239, 234, 226, 0.22);
    --lav: #c9b6ee;
    --blush: #f1d9ee;
    --ca-rest: 0.012em;
