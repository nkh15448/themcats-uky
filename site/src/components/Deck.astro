  }

  /* ── 12 · Join ──────────────────────────────────────────────── */
  .join-h {
    position: absolute;
    left: 150px;
    top: 220px;
    font-size: 200px;
  }
  .join-site {
    position: absolute;
    left: 150px;
    top: 480px;
    font-size: 104px;
    text-transform: none;
    --ca-rest: 0.02em;
  }
  .join-site .italic {
    font-size: 0.9em;
    text-transform: none;
    color: var(--rose);
    text-shadow: none;
  }
  .join-sub {
    position: absolute;
    left: 150px;
    top: 640px;
    width: 760px;
    font-size: 38px;
    line-height: 1.25;
    color: var(--fg-dim);
  }
  .qrs {
    position: absolute;
    right: 150px;
    top: 400px;
    display: flex;
    gap: 50px;
  }
  .qr {
    width: 340px;
  }
  .qr-code {
    padding: 14px;
    background: #eeebe4;
    box-shadow: 0 0 80px -10px color-mix(in srgb, var(--violet) 55%, transparent);
  }
  .qr-code :global(svg) {
    width: 100%;
    height: auto;
  }
  .qr figcaption {
    margin-top: 22px;
    font-size: 34px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .qr figcaption .mono {
    font-size: 16px;
    color: var(--muted);
  }
  .qr small {
    flex-basis: 100%;
    font-size: 24px;
